{
  "luci-app-forkop": {
    "description": "Grant UCI and RPC access to LuCI app LoKi",
    "read": {
      "ubus": {
        "forkop": [
          "rpc_read",
          "rpc_read_prepare",
          "rpc_read_result",
          "state",
          "state_wait",
          "config",
          "system_info",
          "logs",
          "log_text",
          "usage",
          "refresh"
        ],
        "forkop.installer": [
          "read"
        ],
        "luci-rpc": [
          "getDHCPLeases",
          "getHostHints"
        ],
        "network.interface": [
          "dump"
        ]
      },
      "uci": [
        "dhcp"
      ]
    },
    "write": {
      "cgi-io": [
        "upload"
      ],
      "file": {
        "/tmp/forkop-import.conf": [
          "write"
        ]
      },
      "ubus": {
        "file": [
          "remove"
        ],
        "forkop": [
          "rpc_write",
          "rpc_write_prepare",
          "rpc_write_result",
          "config_private",
          "import_config"
        ],
        "forkop.installer": [
          "input",
          "stop"
        ]
      },
      "uci": {
        "forkop": [
          "read",
          "write"
        ]
      }
    }
  }
}
