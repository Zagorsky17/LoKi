{
  "printWidth": 100,
  "singleQuote": true,
  "endOfLine": "auto",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^~/(.*)$",
    "",
    "^[.][.]/(.*)$",
    "",
    "^[.]/(.*)$"
  ],
  "importOrderTypeScriptVersion": "5.0.0"
}
