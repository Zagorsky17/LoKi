* text=auto eol=lf

# Unified patches carry leading context spaces; validate reconstructed additions in core/prepare.sh.
core/patches/*.patch -whitespace

# Vite keeps whitespace-only lines inside CSS template strings in generated JavaScript.
luci-app-loki/root/usr/share/loki/yacd/assets/*.js -whitespace

# Validate bundled license bytes by hash; preserve original line endings and whitespace.
yacd-loki/licenses/THIRD_PARTY_NOTICES.txt -text -whitespace
