#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

# Runs whether or not Loki does: a stopped service is when the page most needs an answer.
START=98
USE_PROCD=1

LOKI_LIB="/usr/lib/loki"
LOKI_STATE_SERVICE_UC="$LOKI_LIB/service/state_service.uc"
LOKI_LUCI_VIEW="/www/luci-static/resources/view/loki/main.js"

# LOKI_LIB is not exported, so state_service.uc resolves the bytecode cache itself.
resolved_library() {
    ucode -L "$LOKI_LIB" -e '
        let bytecode = null;
        try {
            bytecode = loadfile("'"$LOKI_LIB"'/core/bytecode.uc")();
        }
        catch (e) {
        }
        print(bytecode == null ? "'"$LOKI_LIB"'" : bytecode.refresh(), "\n");
    ' 2>/dev/null || printf '%s\n' "$LOKI_LIB"
}

# No instance without the LuCI app; its uci-defaults run `loki luci_postinst`, which
# starts the service once the app is installed.
luci_app_installed() {
    [ -r "$LOKI_LUCI_VIEW" ]
}

start_service() {
    [ -r "$LOKI_STATE_SERVICE_UC" ] || return 1
    luci_app_installed || return 0

    local library
    library="$(resolved_library)"
    [ -n "$library" ] || library="$LOKI_LIB"

    procd_open_instance
    procd_set_param command ucode -L "$library" "$library/service/state_service.uc" run
    procd_set_param env LOKI_LIB="$library"
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
