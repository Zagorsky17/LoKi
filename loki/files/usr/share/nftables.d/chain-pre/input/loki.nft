# fw4 includes this file before the first rule of its own input chain.
#
# Loki marks proxied traffic in prerouting and hands it to the local sing-box
# TPROXY inbound. TPROXY does not rewrite the packet, so it still reaches the
# input hook on the interface it arrived on, and a zone whose input policy is
# not ACCEPT rejects it before sing-box ever sees it. Only Loki's own
# prerouting rules set this mark, and only for its configured source
# interfaces, so accepting it here stays scoped to traffic Loki owns.
meta mark & 0x04000000 == 0x04000000 counter accept comment "loki: TPROXY traffic"

# Client DNS from the same interfaces is redirected to the local resolver
# inbound and reaches input as a DNAT-ed packet on the Loki DNS port. Nothing
# else redirects to that port, and a query sent straight to it is not DNAT-ed.
ct status dnat meta l4proto { tcp, udp } th dport 1603 counter accept comment "loki: redirected DNS"
