diff --git a/cmd/sing-box/cmd_release_fetch.go b/cmd/sing-box/cmd_release_fetch.go
new file mode 100644
--- /dev/null
+++ b/cmd/sing-box/cmd_release_fetch.go
@@ -0,0 +1,117 @@
+// Modified for LoKi on 2026-11-07: download release inputs without loading routing configuration.
+package main
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/spf13/cobra"
+)
+
+const releaseByteLimit = 512 << 20
+
+var releaseAPIPath = regexp.MustCompile(`^/repos/Zagorsky17/LoKi/releases/(latest|[1-9][0-9]{0,19}|tags/[A-Za-z0-9][A-Za-z0-9_.~-]{0,95}|assets/[1-9][0-9]{0,19})$`)
+
+func init() {
+	var maximum int64
+	command := &cobra.Command{
+		Use:   "release-fetch URL",
+		Short: "Download a bounded public LoKi release input over HTTPS",
+		Args:  cobra.ExactArgs(1),
+		RunE: func(command *cobra.Command, args []string) error {
+			return fetchRelease(command.Context(), os.Stdout, args[0], maximum, releaseClient())
+		},
+	}
+	command.Flags().Int64Var(&maximum, "max-bytes", 0, "Maximum response bytes (required)")
+	mainCommand.AddCommand(command)
+}
+
+func releaseTarget(target *url.URL, initial bool) bool {
+	if target == nil || target.Scheme != "https" || target.Opaque != "" || target.User != nil ||
+		target.Fragment != "" || target.Port() != "" || len(target.String()) > 8192 {
+		return false
+	}
+	if initial {
+		return target.Host == "api.github.com" && target.RawQuery == "" && !target.ForceQuery &&
+			target.RawPath == "" && releaseAPIPath.MatchString(target.Path)
+	}
+	switch target.Host {
+	case "api.github.com", "github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com":
+		return true
+	default:
+		return false
+	}
+}
+
+func releaseClient() *http.Client {
+	return &http.Client{
+		Timeout: 120 * time.Second,
+		Transport: &http.Transport{
+			DialContext:            (&net.Dialer{Timeout: 10 * time.Second}).DialContext,
+			ForceAttemptHTTP2:      true,
+			DisableKeepAlives:      true,
+			DisableCompression:     true,
+			TLSHandshakeTimeout:    10 * time.Second,
+			ResponseHeaderTimeout:  15 * time.Second,
+			MaxResponseHeaderBytes: 64 << 10,
+		},
+		CheckRedirect: func(request *http.Request, previous []*http.Request) error {
+			if len(previous) >= 4 || !releaseTarget(request.URL, false) {
+				return errors.New("release-redirect-refused")
+			}
+			return nil
+		},
+	}
+}
+
+// Partial stdout is never admission evidence; the caller owns its staging file and checks status.
+func fetchRelease(ctx context.Context, output io.Writer, source string, maximum int64, client *http.Client) error {
+	defer client.CloseIdleConnections()
+	if len(source) > 8192 {
+		return errors.New("release-source-invalid")
+	}
+	target, err := url.Parse(source)
+	if err != nil || !releaseTarget(target, true) {
+		return errors.New("release-source-invalid")
+	}
+	if maximum <= 0 || maximum > releaseByteLimit {
+		return errors.New("release-limit-invalid")
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, source, nil)
+	if err != nil {
+		return errors.New("release-request-failed")
+	}
+	request.Header.Set("User-Agent", "LoKi")
+	request.Header.Set("Accept", "application/vnd.github+json")
+	if strings.Contains(target.Path, "/releases/assets/") {
+		request.Header.Set("Accept", "application/octet-stream")
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		return errors.New("release-request-failed")
+	}
+	if response.StatusCode != http.StatusOK || response.ContentLength > maximum ||
+		(response.Header.Get("Content-Encoding") != "" && response.Header.Get("Content-Encoding") != "identity") {
+		response.Body.Close()
+		return errors.New("release-response-refused")
+	}
+	count, copyError := io.CopyBuffer(output, io.LimitReader(response.Body, maximum), make([]byte, 32<<10))
+	var extra [1]byte
+	extraCount, endError := 0, error(nil)
+	if copyError == nil {
+		extraCount, endError = response.Body.Read(extra[:])
+	}
+	closeError := response.Body.Close()
+	if copyError != nil || closeError != nil || count == 0 || extraCount != 0 || endError != io.EOF {
+		return errors.New("release-body-incomplete")
+	}
+	return nil
+}
diff --git a/cmd/sing-box/cmd_release_fetch_test.go b/cmd/sing-box/cmd_release_fetch_test.go
new file mode 100644
