diff --git a/cmd/sing-box/cmd_check_memory_linux.go b/cmd/sing-box/cmd_check_memory_linux.go
new file mode 100644
--- /dev/null
+++ b/cmd/sing-box/cmd_check_memory_linux.go
@@ -0,0 +1,8 @@
+// Modified for LoKi on 2026-11-07: protect configuration reads even with a piped core handler.
+package main
+
+import "golang.org/x/sys/unix"
+
+func protectCheckMemory() error {
+	return unix.Prctl(unix.PR_SET_DUMPABLE, 0, 0, 0, 0)
+}
