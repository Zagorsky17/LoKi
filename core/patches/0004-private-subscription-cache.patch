@@ -0,0 +1,83 @@
+package outbound
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+func TestSwapBatchCommitRejectsBeforePersistence(t *testing.T) {
+	for _, kind := range []string{"stale", "external-dependent", "duplicate", "missing-dependency", "conflict"} {
+		t.Run(kind, func(t *testing.T) {
+			old := &testOutbound{NewAdapter("test", "node", nil, nil)}
+			next := &testOutbound{NewAdapter("test", "node", nil, nil)}
+			manager := &Manager{outbounds: []adapter.Outbound{old}, outboundByTag: map[string]adapter.Outbound{"node": old}, dependByTag: make(map[string][]string), defaultOutbound: old}
+			expected := map[string]adapter.Outbound{"node": old}
+			candidates := []adapter.Outbound{next}
+			switch kind {
+			case "stale":
+				expected["node"] = next
+			case "external-dependent":
+				manager.dependByTag["node"] = []string{"external"}
+			case "duplicate":
+				candidates = append(candidates, next)
+			case "missing-dependency":
+				candidates[0] = &testOutbound{NewAdapter("test", "node", nil, []string{"missing"})}
+			case "conflict":
+				delete(expected, "node")
+			}
+			calls := 0
+			if _, err := manager.SwapBatchWithCommit(expected, candidates, func() error { calls++; return nil }); err == nil {
+				t.Fatal("invalid replacement accepted")
+			}
+			if calls != 0 {
+				t.Fatal("rejected runtime update wrote the cache")
+			}
+			if current, _ := manager.Outbound("node"); current != old || manager.Default() != old {
+				t.Fatal("rejection changed the old runtime")
+			}
+		})
+	}
+}
+func TestSwapBatchFailedCommitKeepsMapsAndBlocksReadersUntilOutcome(t *testing.T) {
+	old := &testOutbound{NewAdapter("test", "node", nil, nil)}
+	next := &testOutbound{NewAdapter("test", "node", nil, nil)}
+	manager := &Manager{outbounds: []adapter.Outbound{old}, outboundByTag: map[string]adapter.Outbound{"node": old}, dependByTag: make(map[string][]string), defaultOutbound: old}
+	entered, release := make(chan struct{}), make(chan struct{})
+	finished := make(chan error, 1)
+	go func() {
+		_, err := manager.SwapBatchWithCommit(map[string]adapter.Outbound{"node": old}, []adapter.Outbound{next}, func() error {
+			close(entered)
+			<-release
+			return errors.New("synthetic persistence failure")
+		})
+		finished <- err
+	}()
+	<-entered
+	observed := make(chan adapter.Outbound, 1)
+	go func() { current, _ := manager.Outbound("node"); observed <- current }()
+	select {
+	case <-observed:
+		t.Fatal("reader passed an unresolved publication point")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(release)
+	if err := <-finished; err == nil {
+		t.Fatal("failed commit reported success")
+	}
+	if current := <-observed; current != old {
+		t.Fatal("failed commit exposed a candidate")
+	}
+	if manager.Default() != old || len(manager.Outbounds()) != 1 {
+		t.Fatal("failed commit changed runtime indexes")
+	}
+	calls := 0
+	if _, err := manager.SwapBatchWithCommit(map[string]adapter.Outbound{"node": old}, []adapter.Outbound{next}, func() error { calls++; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if current, _ := manager.Outbound("node"); current != next || calls != 1 {
+		t.Fatal("successful commit did not publish exactly once")
+	}
+}
