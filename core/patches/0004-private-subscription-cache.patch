+package cachefile
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/sagernet/bbolt"
+	"golang.org/x/sys/unix"
+)
+
+// Errors crossing the cache boundary must not disclose custom paths or DB contents.
+var errPrivateStorage = errors.New("private LoKi cache storage is unsafe or unavailable")
+var bucketStore = []byte("loki_cache_store")
+
+const storageSchema = "1"
+
+type cacheDirectory struct{ file *os.File }
+type cacheStorage struct {
+	*cacheDirectory
+	name     string
+	id       string
+	database unix.Stat_t
+}
+
+func validCachePath(path string) bool {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return false
+	}
+	parts := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	if len(parts) < 2 {
+		return false
+	}
+	for _, part := range parts {
+		if !validLeaf(part) {
+			return false
+		}
+	}
+	return true
+}
+
+func validLeaf(name string) bool {
+	if name == "" || name == "." || name == ".." || strings.ContainsRune(name, '/') {
+		return false
+	}
+	for _, char := range []byte(name) {
+		if char < 32 || char == 127 {
+			return false
+		}
+	}
+	return true
+}
+
+func privateDirectory(path string, create bool) (*cacheDirectory, error) {
+	for _, part := range strings.Split(strings.TrimPrefix(path, "/"), "/") {
+		if !validLeaf(part) {
+			return nil, errPrivateStorage
+		}
+	}
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, errPrivateStorage
+	}
+	parts := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	fd, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, errPrivateStorage
+	}
+	var rootInfo unix.Stat_t
+	if unix.Fstat(fd, &rootInfo) != nil || rootInfo.Uid != 0 || rootInfo.Mode&0o022 != 0 {
+		unix.Close(fd)
+		return nil, errPrivateStorage
+	}
+	for index, part := range parts {
+		if !validLeaf(part) {
+			unix.Close(fd)
+			return nil, errPrivateStorage
+		}
+		child, openErr := unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		if errors.Is(openErr, unix.ENOENT) && create {
+			if mkdirErr := unix.Mkdirat(fd, part, 0o700); mkdirErr != nil && !errors.Is(mkdirErr, unix.EEXIST) {
+				unix.Close(fd)
+				return nil, errPrivateStorage
+			}
+			child, openErr = unix.Openat(fd, part, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+		}
+		unix.Close(fd)
+		if openErr != nil {
+			return nil, errPrivateStorage
+		}
+		fd = child
+		var info unix.Stat_t
+		if unix.Fstat(fd, &info) != nil {
+			unix.Close(fd)
+			return nil, errPrivateStorage
+		}
+		own := info.Uid == uint32(os.Geteuid())
+		trustedAncestor := info.Uid == 0 || own
+		sticky := info.Uid == 0 && info.Mode&unix.S_ISVTX != 0
+		if !trustedAncestor || (info.Mode&0o022 != 0 && !sticky) || (index == len(parts)-1 && (!own || info.Mode&0o777 != 0o700)) {
+			unix.Close(fd)
+			return nil, errPrivateStorage
+		}
+	}
+	return &cacheDirectory{os.NewFile(uintptr(fd), "loki-cache-directory")}, nil
+}
+
+func (d *cacheDirectory) close() error { return d.file.Close() }
+func (d *cacheDirectory) sync() error {
+	if d.file.Sync() != nil {
+		return errPrivateStorage
+	}
+	return nil
+}
+func (d *cacheDirectory) child(name string, create bool) (*cacheDirectory, error) {
+	if !validLeaf(name) {
+		return nil, errPrivateStorage
+	}
+	fd, err := unix.Openat(int(d.file.Fd()), name, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if errors.Is(err, unix.ENOENT) && create {
+		if e := unix.Mkdirat(int(d.file.Fd()), name, 0o700); e != nil && !errors.Is(e, unix.EEXIST) {
+			return nil, errPrivateStorage
+		}
+		fd, err = unix.Openat(int(d.file.Fd()), name, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	}
+	if err != nil {
+		return nil, errPrivateStorage
+	}
+	var info unix.Stat_t
+	if unix.Fstat(fd, &info) != nil || info.Uid != uint32(os.Geteuid()) || info.Mode&0o777 != 0o700 {
+		unix.Close(fd)
+		return nil, errPrivateStorage
+	}
+	return &cacheDirectory{os.NewFile(uintptr(fd), "loki-cache-directory")}, nil
+}
+func fileIdentity(file *os.File) (unix.Stat_t, error) {
+	var info unix.Stat_t
+	err := unix.Fstat(int(file.Fd()), &info)
+	if err != nil || info.Mode&unix.S_IFMT != unix.S_IFREG || info.Uid != uint32(os.Geteuid()) || info.Nlink != 1 {
+		return info, errPrivateStorage
+	}
+	return info, nil
+}
+func (d *cacheDirectory) open(name string, flags int, tighten bool) (*os.File, error) {
+	if !validLeaf(name) || flags&unix.O_TRUNC != 0 || (flags&unix.O_CREAT != 0 && flags&unix.O_EXCL == 0) {
+		return nil, errPrivateStorage
+	}
+	fd, err := unix.Openat(int(d.file.Fd()), name, flags|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0o600)
+	if err != nil {
+		return nil, errPrivateStorage
+	}
+	file := os.NewFile(uintptr(fd), "loki-cache-file")
+	info, err := fileIdentity(file)
+	if err == nil && tighten && info.Mode&0o777 != 0o600 {
+		err = unix.Fchmod(fd, 0o600)
+	}
+	if err != nil {
+		file.Close()
+		return nil, errPrivateStorage
+	}
+	return file, nil
+}
+func randomCacheName(prefix string) (string, error) {
+	var random [16]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return "", errPrivateStorage
+	}
+	return prefix + hex.EncodeToString(random[:]), nil
+}
+func (d *cacheDirectory) randomFile(prefix string) (*os.File, string, error) {
+	name, err := randomCacheName(prefix)
+	if err != nil {
+		return nil, "", err
+	}
+	file, err := d.open(name, unix.O_RDWR|unix.O_CREAT|unix.O_EXCL, true)
+	return file, name, err
+}
+
+func (d *cacheDirectory) remove(name string) error {
+	if !validLeaf(name) {
+		return errPrivateStorage
+	}
+	var entry unix.Stat_t
+	if err := unix.Fstatat(int(d.file.Fd()), name, &entry, unix.AT_SYMLINK_NOFOLLOW); errors.Is(err, unix.ENOENT) {
+		return nil
+	}
+	file, err := d.open(name, unix.O_RDONLY, false)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	// The directory is private. Still refuse replacement or a new hardlink before unlink.
+	info, err := fileIdentity(file)
+	var current unix.Stat_t
+	if err != nil || unix.Fstatat(int(d.file.Fd()), name, &current, unix.AT_SYMLINK_NOFOLLOW) != nil || info.Dev != current.Dev || info.Ino != current.Ino || current.Nlink != 1 {
+		return errPrivateStorage
+	}
+	if unix.Unlinkat(int(d.file.Fd()), name, 0) != nil {
+		return errPrivateStorage
+	}
+	return nil
+}
+func (s *cacheStorage) openDB(name string, readonly bool, expected *unix.Stat_t, tighten bool) (*bbolt.DB, error) {
+	flags := unix.O_RDWR
+	if readonly {
+		flags = unix.O_RDONLY
+	}
+	var opened *os.File
+	options := &bbolt.Options{Timeout: time.Second, ReadOnly: readonly, OpenFile: func(_ string, _ int, _ os.FileMode) (*os.File, error) {
+		file, err := s.open(name, flags, false)
+		if err != nil {
+			return nil, err
+		}
+		info, err := fileIdentity(file)
+		if err != nil || (expected != nil && (info.Dev != expected.Dev || info.Ino != expected.Ino)) || (readonly && info.Size == 0) {
+			file.Close()
+			return nil, errPrivateStorage
+		}
+		if tighten && unix.Fchmod(int(file.Fd()), 0o600) != nil {
+			file.Close()
+			return nil, errPrivateStorage
+		}
+		opened = file
+		return file, nil
+	}}
+	// bbolt receives a non-sensitive logical name, while OpenFile uses our anchored FD.
+	db, err := bbolt.Open("loki-cache", 0o600, options)
+	if err != nil {
+		return nil, errPrivateStorage
+	}
+	// A writer waiting on flock must not accept an inode replaced by another owner instance.
+	current, verifyErr := fileIdentity(opened)
+	var named unix.Stat_t
+	if verifyErr != nil || unix.Fstatat(int(s.file.Fd()), name, &named, unix.AT_SYMLINK_NOFOLLOW) != nil || current.Dev != named.Dev || current.Ino != named.Ino || named.Nlink != 1 {
+		db.Close()
+		return nil, errPrivateStorage
+	}
+	return db, nil
+}
+func readStoreID(db *bbolt.DB) (id string, err error) {
+	defer func() {
+		if recover() != nil {
+			id = ""
+			err = errPrivateStorage
+		}
+	}()
+	err = db.View(func(tx *bbolt.Tx) error {
+		bucket := tx.Bucket(bucketStore)
+		if bucket == nil || string(bucket.Get([]byte("schema"))) != storageSchema {
+			return errPrivateStorage
+		}
+		id = string(bucket.Get([]byte("id")))
+		decoded, e := hex.DecodeString(id)
+		if e != nil || len(decoded) != 16 || hex.EncodeToString(decoded) != id {
+			return errPrivateStorage
+		}
+		return nil
+	})
+	if err != nil {
+		return "", errPrivateStorage
+	}
+	return id, nil
+}
+func (s *cacheStorage) createDB(replace bool) (*bbolt.DB, error) {
+	file, name, err := s.randomFile(".loki-db-")
+	if err != nil {
+		return nil, err
+	}
+	file.Close()
+	defer func() { _ = s.remove(name) }()
+	db, err := s.openDB(name, false, nil, true)
+	if err != nil {
+		return nil, err
+	}
+	err = db.Update(func(tx *bbolt.Tx) error {
+		bucket, e := tx.CreateBucket(bucketStore)
+		if e != nil {
+			return e
+		}
+		if e = bucket.Put([]byte("schema"), []byte(storageSchema)); e != nil {
+			return e
+		}
+		return bucket.Put([]byte("id"), []byte(s.id))
+	})
+	if err == nil {
+		err = db.Sync()
+	}
+	closeErr := db.Close()
+	if err != nil || closeErr != nil {
+		return nil, errPrivateStorage
+	}
+	flags := uint(unix.RENAME_NOREPLACE)
+	if replace {
+		old, e := s.open(s.name, unix.O_RDONLY, false)
+		if e != nil {
+			return nil, e
+		}
+		info, e := fileIdentity(old)
+		old.Close()
+		if e != nil || info.Dev != s.database.Dev || info.Ino != s.database.Ino {
+			return nil, errPrivateStorage
+		}
+		flags = 0
+	}
+	if unix.Renameat2(int(s.file.Fd()), name, int(s.file.Fd()), s.name, flags) != nil {
+		return nil, errPrivateStorage
+	}
+	if s.sync() != nil {
+		return nil, errPrivateStorage
+	}
+	db, err = s.openDB(s.name, false, nil, true)
+	if err != nil {
+		return nil, err
+	}
+	opened, err := s.open(s.name, unix.O_RDONLY, false)
+	if err == nil {
+		s.database, err = fileIdentity(opened)
+		opened.Close()
+	}
+	if err != nil {
+		db.Close()
+		return nil, err
+	}
+	return db, nil
+}
+func openCacheStorage(path string) (*cacheStorage, *bbolt.DB, error) {
+	return openCacheStorageWithLock(path, func(fd int) error { return unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB) })
+}
+func openCacheStorageWithLock(path string, lock func(int) error) (*cacheStorage, *bbolt.DB, error) {
+	if !validCachePath(path) {
+		return nil, nil, errPrivateStorage
+	}
+	directory, err := privateDirectory(filepath.Dir(path), true)
+	if err != nil {
+		return nil, nil, err
+	}
+	// A stable directory lock survives replacement of the DB inode by compact/reset.
+	if lock(int(directory.file.Fd())) != nil {
+		directory.close()
+		return nil, nil, errPrivateStorage
+	}
+	s := &cacheStorage{cacheDirectory: directory, name: filepath.Base(path)}
+	fail := func() (*cacheStorage, *bbolt.DB, error) { directory.close(); return nil, nil, errPrivateStorage }
+	var info unix.Stat_t
+	err = unix.Fstatat(int(directory.file.Fd()), s.name, &info, unix.AT_SYMLINK_NOFOLLOW)
+	if errors.Is(err, unix.ENOENT) {
+		var random [16]byte
+		if _, err = rand.Read(random[:]); err != nil {
+			return fail()
+		}
+		s.id = hex.EncodeToString(random[:])
+		db, e := s.createDB(false)
+		if e != nil {
+			return fail()
+		}
+		return s, db, nil
+	}
+	if err != nil {
+		return fail()
+	}
+	// A read-only descriptor and marker check precede chmod, writable open, cleanup or migration.
+	db, err := s.openDB(s.name, true, &info, false)
+	if err != nil {
+		return fail()
+	}
+	s.id, err = readStoreID(db)
+	if err == nil {
+		err = checkDatabase(db)
+	}
+	db.Close()
+	if err != nil {
+		return fail()
+	}
+	verified, err := s.open(s.name, unix.O_RDONLY, false)
+	if err != nil {
+		return fail()
+	}
+	current, err := fileIdentity(verified)
+	if err != nil || current.Dev != info.Dev || current.Ino != info.Ino || unix.Fchmod(int(verified.Fd()), 0o600) != nil {
+		verified.Close()
+		return fail()
+	}
+	verified.Close()
+	db, err = s.openDB(s.name, false, &info, true)
+	if err != nil {
+		return fail()
+	}
+	s.database = info
+	return s, db, nil
+}
