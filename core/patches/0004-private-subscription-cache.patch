@@ -0,0 +1,62 @@
+package cachefile
+
+import (
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStorageBodyWriteFailureKeepsVerifiedPair(t *testing.T) {
+	if os.Getenv("LOKI_CACHE_FSIZE_CHILD") != "1" {
+		command := exec.Command(os.Args[0], "-test.run=^TestStorageBodyWriteFailureKeepsVerifiedPair$", "-test.v")
+		command.Env = append(os.Environ(), "LOKI_CACHE_FSIZE_CHILD=1")
+		output, err := command.CombinedOutput()
+		require.NoError(t, err, "%s", output)
+		return
+	}
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	defer cache.Close()
+	old := &adapter.SavedBinary{Content: []byte("old-password"), LastEtag: "old"}
+	require.NoError(t, cache.SaveSubscription("provider", old))
+	// A real kernel write limit applies only in this disposable test child.
+	signal.Ignore(syscall.SIGXFSZ)
+	var limit syscall.Rlimit
+	require.NoError(t, syscall.Getrlimit(syscall.RLIMIT_FSIZE, &limit))
+	limit.Cur = 5
+	require.NoError(t, syscall.Setrlimit(syscall.RLIMIT_FSIZE, &limit))
+	require.Error(t, cache.SaveSubscription("provider", &adapter.SavedBinary{Content: []byte("new-password"), LastEtag: "new"}))
+	actual := cache.LoadSubscription("provider")
+	require.NotNil(t, actual)
+	require.Equal(t, old.Content, actual.Content)
+	require.Equal(t, old.LastEtag, actual.LastEtag)
+	entries, err := os.ReadDir(path + subscriptionSuffix)
+	require.NoError(t, err)
+	require.Len(t, entries, 1, "definite body-write failure leaves no new orphan")
+}
+
+func TestStorageTightensOnlyOwnedMarkedFiles(t *testing.T) {
+	for _, mode := range []os.FileMode{0o644, 0o400} {
+		path := filepath.Join(privateTestDirectory(t), "cache.db")
+		cache := openTestCacheFile(t, path)
+		require.NoError(t, cache.SaveSubscription("provider", &adapter.SavedBinary{Content: []byte("synthetic-private")}))
+		_, bodyPath := subscriptionFixture(t, cache.CacheFile, "provider")
+		require.NoError(t, cache.Close())
+		require.NoError(t, os.Chmod(path, mode))
+		require.NoError(t, os.Chmod(bodyPath, mode))
+		cache = openTestCacheFile(t, path)
+		require.NotNil(t, cache.LoadSubscription("provider"))
+		for _, name := range []string{path, bodyPath} {
+			info, err := os.Stat(name)
+			require.NoError(t, err)
+			require.Equal(t, os.FileMode(0o600), info.Mode().Perm())
+		}
+		require.NoError(t, cache.Close())
+	}
+}
diff --git a/experimental/cachefile/storage_lock_linux_test.go b/experimental/cachefile/storage_lock_linux_test.go
