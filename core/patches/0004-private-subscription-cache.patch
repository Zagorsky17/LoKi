@@ -0,0 +1,143 @@
+package provider
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	outboundAdapter "github.com/sagernet/sing-box/adapter/outbound"
+	providerAdapter "github.com/sagernet/sing-box/adapter/provider"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+type transactionCache struct {
+	adapter.CacheFile
+	failure bool
+	saved   *adapter.SavedBinary
+}
+
+func (c *transactionCache) StoreSubscriptions() bool { return true }
+func (c *transactionCache) SaveSubscription(_ string, saved *adapter.SavedBinary) error {
+	if c.failure {
+		return errors.New("synthetic storage failure")
+	}
+	copy := *saved
+	copy.Content = append([]byte(nil), saved.Content...)
+	c.saved = &copy
+	return nil
+}
+
+type transactionPrepared struct {
+	cache *transactionCache
+	saved *adapter.SavedBinary
+}
+
+func (c *transactionCache) PrepareSubscription(_ string, saved *adapter.SavedBinary) (adapter.PreparedSubscription, error) {
+	return &transactionPrepared{cache: c, saved: saved}, nil
+}
+func (p *transactionPrepared) Commit() error { return p.cache.SaveSubscription("", p.saved) }
+func (*transactionPrepared) Close() error    { return nil }
+
+type transactionOutbound struct {
+	outboundAdapter.Adapter
+	closed atomic.Int32
+}
+
+func (*transactionOutbound) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, nil
+}
+func (*transactionOutbound) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, nil
+}
+func (o *transactionOutbound) Close() error { o.closed.Add(1); return nil }
+
+func TestProviderFailedCacheCommitKeepsPublishedState(t *testing.T) {
+	registry := outboundAdapter.NewRegistry()
+	var constructed []*transactionOutbound
+	outboundAdapter.Register[option.VLESSOutboundOptions](registry, "vless", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, opts option.VLESSOutboundOptions) (adapter.Outbound, error) {
+		outbound := &transactionOutbound{Adapter: outboundAdapter.NewAdapter("vless", tag, nil, nil)}
+		constructed = append(constructed, outbound)
+		return outbound, nil
+	})
+	manager := outboundAdapter.NewManager(registry, nil, "")
+	ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), registry)
+	factory := log.NewNOPFactory()
+	logger := factory.NewLogger("test")
+	var responseAccess sync.Mutex
+	body, etag, code := "vless://00000000-0000-4000-8000-000000000001@127.0.0.1:12001#Node", "old", http.StatusOK
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		responseAccess.Lock()
+		defer responseAccess.Unlock()
+		w.Header().Set("ETag", etag)
+		w.Header().Set("Subscription-Userinfo", "total=100; expire=2000000000")
+		w.WriteHeader(code)
+		_, _ = w.Write([]byte(body))
+	}))
+	defer server.Close()
+	cache := new(transactionCache)
+	remote := &ProviderRemote{ctx: ctx, logger: logger, dialer: systemTestDialer{}, cacheFile: cache, url: server.URL, headers: make(http.Header)}
+	remote.Adapter = providerAdapter.NewAdapter(ctx, nil, manager, factory, logger, "provider", "remote", option.ProviderHealthCheckOptions{})
+	if err := remote.fetch(ctx); err != nil {
+		t.Fatal(err)
+	}
+	old := remote.OutboundSnapshot()
+	if len(old) != 1 {
+		t.Fatal("initial provider was not published")
+	}
+	oldContent, oldTime, oldEtag, oldCache := remote.rawContent, remote.lastUpdated, remote.lastEtag, cache.saved
+	oldCandidates := remote.FilterCandidates()
+	responseAccess.Lock()
+	body, etag = "vless://00000000-0000-4000-8000-000000000002@127.0.0.1:12002#Changed", "new"
+	responseAccess.Unlock()
+	cache.failure = true
+	if err := remote.fetch(ctx); err == nil {
+		t.Fatal("failed cache commit was reported as success")
+	}
+	if actual := remote.OutboundSnapshot(); !reflect.DeepEqual(old, actual) {
+		t.Fatal("failed cache commit changed runtime pointer or identity")
+	}
+	if remote.rawContent != oldContent || remote.lastEtag != oldEtag || !remote.lastUpdated.Equal(oldTime) || cache.saved != oldCache || !reflect.DeepEqual(remote.FilterCandidates(), oldCandidates) {
+		t.Fatal("failed cache commit changed published source or metadata")
+	}
+	if constructed[0].closed.Load() != 0 || constructed[len(constructed)-1].closed.Load() != 1 {
+		t.Fatal("failed update closed the old outbound or retained the rejected candidate")
+	}
+	cache.failure = false
+	if err := remote.fetch(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if actual := remote.OutboundSnapshot(); len(actual) != 1 || actual[0].Identity == old[0].Identity || actual[0].Outbound == old[0].Outbound {
+		t.Fatal("successful recovery did not publish the candidate")
+	}
+	if constructed[0].closed.Load() != 1 {
+		t.Fatal("successful replacement did not close the old outbound")
+	}
+	current, currentTime, currentEtag, currentInfo := remote.OutboundSnapshot(), remote.lastUpdated, remote.lastEtag, remote.SubscriptionInfo()
+	responseAccess.Lock()
+	code, etag = http.StatusNotModified, "newer"
+	responseAccess.Unlock()
+	cache.failure = true
+	if err := remote.fetch(ctx); err == nil {
+		t.Fatal("failed 304 metadata commit was reported as success")
+	}
+	if !reflect.DeepEqual(current, remote.OutboundSnapshot()) || !remote.lastUpdated.Equal(currentTime) || remote.lastEtag != currentEtag || remote.SubscriptionInfo() != currentInfo {
+		t.Fatal("failed 304 commit changed the published state")
+	}
+	cache.failure = false
+	if err := remote.fetch(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if remote.lastEtag != "newer" || !remote.lastUpdated.After(currentTime) {
+		t.Fatal("304 recovery did not commit metadata")
+	}
+}
diff --git a/provider/remote/etag_rejection_test.go b/provider/remote/etag_rejection_test.go
new file mode 100644
index 0000000..c474948
--- /dev/null
+++ b/provider/remote/etag_rejection_test.go
@@ -0,0 +1,159 @@
+package provider
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	outboundAdapter "github.com/sagernet/sing-box/adapter/outbound"
+	providerAdapter "github.com/sagernet/sing-box/adapter/provider"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/service"
+)
+
+func etagRemote(t *testing.T, url string, cache *transactionCache) *ProviderRemote {
+	t.Helper()
+	registry := outboundAdapter.NewRegistry()
+	outboundAdapter.Register[option.VLESSOutboundOptions](registry, "vless", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.VLESSOutboundOptions) (adapter.Outbound, error) {
+		if options.ServerPort == 12002 {
+			return nil, errors.New("synthetic outbound construction failure")
+		}
+		return &transactionOutbound{Adapter: outboundAdapter.NewAdapter("vless", tag, nil, nil)}, nil
+	})
+	manager := outboundAdapter.NewManager(registry, nil, "")
+	ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), registry)
+	factory := log.NewNOPFactory()
+	logger := factory.NewLogger("test")
+	remote := &ProviderRemote{ctx: ctx, logger: logger, dialer: systemTestDialer{}, cacheFile: cache, url: url, headers: make(http.Header)}
+	remote.Adapter = providerAdapter.NewAdapter(ctx, nil, manager, factory, logger, "provider", "remote", option.ProviderHealthCheckOptions{})
+	return remote
+}
+
+func TestRejectedResponseInvalidatesConditionalETagOnlyAfterPersist(t *testing.T) {
+	for _, fixture := range []struct {
+		tag               string
+		metadata, runtime bool
+	}{{"A", true, false}, {"B", true, false}, {"A", false, false}, {"A", true, true}} {
+		invalidTag := fixture.tag
+		wireTag := "\"" + invalidTag + "\""
+		suffix := invalidTag
+		if !fixture.metadata {
+			suffix += "-no-metadata"
+		}
+		if fixture.runtime {
+			suffix += "-runtime"
+		}
+		t.Run("rejected-etag-"+suffix, func(t *testing.T) {
+			var access sync.Mutex
+			mode := "valid"
+			var requests []string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				access.Lock()
+				current := mode
+				requests = append(requests, r.Header.Get("If-None-Match"))
+				access.Unlock()
+				if current == "timeout" {
+					<-r.Context().Done()
+					return
+				}
+				if current == "valid" {
+					w.Header().Set("ETag", "\"A\"")
+					_, _ = w.Write([]byte("vless://00000000-0000-4000-8000-000000000001@127.0.0.1:12001#Node"))
+					return
+				}
+				w.Header().Set("ETag", wireTag)
+				if fixture.metadata {
+					w.Header().Set("announce", "expired subscription")
+				}
+				if current == "conditional" && r.Header.Get("If-None-Match") == wireTag {
+					w.WriteHeader(http.StatusNotModified)
+					return
+				}
+				if fixture.runtime {
+					_, _ = w.Write([]byte("vless://00000000-0000-4000-8000-000000000001@127.0.0.1:12002#Node"))
+					return
+				}
+				_, _ = w.Write([]byte("[]"))
+			}))
+			defer server.Close()
+			cache := new(transactionCache)
+			remote := etagRemote(t, server.URL, cache)
+			if err := remote.fetch(remote.ctx); err != nil {
+				t.Fatal(err)
+			}
+			oldNodes, oldRaw, oldTime, oldMeta, oldSaved := remote.OutboundSnapshot(), remote.rawContent, remote.lastUpdated, remote.SubscriptionMetadata(), cache.saved
+			setMode := func(value string) { access.Lock(); mode = value; access.Unlock() }
+			setMode("timeout")
+			ctx, cancel := context.WithTimeout(remote.ctx, 30*time.Millisecond)
+			err := remote.fetch(ctx)
+			cancel()
+			if !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("timeout lost its safe context sentinel: %v", err)
+			}
+			if remote.etag() != "\"A\"" || cache.saved != oldSaved || remote.SubscriptionMetadata() != oldMeta {
+				t.Fatal("no-response timeout changed cached state")
+			}
+			setMode("invalid")
+			cache.failure = true
+			if err := remote.fetch(remote.ctx); err == nil {
+				t.Fatal("failed persistence reported success")
+			}
+			if remote.etag() != "\"A\"" || cache.saved != oldSaved || remote.SubscriptionMetadata() != oldMeta || !remote.lastUpdated.Equal(oldTime) {
+				t.Fatal("failed persistence changed prior validator or metadata")
+			}
+			cache.failure = false
+			if err := remote.fetch(remote.ctx); err == nil {
+				t.Fatal("invalid received body accepted")
+			}
+			if remote.etag() != "" || cache.saved.LastEtag != "" {
+				t.Fatal("rejected body left a conditional validator which can hide the failure behind304")
+			}
+			if remote.rawContent != oldRaw || !reflect.DeepEqual(oldNodes, remote.OutboundSnapshot()) || !remote.lastUpdated.Equal(oldTime) {
+				t.Fatal("invalid received body changed the working provider")
+			}
+			if fixture.metadata && remote.SubscriptionMetadata().Announce != "expired subscription" {
+				t.Fatal("rejected response metadata was lost")
+			}
+			setMode("conditional")
+			if err := remote.fetch(remote.ctx); err == nil {
+				t.Fatal("next request hid the rejected body behind304")
+			}
+			access.Lock()
+			last := requests[len(requests)-1]
+			access.Unlock()
+			if last != "" {
+				t.Fatal("next request reused a validator after body rejection")
+			}
+		})
+	}
+}
+
+func TestNotModifiedRequiresMatchingCachedValidator(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("ETag", "\"A\"")
+		w.WriteHeader(http.StatusNotModified)
+	}))
+	defer server.Close()
+	for _, kind := range []string{"initial", "rejected", "different-header"} {
+		t.Run(kind, func(t *testing.T) {
+			remote := &ProviderRemote{url: server.URL, headers: make(http.Header)}
+			if kind != "initial" {
+				remote.rawContent = "old cached profile"
+			}
+			if kind == "different-header" {
+				remote.lastEtag = "\"A\""
+				remote.headers.Set("If-None-Match", "\"B\"")
+			}
+			if _, err := remote.fetchProvider(context.Background(), server.Client()); err == nil {
+				t.Fatal("unverifiable304 accepted as a valid cached representation")
+			}
+		})
+	}
+}
diff --git a/provider/remote/fetch_privacy_test.go b/provider/remote/fetch_privacy_test.go
new file mode 100644
index 0000000..e4dd4f6
--- /dev/null
+++ b/provider/remote/fetch_privacy_test.go
@@ -0,0 +1,58 @@
+package provider
+
+import (
+	"context"
+	"io"
+	stdlog "log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestProviderFetchErrorsDoNotExposeUntrustedRequestData(t *testing.T) {
+	const secret = "synthetic-provider-token-do-not-log"
+	tlsServer := httptest.NewTLSServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	tlsServer.Config.ErrorLog = stdlog.New(io.Discard, "", 0)
+	defer tlsServer.Close()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	refused := "http://" + listener.Addr().String() + "/?token=" + secret
+	listener.Close()
+	statusServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		connection, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		defer connection.Close()
+		_, _ = io.WriteString(connection, "HTTP/1.1 503 "+secret+"\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+	}))
+	defer statusServer.Close()
+	for _, testCase := range []struct{ name, url, category string }{
+		{"malformed", "://" + secret, "invalid subscription URL"},
+		{"TLS", tlsServer.URL + "/?token=" + secret, "subscription TLS"},
+		{"refused", refused, "subscription network"},
+		{"status", statusServer.URL + "/?token=" + secret, "HTTP status 503"},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			remote := &ProviderRemote{url: testCase.url, headers: http.Header{"X-Synthetic-Secret": {secret}}}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			_, err := remote.fetchProvider(ctx, &http.Client{Timeout: time.Second})
+			if err == nil {
+				t.Fatal("failed request reported success")
+			}
+			message := err.Error()
+			if strings.Contains(message, secret) || strings.Contains(message, "127.0.0.1") || strings.Contains(message, "example.invalid") {
+				t.Fatal("request error disclosed untrusted URL/host/reason: " + message)
+			}
+			if !strings.Contains(message, testCase.category) {
+				t.Fatalf("expected fixed category %q, got %q", testCase.category, message)
+			}
+		})
+	}
+}
diff --git a/provider/remote/publication_refusal_test.go b/provider/remote/publication_refusal_test.go
new file mode 100644
index 0000000..a4004ec
--- /dev/null
+++ b/provider/remote/publication_refusal_test.go
@@ -0,0 +1,140 @@
+package provider
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sync"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	outboundAdapter "github.com/sagernet/sing-box/adapter/outbound"
+	providerAdapter "github.com/sagernet/sing-box/adapter/provider"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/service"
+)
+
+type publicationManager struct {
+	*outboundAdapter.Manager
+	conflict  bool
+	callbacks int
+}
+
+func (m *publicationManager) SwapBatchWithCommit(old map[string]adapter.Outbound, candidates []adapter.Outbound, commit func() error) (map[string]adapter.Outbound, error) {
+	if m.conflict {
+		changed := make(map[string]adapter.Outbound, len(old))
+		for tag := range old {
+			changed[tag] = &transactionOutbound{Adapter: outboundAdapter.NewAdapter("vless", tag, nil, nil)}
+		}
+		old = changed
+	}
+	return m.Manager.SwapBatchWithCommit(old, candidates, func() error { m.callbacks++; return commit() })
+}
+
+type publicationCache struct {
+	transactionCache
+	commits, fallbackSaves int
+}
+type publicationPrepared struct {
+	cache *publicationCache
+	saved *adapter.SavedBinary
+}
+
+func (c *publicationCache) PrepareSubscription(_ string, saved *adapter.SavedBinary) (adapter.PreparedSubscription, error) {
+	return &publicationPrepared{c, saved}, nil
+}
+func (c *publicationCache) SaveSubscription(tag string, saved *adapter.SavedBinary) error {
+	c.fallbackSaves++
+	return c.transactionCache.SaveSubscription(tag, saved)
+}
+func (p *publicationPrepared) Commit() error {
+	p.cache.commits++
+	return p.cache.transactionCache.SaveSubscription("", p.saved)
+}
+func (*publicationPrepared) Close() error { return nil }
+
+func TestPublicationRefusalNeverPersistsResponseMetadata(t *testing.T) {
+	for _, kind := range []string{"expected-old", "dependency"} {
+		t.Run(kind, func(t *testing.T) {
+			registry := outboundAdapter.NewRegistry()
+			var built []*transactionOutbound
+			outboundAdapter.Register[option.VLESSOutboundOptions](registry, "vless", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, opts option.VLESSOutboundOptions) (adapter.Outbound, error) {
+				var dependencies []string
+				if opts.Detour != "" {
+					dependencies = []string{opts.Detour}
+				}
+				value := &transactionOutbound{Adapter: outboundAdapter.NewAdapter("vless", tag, nil, dependencies)}
+				built = append(built, value)
+				return value, nil
+			})
+			manager := &publicationManager{Manager: outboundAdapter.NewManager(registry, nil, "")}
+			ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), registry)
+			factory := log.NewNOPFactory()
+			logger := factory.NewLogger("test")
+			var responseAccess sync.Mutex
+			changed := false
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				responseAccess.Lock()
+				next := changed
+				responseAccess.Unlock()
+				body := "vless://00000000-0000-4000-8000-000000000001@127.0.0.1:12001#Node"
+				w.Header().Set("ETag", "\"old\"")
+				w.Header().Set("announce", "old notice")
+				if next {
+					body = "vless://00000000-0000-4000-8000-000000000001@127.0.0.1:12003#Changed"
+					w.Header().Set("ETag", "\"new\"")
+					w.Header().Set("announce", "new notice")
+				}
+				_, _ = w.Write([]byte(body))
+			}))
+			defer server.Close()
+			cache := new(publicationCache)
+			remote := &ProviderRemote{ctx: ctx, logger: logger, dialer: systemTestDialer{}, cacheFile: cache, url: server.URL, headers: make(http.Header)}
+			remote.Adapter = providerAdapter.NewAdapter(ctx, nil, manager, factory, logger, "provider", "remote", option.ProviderHealthCheckOptions{})
+			if err := remote.fetch(ctx); err != nil {
+				t.Fatal(err)
+			}
+			old := remote.OutboundSnapshot()
+			oldFilters := remote.FilterCandidates()
+			oldRaw, oldMeta, oldEtag, oldTime, oldSaved := remote.rawContent, remote.SubscriptionMetadata(), remote.etag(), remote.UpdatedAt(), cache.saved
+			previousCommits, previousCallbacks := cache.commits, manager.callbacks
+			if kind == "expected-old" {
+				manager.conflict = true
+			} else {
+				opts := option.VLESSOutboundOptions{DialerOptions: option.DialerOptions{Detour: old[0].Tag()}}
+				if err := manager.Create(ctx, nil, logger, "external-dependent", "vless", &opts); err != nil {
+					t.Fatal(err)
+				}
+			}
+			responseAccess.Lock()
+			changed = true
+			responseAccess.Unlock()
+			if err := remote.fetch(ctx); err == nil {
+				t.Fatal("publication conflict was reported as success")
+			}
+			if manager.callbacks != previousCallbacks || cache.commits != previousCommits || cache.fallbackSaves != 0 {
+				t.Fatal("publication refusal invoked candidate commit or fallback SaveSubscription")
+			}
+			if !reflect.DeepEqual(old, remote.OutboundSnapshot()) || !reflect.DeepEqual(oldFilters, remote.FilterCandidates()) || remote.rawContent != oldRaw || remote.SubscriptionMetadata() != oldMeta || remote.etag() != oldEtag || !remote.UpdatedAt().Equal(oldTime) || cache.saved != oldSaved {
+				t.Fatal("publication refusal changed previously committed state")
+			}
+			if built[0].closed.Load() != 0 || built[len(built)-1].closed.Load() != 1 {
+				t.Fatal("publication refusal closed old runtime or retained its candidate")
+			}
+			manager.conflict = false
+			if kind == "dependency" {
+				if err := manager.Remove("external-dependent"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := remote.fetch(ctx); err != nil {
+				t.Fatal(err)
+			}
+			if cache.commits != previousCommits+1 || manager.callbacks != previousCallbacks+1 || cache.fallbackSaves != 0 || remote.etag() != "\"new\"" || reflect.DeepEqual(old, remote.OutboundSnapshot()) {
+				t.Fatal("resolved publication conflict did not recover normally")
+			}
+		})
+	}
+}
