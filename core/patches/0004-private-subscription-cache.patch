+)
+
+// testing.TempDir creates its numbered leaf with 0777 subject to umask. Positive
+// fixtures explicitly prepare a private directory; unsafe-parent tests change it afterward.
+func privateTestDirectory(t *testing.T) string {
+	t.Helper()
+	directory := t.TempDir()
