@@ -0,0 +1,96 @@
+package cachefile
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/sagernet/bbolt"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStorageBoundaryPrivateModes(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	defer cache.Close()
+	require.NoError(t, cache.SaveSubscription("provider", &adapter.SavedBinary{Content: []byte("synthetic-password")}))
+	require.NoError(t, cache.SaveRuleSet("rules", &adapter.SavedBinary{Content: []byte("example.test")}))
+	require.NoError(t, filepath.Walk(filepath.Dir(path), func(name string, info os.FileInfo, err error) error {
+		require.NoError(t, err)
+		if info.IsDir() {
+			require.Equal(t, os.FileMode(0o700), info.Mode().Perm(), "cache directory is public")
+		} else {
+			require.Equal(t, os.FileMode(0o600), info.Mode().Perm(), "cache file is public")
+		}
+		return nil
+	}))
+}
+func TestStorageBoundaryRejectUnmarkedDatabase(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	database, err := bbolt.Open(path, 0o644, nil)
+	require.NoError(t, err)
+	require.NoError(t, database.Update(func(tx *bbolt.Tx) error {
+		bucket, err := tx.CreateBucket([]byte("other_application"))
+		if err != nil {
+			return err
+		}
+		return bucket.Put([]byte("keep"), []byte("synthetic-private-data"))
+	}))
+	require.NoError(t, database.Close())
+	require.NoError(t, os.Chmod(path, 0o644))
+	before, err := os.ReadFile(path)
+	require.NoError(t, err)
+	cache := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path})
+	scope := adapter.NewScope(context.Background(), logger.NOP())
+	err = cache.Start(adapter.StartStateInitialize, scope)
+	if err == nil {
+		scope.Close()
+	}
+	require.Error(t, err, "a foreign DB must be refused before writable open or cleanup")
+	after, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, before, after)
+	info, err := os.Stat(path)
+	require.NoError(t, err)
+	require.Equal(t, os.FileMode(0o644), info.Mode().Perm(), "foreign DB permissions changed")
+}
+func TestStorageBoundarySymlinkDoesNotTruncate(t *testing.T) {
+	directory := privateTestDirectory(t)
+	path := filepath.Join(directory, "cache.db")
+	cache := openTestCacheFile(t, path)
+	defer cache.Close()
+	victim := filepath.Join(directory, "unrelated")
+	original := []byte("keep-unrelated-synthetic-content")
+	require.NoError(t, os.WriteFile(victim, original, 0o600))
+	ruleDirectory := path + ruleSetFileSuffix
+	require.NoError(t, os.Mkdir(ruleDirectory, 0o700))
+	require.NoError(t, os.Symlink(victim, filepath.Join(ruleDirectory, ruleSetFileName(nil, "provider")+ruleSetFileWriting)))
+	_ = cache.SaveSubscription("provider", &adapter.SavedBinary{Content: []byte("replaced-synthetic-content")})
+	after, err := os.ReadFile(victim)
+	require.NoError(t, err)
+	require.Equal(t, original, after, "predictable staging path followed a symlink")
+}
+func TestStorageBoundaryFailedCommitKeepsBodyAndMetadata(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	before := &adapter.SavedBinary{Content: []byte("old-secret"), LastEtag: "old-etag", LastUpdated: time.Unix(10, 0), URLHash: []byte{1}}
+	require.NoError(t, cache.SaveSubscription("provider", before))
+	require.NoError(t, cache.DB.Close())
+	next := &adapter.SavedBinary{Content: []byte("new-secret"), LastEtag: "new-etag", LastUpdated: time.Unix(20, 0), URLHash: []byte{2}}
+	require.Error(t, cache.SaveSubscription("provider", next))
+	_ = cache.Close()
+	reopened := openTestCacheFile(t, path)
+	defer reopened.Close()
+	actual := reopened.LoadSubscription("provider")
+	require.NotNil(t, actual)
+	require.True(t, bytes.Equal(before.Content, actual.Content), "failed DB commit replaced the previous immutable body")
+	require.Equal(t, before.LastEtag, actual.LastEtag)
+	require.True(t, before.LastUpdated.Equal(actual.LastUpdated))
+	require.Equal(t, before.URLHash, actual.URLHash)
+}
