+
+func TestStorageRejectsRawNoncanonicalCorePaths(t *testing.T) {
+	for _, kind := range []string{"dotdot", "dot", "double-slash", "trailing-slash", "relative"} {
+		t.Run(kind, func(t *testing.T) {
+			directory := privateTestDirectory(t)
+			path := directory + "/cache.db"
+			switch kind {
+			case "dotdot":
+				path = directory + "/child/../cache.db"
+			case "dot":
+				path = directory + "/./cache.db"
+			case "double-slash":
+				path = directory + "//cache.db"
+			case "trailing-slash":
+				path = directory + "/cache.db/"
+			case "relative":
+				path = "cache.db"
+			}
+			ctx := filemanager.WithDefault(context.Background(), directory, directory, os.Getuid(), os.Getgid())
+			cache := New(ctx, logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path})
+			scope := adapter.NewScope(ctx, logger.NOP())
+			err := cache.Start(adapter.StartStateInitialize, scope)
+			if err == nil {
+				scope.Close()
+			}
+			require.Error(t, err, "raw cache paths must not be silently rewritten")
+			entries, err := os.ReadDir(directory)
+			require.NoError(t, err)
+			require.Empty(t, entries, "rejected raw input created files or directories")
+		})
+	}
+}
