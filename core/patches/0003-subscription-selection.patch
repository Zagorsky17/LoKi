+func TestSelectorSerializesStartAndProviderCallbacks(t *testing.T) {
+	p := &identityProvider{testProvider: testProvider{tag: "provider"}, members: []adapter.ProviderMember{identityMember("provider/C", "c")}}
+	cache := &selectorMemoryCache{state: adapter.SelectorState{Tag: "provider/C", Provider: p.tag, Identity: strings.Repeat("c", 64)}}
+	s := identitySelector(cache, p)
+	s.Adapter = outboundAdapter.NewAdapter(C.TypeSelector, "group", []string{"tcp", "udp"}, []string{"manual"})
+	s.tags = []string{"manual"}
+	s.provider = &testProviderManager{providers: s.providers}
+	manager := &selectorStartManager{testOutboundManager: testOutboundManager{outbounds: map[string]adapter.Outbound{"manual": newTestOutbound("manual")}}, entered: make(chan struct{}), release: make(chan struct{})}
+	s.outbound = manager
+	scope := adapter.NewScope(context.Background(), log.NewNOPFactory().NewLogger("test"))
+	defer scope.Close()
+	done := make(chan error, 1)
+	go func() { done <- s.Start(adapter.StartStateStart, scope) }()
+	<-manager.entered
+	var callbacks sync.WaitGroup
+	callbacks.Add(1)
+	go func() {
+		defer callbacks.Done()
+		for i := 0; i < 80; i++ {
+			s.onProviderUpdated(p.tag)
+		}
+	}()
+	close(manager.release)
+	require.NoError(t, <-done)
+	callbacks.Wait()
+	requireIdentity(t, s, p.tag, "c")
+}
