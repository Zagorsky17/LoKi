+type selectorStartManager struct {
+	testOutboundManager
+	entered chan struct{}
+	release chan struct{}
+}
+
+func (m *selectorStartManager) Outbound(tag string) (adapter.Outbound, bool) {
+	close(m.entered)
+	<-m.release
+	return m.testOutboundManager.Outbound(tag)
+}
