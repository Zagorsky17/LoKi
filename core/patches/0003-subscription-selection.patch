+func TestProviderIdentityResolvesInternalReferencesWithoutMutatingSources(t *testing.T) {
+	hop := identityHTTP("Hop", 18081)
+	node := option.Outbound{Type: C.TypeVLESS, Tag: "Node", Options: &option.VLESSOutboundOptions{
