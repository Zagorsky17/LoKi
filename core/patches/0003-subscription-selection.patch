+
+type savedSelectorState struct {
+	Version int `json:"version"`
+	adapter.SelectorState
+}
+
+func validSelectorState(state adapter.SelectorState) bool {
+	if state.Tag == "" {
+		return false
+	}
+	if state.Provider == "" {
+		return state.Identity == ""
+	}
+	identity, err := hex.DecodeString(state.Identity)
+	return err == nil && len(identity) == 32 && hex.EncodeToString(identity) == state.Identity
+}
+
+func (c *CacheFile) LoadSelectorState(group string) (state adapter.SelectorState, loaded bool) {
+	c.view(func(t *bbolt.Tx) error {
+		bucket, selected := c.bucket(t, bucketSelectorState), c.bucket(t, bucketSelected)
+		if bucket == nil || selected == nil {
+			return nil
+		}
+		var saved savedSelectorState
+		if json.Unmarshal(bucket.Get([]byte(group)), &saved) == nil && saved.Version == 1 &&
+			validSelectorState(saved.SelectorState) && saved.Tag == string(selected.Get([]byte(group))) {
+			state, loaded = saved.SelectorState, true
+		}
+		return nil
+	})
+	return
+}
+
+func (c *CacheFile) StoreSelectorState(group string, state adapter.SelectorState) error {
+	if !validSelectorState(state) {
+		return errors.New("invalid selector state")
+	}
+	content, err := json.Marshal(savedSelectorState{Version: 1, SelectorState: state})
+	if err != nil {
+		return err
+	}
+	return c.batch(func(t *bbolt.Tx) error {
+		selected, err := c.createBucket(t, bucketSelected)
+		if err != nil {
+			return err
+		}
+		bucket, err := c.createBucket(t, bucketSelectorState)
+		if err != nil {
+			return err
+		}
+		if err := selected.Put([]byte(group), []byte(state.Tag)); err != nil {
+			return err
+		}
+		return bucket.Put([]byte(group), content)
 	})
 }
 
