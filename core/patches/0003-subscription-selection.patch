+// Internal references carry their field and dependency identity separately, so an external
+// tag cannot impersonate an internal edge by spelling the same digest.
+func providerOutboundIdentity(outbound option.Outbound, identities map[string]string) (string, error) {
+	outbound.Tag = ""
+	outbound.Options = cloneOptions(outbound.Options)
+	references := make(map[string]string)
+	reference := func(field, tag string) string {
+		if identity, internal := identities[tag]; internal {
+			references[field] = identity
+			return ""
+		}
+		return tag
+	}
+	if dialer, loaded := outbound.Options.(option.DialerOptionsWrapper); loaded {
+		options := dialer.TakeDialerOptions()
+		options.Detour = reference("detour", options.Detour)
+		dialer.ReplaceDialerOptions(options)
+	}
+	rewriteDownload := func(transport *option.V2RayTransportOptions) {
+		rewriteXHTTPDownloadDetour(transport, func(tag string) string {
+			return reference("xhttp_download_detour", tag)
+		})
+	}
+	switch options := outbound.Options.(type) {
+	case *option.VLESSOutboundOptions:
+		rewriteDownload(options.Transport)
+	case *option.VMessOutboundOptions:
+		rewriteDownload(options.Transport)
+	case *option.TrojanOutboundOptions:
+		rewriteDownload(options.Transport)
+	}
+	rawStrings := make(map[string]string)
+	if !identityStringBytes(reflect.ValueOf(outbound.Options), "", 0, rawStrings) {
+		return "", E.New("cannot encode provider outbound identity")
+	}
+	content, err := json.MarshalContext(context.Background(), struct {
+		Outbound           *option.Outbound  `json:"outbound"`
+		InternalReferences map[string]string `json:"internal_references,omitempty"`
+		RawStrings         map[string]string `json:"raw_strings,omitempty"`
+	}{&outbound, references, rawStrings})
+	if err != nil {
+		return "", E.New("cannot encode provider outbound identity")
+	}
+	hash := sha256.Sum256(content)
+	return hex.EncodeToString(hash[:]), nil
+}
+
+// Preserve non-UTF-8 credential bytes that JSON would replace, without changing runtime options.
+func identityStringBytes(value reflect.Value, path string, depth int, raw map[string]string) bool {
+	if !value.IsValid() {
+		return true
+	}
+	if depth > 64 {
+		return false
+	}
+	switch value.Kind() {
+	case reflect.String:
+		if !utf8.ValidString(value.String()) {
+			raw[path] = base64.RawStdEncoding.EncodeToString([]byte(value.String()))
+		}
+	case reflect.Interface, reflect.Pointer:
+		return value.IsNil() || identityStringBytes(value.Elem(), path, depth+1, raw)
+	case reflect.Struct:
+		for index := 0; index < value.NumField(); index++ {
+			field := value.Type().Field(index)
+			fieldType := field.Type
+			if fieldType.Kind() == reflect.Pointer {
+				fieldType = fieldType.Elem()
+			}
+			if field.PkgPath != "" && !(field.Anonymous && fieldType.Kind() == reflect.Struct) {
+				continue
+			}
+			name := strings.SplitN(field.Tag.Get("json"), ",", 2)[0]
+			fieldPath := path
+			if name == "-" {
+				// shortcut: custom marshalers encode virtual fields, review identity compatibility before renaming their Go fields.
+				fieldPath += "!" + base64.RawURLEncoding.EncodeToString([]byte(field.Name))
+			} else if name != "" || !field.Anonymous {
+				if name == "" {
+					name = field.Name
+				}
+				fieldPath += "." + base64.RawURLEncoding.EncodeToString([]byte(name))
+			}
+			if !identityStringBytes(value.Field(index), fieldPath, depth+1, raw) {
+				return false
+			}
+		}
+	case reflect.Map:
+		iterator := value.MapRange()
+		for iterator.Next() {
+			key := iterator.Key()
+			var content []byte
+			if key.Kind() == reflect.String {
+				content = []byte(key.String())
+			} else {
+				var err error
+				content, err = json.MarshalContext(context.Background(), key.Interface())
+				if err != nil {
+					return false
+				}
+			}
+			keyPath := path + "{" + base64.RawURLEncoding.EncodeToString(content) + "}"
+			if !identityStringBytes(key, keyPath+"#key", depth+1, raw) || !identityStringBytes(iterator.Value(), keyPath, depth+1, raw) {
+				return false
+			}
+		}
+	case reflect.Array, reflect.Slice:
+		if value.Kind() == reflect.Slice && value.Type().Elem().Kind() == reflect.Uint8 {
+			if !utf8.Valid(value.Bytes()) {
+				raw[path+"#bytes"] = base64.RawStdEncoding.EncodeToString(value.Bytes())
+			}
+		} else {
+			for index := 0; index < value.Len(); index++ {
+				if !identityStringBytes(value.Index(index), path+"["+strconv.Itoa(index)+"]", depth+1, raw) {
+					return false
+				}
+			}
+		}
+	}
+	return true
 }
 
