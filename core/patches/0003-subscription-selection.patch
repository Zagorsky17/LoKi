+package group
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	outboundAdapter "github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/interrupt"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing/service"
+	"github.com/stretchr/testify/require"
+)
+
+type identityProvider struct {
+	testProvider
+	members []adapter.ProviderMember
+}
+
+func (p *identityProvider) OutboundSnapshot() []adapter.ProviderMember {
+	return append([]adapter.ProviderMember(nil), p.members...)
+}
+
+func identityMember(tag, id string) adapter.ProviderMember {
+	return adapter.ProviderMember{Outbound: newTestOutbound(tag), Identity: strings.Repeat(id, 64)}
+}
+
+type selectorMemoryCache struct {
+	adapter.CacheFile
+	access sync.Mutex
+	state  adapter.SelectorState
+	legacy string
+	fail   bool
+}
+
+func (c *selectorMemoryCache) LoadSelected(string) string {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.legacy
+}
+
+func (c *selectorMemoryCache) LoadSelectorState(string) (adapter.SelectorState, bool) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	return c.state, c.state.Tag != ""
+}
+
+func (c *selectorMemoryCache) StoreSelectorState(_ string, state adapter.SelectorState) error {
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.fail {
+		return errors.New("synthetic cache failure")
+	}
+	c.state, c.legacy = state, state.Tag
+	return nil
+}
+
+func identitySelector(cache *selectorMemoryCache, providers ...*identityProvider) *Selector {
+	ctx := context.Background()
+	if cache != nil {
+		ctx = service.ContextWith[adapter.CacheFile](ctx, cache)
+	}
+	s := &Selector{
+		Adapter: outboundAdapter.NewAdapter(C.TypeSelector, "group", []string{"tcp", "udp"}, nil),
+		ctx:     ctx, logger: log.NewNOPFactory().NewLogger("test"),
+		outbounds: make(map[string]adapter.Outbound), interruptGroup: interrupt.NewGroup(),
+		providers: make(map[string]adapter.Provider), outboundsCache: make(map[string][]adapter.Outbound),
+	}
+	for _, provider := range providers {
+		s.providers[provider.tag] = provider
+		s.providerTags = append(s.providerTags, provider.tag)
+	}
+	return s
+}
+
+func requireIdentity(t *testing.T, s *Selector, provider, identity string) {
+	t.Helper()
+	selected := selectedTag(s)
+	actual := s.selectionByTag[selected]
+	require.Equal(t, provider, actual.Provider)
+	require.Equal(t, strings.Repeat(identity, 64), actual.Identity)
+}
+
+func TestSelectorKeepsProviderIdentityAcrossChanges(t *testing.T) {
+	for _, persisted := range []bool{false, true} {
+		for _, position := range []int{0, 1} {
+			t.Run(fmt.Sprintf("cache=%t/position=%d", persisted, position), func(t *testing.T) {
+				var cache *selectorMemoryCache
+				if persisted {
+					cache = &selectorMemoryCache{}
+				}
+				p := &identityProvider{testProvider: testProvider{tag: "provider"}}
+				other := &identityProvider{testProvider: testProvider{tag: "other"}, members: []adapter.ProviderMember{identityMember("other/Node", "c")}}
+				p.members = []adapter.ProviderMember{identityMember("provider/Node", "c"), identityMember("provider/Node #2", "d")}
+				if position == 1 {
+					p.members[0].Identity, p.members[1].Identity = p.members[1].Identity, p.members[0].Identity
+				}
+				s := identitySelector(cache, p, other)
+				require.NoError(t, s.onProviderUpdated(p.tag))
+				require.True(t, s.SelectOutbound(p.members[position].Tag()))
+				requireIdentity(t, s, p.tag, "c")
+				p.members[0].Identity, p.members[1].Identity = p.members[1].Identity, p.members[0].Identity
+				require.NoError(t, s.onProviderUpdated(p.tag))
+				requireIdentity(t, s, p.tag, "c")
+				require.Equal(t, p.members[1-position].Tag(), selectedTag(s))
+				p.members = []adapter.ProviderMember{identityMember("provider/Renamed", "c"), identityMember("provider/Added", "a")}
+				require.NoError(t, s.onProviderUpdated(p.tag))
+				requireIdentity(t, s, p.tag, "c")
+				if persisted {
+					s = identitySelector(cache, p, other)
+					require.NoError(t, s.onProviderUpdated(p.tag))
+					requireIdentity(t, s, p.tag, "c")
+				}
+				p.members = []adapter.ProviderMember{identityMember("provider/Fallback", "a")}
+				require.NoError(t, s.onProviderUpdated(p.tag))
+				requireIdentity(t, s, p.tag, "a")
+				p.members = append(p.members, identityMember("provider/Returned", "c"))
+				require.NoError(t, s.onProviderUpdated(p.tag))
+				requireIdentity(t, s, p.tag, "c")
+				require.NoError(t, s.onProviderUpdated(other.tag))
+				requireIdentity(t, s, p.tag, "c")
+			})
+		}
+	}
+}
+
+func TestSelectorExplicitFallbackChoiceAndFailedPersistence(t *testing.T) {
+	p := &identityProvider{testProvider: testProvider{tag: "provider"}, members: []adapter.ProviderMember{identityMember("provider/A", "a"), identityMember("provider/C", "c")}}
+	cache := &selectorMemoryCache{}
+	s := identitySelector(cache, p)
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	require.True(t, s.SelectOutbound("provider/C"))
+	p.members = p.members[:1]
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	require.Equal(t, "provider/A", selectedTag(s))
+	cache.fail = true
+	require.False(t, s.SelectOutbound("provider/A"))
+	require.Equal(t, "provider/C", cache.state.Tag)
+	require.Equal(t, "provider/C", s.selection.Tag)
+	cache.fail = false
+	require.True(t, s.SelectOutbound("provider/A"), "selecting the current fallback must store new intent")
+	p.members = append(p.members, identityMember("provider/C", "c"))
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	requireIdentity(t, s, p.tag, "a")
+	cache.fail = true
+	require.False(t, s.SelectOutbound("provider/C"))
+	requireIdentity(t, s, p.tag, "a")
+	require.False(t, s.SelectOutbound("missing"))
+}
+
+func TestSelectorLegacyCacheAndIdenticalMembers(t *testing.T) {
+	p := &identityProvider{testProvider: testProvider{tag: "provider"}, members: []adapter.ProviderMember{identityMember("provider/First", "a"), identityMember("provider/Chosen", "c")}}
+	cache := &selectorMemoryCache{legacy: "provider/Chosen"}
+	s := identitySelector(cache, p)
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	requireIdentity(t, s, p.tag, "a")
+	require.True(t, s.SelectOutbound("provider/Chosen"))
+	p.members = append(p.members, identityMember("provider/Duplicate", "c"))
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	require.Equal(t, "provider/Chosen", selectedTag(s))
+	p.members = append(p.members[:1], p.members[2])
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	require.Equal(t, "provider/Duplicate", selectedTag(s))
+
+	manual := newTestOutbound("manual")
+	s = identitySelector(&selectorMemoryCache{legacy: "manual"})
+	s.tags, s.outbounds = []string{"other", "manual"}, map[string]adapter.Outbound{"other": newTestOutbound("other"), "manual": manual}
+	selected, err := s.outboundSelect()
+	require.NoError(t, err)
+	require.Same(t, manual, selected)
+	s.defaultTag = "missing"
+	s.selection = adapter.SelectorState{}
+	_, err = s.outboundSelect()
+	require.Error(t, err)
+}
+
+func TestSelectorSerializesConcurrentSelectionAndProviderCallbacks(t *testing.T) {
+	p := &identityProvider{testProvider: testProvider{tag: "provider"}, members: []adapter.ProviderMember{identityMember("provider/A", "a"), identityMember("provider/C", "c")}}
+	cache := &selectorMemoryCache{}
+	s := identitySelector(cache, p)
+	require.NoError(t, s.onProviderUpdated(p.tag))
+	var work sync.WaitGroup
+	for _, tag := range []string{"provider/A", "provider/C"} {
+		work.Add(1)
+		go func(tag string) {
+			defer work.Done()
+			for i := 0; i < 40; i++ {
+				s.SelectOutbound(tag)
+				s.onProviderUpdated(p.tag)
+			}
+		}(tag)
+	}
+	work.Wait()
+	require.Equal(t, cache.state.Tag, selectedTag(s))
+	require.Equal(t, cache.state, s.selection)
+}
