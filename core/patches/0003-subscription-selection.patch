+func TestProviderIdentityIncludesConnectionOptions(t *testing.T) {
+	base := identityHTTP("Node", 18081)
+	want := identityPrepared(t, []option.Outbound{base}, "")[0].identity
+	for name, change := range map[string]func(*option.HTTPOutboundOptions){
+		"username": func(o *option.HTTPOutboundOptions) { o.Username = "other-user" },
+		"password": func(o *option.HTTPOutboundOptions) { o.Password = "other-password" },
+		"server":   func(o *option.HTTPOutboundOptions) { o.Server = "127.0.0.2" },
+		"port":     func(o *option.HTTPOutboundOptions) { o.ServerPort++ },
+		"path":     func(o *option.HTTPOutboundOptions) { o.Path = "/connect" },
+		"tls": func(o *option.HTTPOutboundOptions) {
+			o.TLS = &option.OutboundTLSOptions{Enabled: true, ServerName: "dns.test"}
+		},
+		"dialer": func(o *option.HTTPOutboundOptions) { o.BindInterface = "wan" },
+	} {
+		t.Run(name, func(t *testing.T) {
+			changed := cloneOutbounds([]option.Outbound{base})
+			change(changed[0].Options.(*option.HTTPOutboundOptions))
+			if identityPrepared(t, changed, "")[0].identity == want {
+				t.Fatal("a changed connection parameter retained the identity")
+			}
+		})
+	}
+	changedType := base
+	changedType.Type = C.TypeSOCKS
+	if identityPrepared(t, []option.Outbound{changedType}, "")[0].identity == want {
+		t.Fatal("protocol type was omitted from the identity")
+	}
+	withHeaders := cloneOutbounds([]option.Outbound{base})
+	withHeaders[0].Options.(*option.HTTPOutboundOptions).Headers = badoption.HTTPHeader{"X-B": {"b"}, "X-A": {"a"}}
+	otherOrder := cloneOutbounds(withHeaders)
+	otherOrder[0].Options.(*option.HTTPOutboundOptions).Headers = badoption.HTTPHeader{"X-A": {"a"}, "X-B": {"b"}}
+	if identityPrepared(t, withHeaders, "")[0].identity != identityPrepared(t, otherOrder, "")[0].identity {
