+	renamed[1].Options.(*option.VLESSOutboundOptions).Detour = "Renamed Hop"
+	renamed[1].Options.(*option.VLESSOutboundOptions).Transport.XHTTPOptions.Download.Detour = "Renamed Hop"
+	second := identityPrepared(t, renamed, "")
+	if first[0].identity != second[1].identity || first[1].identity != second[0].identity {
