+		t.Fatal("identity serialization failed after changing the outbound manager")
+	}
+}
+
+func identitySnapshot(t *testing.T, provider *Adapter) []adapter.ProviderMember {
+	t.Helper()
+	source, ok := any(provider).(adapter.ProviderOutboundSnapshot)
+	if !ok {
+		t.Fatal("provider has no paired identity/runtime snapshot")
+	}
+	return source.OutboundSnapshot()
+}
+
+func TestProviderSnapshotIsCopiedPublishedAndClearedAtomically(t *testing.T) {
+	provider, _, _, _ := newStageTestProvider(t, nil)
+	source := []option.Outbound{{Type: "recording", Tag: "Node", Options: &option.VLESSOutboundOptions{UUID: "synthetic-uuid"}}}
+	if err := provider.UpdateOutbounds(source); err != nil {
+		t.Fatal(err)
+	}
+	first := identitySnapshot(t, provider)
+	if len(first) != 1 || first[0].Outbound != provider.Outbounds()[0] || first[0].Identity == "" {
+		t.Fatal("the snapshot did not pair the published runtime and identity")
+	}
+	copy := append([]adapter.ProviderMember(nil), first...)
+	first[0].Identity = "changed"
+	first[0].Outbound = nil
+	if !reflect.DeepEqual(identitySnapshot(t, provider), copy) {
+		t.Fatal("a caller mutated the published snapshot")
+	}
+	if err := provider.publishOutbounds([]preparedOutbound{{tag: "missing"}}); err == nil {
+		t.Fatal("a missing runtime must fail publication")
+	}
+	if !reflect.DeepEqual(identitySnapshot(t, provider), copy) {
+		t.Fatal("failed publication replaced the snapshot")
+	}
+	if err := provider.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if len(identitySnapshot(t, provider)) != 0 {
+		t.Fatal("closed provider retained the snapshot")
+	}
+}
+
+type snapshotIdentityOutbound struct {
+	linkTestOutbound
+	marker string
+}
+
+func TestProviderSnapshotPairsRuntimeAndIdentityDuringUpdates(t *testing.T) {
+	registry := outboundAdapter.NewRegistry()
+	outboundAdapter.Register[option.VLESSOutboundOptions](registry, "recording", func(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options option.VLESSOutboundOptions) (adapter.Outbound, error) {
+		return &snapshotIdentityOutbound{linkTestOutbound: linkTestOutbound{Adapter: outboundAdapter.NewAdapter("recording", tag, nil, nil)}, marker: options.UUID}, nil
+	})
+	ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), registry)
+	logFactory := log.NewNOPFactory()
+	provider := &Adapter{ctx: ctx, outbound: &filteringTestOutboundManager{outbounds: make(map[string]adapter.Outbound)}, logFactory: logFactory, logger: logFactory.NewLogger("test"), providerTag: "subscription"}
+	source := func(marker string) []option.Outbound {
+		return []option.Outbound{{Type: "recording", Tag: "Node", Options: &option.VLESSOutboundOptions{UUID: marker}}}
+	}
+	want := map[string]string{}
+	for _, marker := range []string{"C", "D"} {
+		want[marker] = identityPrepared(t, source(marker), "")[0].identity
+	}
+	if err := provider.UpdateOutbounds(source("C")); err != nil {
+		t.Fatal(err)
+	}
+	snapshot := any(provider).(adapter.ProviderOutboundSnapshot)
+	stop, done := make(chan struct{}), make(chan error, 1)
+	go func() {
+		for {
+			select {
+			case <-stop:
+				done <- nil
+				return
+			default:
+				members := snapshot.OutboundSnapshot()
+				if len(members) != 1 || members[0].Identity != want[members[0].Outbound.(*snapshotIdentityOutbound).marker] {
+					done <- fmt.Errorf("runtime and identity came from different publications")
+					return
+				}
+			}
+		}
+	}()
+	for index := 0; index < 100; index++ {
+		if err := provider.UpdateOutbounds(source([]string{"C", "D"}[index%2])); err != nil {
+			close(stop)
+			<-done
+			t.Fatal(err)
+		}
+	}
+	close(stop)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
