+package provider
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestProviderIdentityDoesNotMergeInvalidUTF8Credentials(t *testing.T) {
+	node := func(password string) option.Outbound {
+		return option.Outbound{Type: C.TypeHTTP, Tag: "Node", Options: &option.HTTPOutboundOptions{Password: password}}
+	}
+	invalid, invalidErr := providerOutboundIdentity(node(string([]byte{0xff})), nil)
+	replacement, replacementErr := providerOutboundIdentity(node("\uFFFD"), nil)
+	if replacementErr != nil {
+		t.Fatal(replacementErr)
+	}
+	if invalidErr != nil || invalid == replacement {
+		t.Fatal("different credential bytes share one identity after JSON replacement")
+	}
+}
+
+func TestIdentityStringBytesCoverNestedValuesAndBoundCycles(t *testing.T) {
+	bad := string([]byte{0xff})
+	for _, value := range []any{bad, &bad, []string{bad}, [1]string{bad}, map[string]any{"key": bad}, map[string]string{bad: "value"}, []byte{0xff, 0}, map[int]string{1: bad}} {
+		raw := make(map[string]string)
+		if !identityStringBytes(reflect.ValueOf(value), "", 0, raw) || len(raw) == 0 {
+			t.Fatal("nested credential bytes were not preserved")
+		}
+	}
+	for _, value := range []any{nil, (*string)(nil), "Пароль 🔑", map[string]any{"nested": []string{"valid", "\uFFFD", "a\x00b"}}} {
+		raw := make(map[string]string)
+		if !identityStringBytes(reflect.ValueOf(value), "", 0, raw) || len(raw) != 0 {
+			t.Fatal("valid UTF-8 must keep the ordinary JSON identity")
+		}
+	}
+	cycle := map[string]any{}
+	cycle["self"] = cycle
+	if identityStringBytes(reflect.ValueOf(cycle), "", 0, make(map[string]string)) {
+		t.Fatal("cyclic input escaped the depth limit")
+	}
+}
+
+func TestIdentityDepthFailurePreservesPublishedProvider(t *testing.T) {
+	provider, manager, _, _ := newStageTestProvider(t, nil)
+	good := option.Outbound{Type: "recording", Tag: "Node", Options: &option.VLESSOutboundOptions{UUID: "synthetic-uuid"}}
+	if err := provider.UpdateOutbounds([]option.Outbound{good}); err != nil {
+		t.Fatal(err)
+	}
+	before := identitySnapshot(t, provider)
+	bad := good
+	cycle := map[string]any{"secret": "synthetic-secret"}
+	cycle["self"] = cycle
+	bad.Options = cycle
+	err := provider.UpdateOutbounds([]option.Outbound{bad})
+	if err == nil || strings.Contains(err.Error(), "synthetic-secret") {
+		t.Fatal("cyclic data must fail without exposing credentials")
+	}
+	if !reflect.DeepEqual(before, identitySnapshot(t, provider)) {
+		t.Fatal("cyclic data replaced the published snapshot")
+	}
+	if current, loaded := manager.Outbound(before[0].Tag()); !loaded || current != before[0].Outbound {
+		t.Fatal("cyclic data changed the running outbound")
+	}
+}
+
+func TestIdentityCredentialBytesStayBoundToTheirField(t *testing.T) {
+	bad, replacement := string([]byte{0xff}), "\uFFFD"
+	seen := make(map[string]bool)
+	for _, options := range []any{
+		&option.HTTPOutboundOptions{Username: bad, Password: replacement},
+		&option.HTTPOutboundOptions{Username: replacement, Password: bad},
+		&option.HTTPOutboundOptions{Username: replacement, Password: string([]byte{0xfe})},
+		map[string]any{"headers": map[string]string{bad: replacement}},
+		map[string]any{"headers": map[string]string{replacement: bad}},
+	} {
+		identity, err := providerOutboundIdentity(option.Outbound{Type: C.TypeHTTP, Options: options}, nil)
+		if err != nil || seen[identity] {
+			t.Fatal("credential bytes lost their structural position")
+		}
+		seen[identity] = true
+	}
+}
+
+func TestIdentityBytesUseStableJSONFieldNames(t *testing.T) {
+	bad := string([]byte{0xff})
+	first := struct {
+		Old string `json:"password"`
+	}{bad}
+	second := struct {
+		Renamed string `json:"password"`
+	}{bad}
+	left, err := providerOutboundIdentity(option.Outbound{Type: C.TypeHTTP, Options: first}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	right, err := providerOutboundIdentity(option.Outbound{Type: C.TypeHTTP, Options: second}, nil)
+	if err != nil || left != right {
+		t.Fatal("Go field rename changed the connection identity")
+	}
+}
+
+func TestIdentityBytesIncludeVirtualTransportFields(t *testing.T) {
+	seen := make(map[string]bool)
+	for _, path := range []string{"/" + string([]byte{0xff}), "/\uFFFD"} {
+		options := &option.VLESSOutboundOptions{UUID: "synthetic-uuid", Transport: &option.V2RayTransportOptions{Type: "ws", WebsocketOptions: option.V2RayWebsocketOptions{Path: path}}}
+		identity, err := providerOutboundIdentity(option.Outbound{Type: C.TypeVLESS, Options: options}, nil)
+		if err != nil || seen[identity] {
+			t.Fatal("custom JSON transport lost raw parameter bytes")
+		}
+		seen[identity] = true
+	}
+}
