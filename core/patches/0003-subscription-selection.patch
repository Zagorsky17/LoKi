@@ -0,0 +1,104 @@
+package cachefile
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/bbolt"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/stretchr/testify/require"
+)
+
+func selectorTestState(tag string) adapter.SelectorState {
+	return adapter.SelectorState{Tag: tag, Provider: "provider", Identity: strings.Repeat("a", 64)}
+}
+
+func openSelectorTestCache(t *testing.T, path, id string) *testCacheFile {
+	t.Helper()
+	cache := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path, CacheID: id})
+	scope := adapter.NewScope(context.Background(), logger.NOP())
+	require.NoError(t, cache.Start(adapter.StartStateInitialize, scope))
+	return &testCacheFile{cache, scope}
+}
+
+func TestSelectorStatePersistsAndKeepsCacheNamespaces(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.db")
+	state := selectorTestState("provider/Node #2")
+	cache := openSelectorTestCache(t, path, "")
+	require.NoError(t, cache.StoreSelectorState("group", state))
+	require.Equal(t, state.Tag, cache.LoadSelected("group"))
+	require.NoError(t, cache.Close())
+
+	other := openSelectorTestCache(t, path, "other")
+	_, loaded := other.LoadSelectorState("group")
+	require.False(t, loaded)
+	require.NoError(t, other.StoreSelected("group", "manual"))
+	require.NoError(t, other.Close())
+
+	cache = openSelectorTestCache(t, path, "")
+	defer cache.Close()
+	actual, loaded := cache.LoadSelectorState("group")
+	require.True(t, loaded)
+	require.Equal(t, state, actual)
+	require.NoError(t, cache.StoreSelected("group", "manual"))
+	_, loaded = cache.LoadSelectorState("group")
+	require.False(t, loaded, "ordinary selector/fallback writes must clear provider intent")
+	require.Equal(t, "manual", cache.LoadSelected("group"))
+	require.NoError(t, cache.StoreSelectorState("group", adapter.SelectorState{Tag: "manual"}))
+	actual, loaded = cache.LoadSelectorState("group")
+	require.True(t, loaded)
+	require.Equal(t, adapter.SelectorState{Tag: "manual"}, actual)
+}
+
+func TestSelectorStateRejectsInvalidAndCorruptedData(t *testing.T) {
+	cache := openSelectorTestCache(t, filepath.Join(t.TempDir(), "cache.db"), "")
+	defer cache.Close()
+	state := selectorTestState("chosen")
+	require.NoError(t, cache.StoreSelectorState("group", state))
+	for _, invalid := range []adapter.SelectorState{
+		{}, {Tag: "node", Identity: state.Identity}, {Tag: "node", Provider: "provider"},
+		{Tag: "node", Provider: "provider", Identity: "bad"},
+		{Tag: "node", Provider: "provider", Identity: strings.Repeat("A", 64)},
+	} {
+		require.Error(t, cache.StoreSelectorState("group", invalid))
+		actual, loaded := cache.LoadSelectorState("group")
+		require.True(t, loaded)
+		require.Equal(t, state, actual)
+	}
+	for _, content := range []string{
+		`{`, `null`, `{}`, `{"version":2,"tag":"chosen"}`,
+		`{"version":1,"tag":"chosen","provider":"provider","identity":"bad"}`,
+		`{"version":1,"tag":"wrong"}`,
+	} {
+		require.NoError(t, cache.batch(func(tx *bbolt.Tx) error {
+			return cache.bucket(tx, bucketSelectorState).Put([]byte("group"), []byte(content))
+		}))
+		_, loaded := cache.LoadSelectorState("group")
+		require.False(t, loaded, content)
+		require.Equal(t, "chosen", cache.LoadSelected("group"))
+	}
+}
+
+func TestSelectorStateWritesRollbackTogether(t *testing.T) {
+	cache := openSelectorTestCache(t, filepath.Join(t.TempDir(), "cache.db"), "")
+	require.NoError(t, cache.StoreSelected("group", "old"))
+	require.NoError(t, cache.batch(func(tx *bbolt.Tx) error {
+		bucket, err := cache.createBucket(tx, bucketSelectorState)
+		if err != nil {
+			return err
+		}
+		_, err = bucket.CreateBucket([]byte("group"))
+		return err
+	}))
+	// A conflicting bucket fails the second write after the legacy tag was put.
+	require.Error(t, cache.StoreSelectorState("group", selectorTestState("new")))
+	require.Equal(t, "old", cache.LoadSelected("group"), "the first write must roll back")
+	_, loaded := cache.LoadSelectorState("group")
+	require.False(t, loaded)
+	require.NoError(t, cache.Close())
+	require.Error(t, cache.StoreSelectorState("group", selectorTestState("closed")))
+}
