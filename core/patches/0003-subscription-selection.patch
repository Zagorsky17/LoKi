+func identityHTTP(tag string, port uint16) option.Outbound {
+	return option.Outbound{Type: C.TypeHTTP, Tag: tag, Options: &option.HTTPOutboundOptions{
+		ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: port},
+		Username:      "synthetic-user", Password: "synthetic-password",
+	}}
+}
+
+func identityPrepared(t *testing.T, source []option.Outbound, detour string) []preparedOutbound {
+	t.Helper()
+	copy := cloneOutbounds(source)
+	normalizeOutboundTags(copy, false, nil)
+	prepared, err := prepareOutbounds("subscription", copy, detour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, outbound := range prepared {
+		decoded, err := hex.DecodeString(outbound.identity)
+		if err != nil || len(decoded) != 32 {
+			t.Fatal("provider member has no SHA-256 identity")
+		}
+	}
+	return sourceOrder(prepared)
+}
+
+func TestProviderIdentitySurvivesNamesAndNeighborChanges(t *testing.T) {
+	c, d := identityHTTP("Node", 18081), identityHTTP("Node", 18082)
+	original := identityPrepared(t, []option.Outbound{c, d}, "")
+	for _, source := range [][]option.Outbound{
+		{d, c}, {identityHTTP("Node", 18083), d, c}, {c},
+		{identityHTTP("Renamed", 18081), d},
+	} {
+		prepared := identityPrepared(t, source, "")
+		for _, item := range prepared {
+			port := item.source.Options.(*option.HTTPOutboundOptions).ServerPort
+			if port == 18081 && item.identity != original[0].identity {
+				t.Fatal("rename/reorder/add/remove changed the same connection identity")
+			}
+		}
+	}
+	if original[0].identity == original[1].identity {
+		t.Fatal("different servers were merged")
+	}
+	identical := identityPrepared(t, []option.Outbound{c, c}, "")
+	if identical[0].identity != identical[1].identity || identical[0].tag == identical[1].tag {
+		t.Fatal("identical connections need one identity and distinct display tags")
+	}
+	if c.Tag != "Node" || d.Tag != "Node" {
+		t.Fatal("identity preparation changed the source tags")
+	}
+}
