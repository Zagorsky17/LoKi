@@ -0,0 +1,120 @@
+// Modified for LoKi on 2026-11-04: retain both possible bodies after an uncertain commit.
+package cachefile
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/bbolt"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSubscriptionUncertainCommitKeepsBothRecoveryImages(t *testing.T) {
+	for _, restoreOldImage := range []bool{false, true} {
+		name := "new-image"
+		if restoreOldImage {
+			name = "old-image"
+		}
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(privateTestDirectory(t), "cache.db")
+			cache := openTestCacheFile(t, path)
+			old := &adapter.SavedBinary{Content: []byte("old-password"), LastEtag: "old", LastUpdated: time.Unix(10, 0), URLHash: []byte{1}}
+			next := &adapter.SavedBinary{Content: []byte("new-password"), LastEtag: "new", LastUpdated: time.Unix(20, 0), URLHash: []byte{2}}
+			require.NoError(t, cache.SaveSubscription("provider", old))
+			_, oldPath := subscriptionFixture(t, cache.CacheFile, "provider")
+			oldImage, err := os.ReadFile(path)
+			require.NoError(t, err)
+			require.Error(t, cache.saveSubscriptionWithCommit("provider", next, func(fn func(*bbolt.Tx) error) error {
+				require.NoError(t, cache.update(fn))
+				return errors.New("synthetic metadata sync ambiguity")
+			}))
+			_, nextPath := subscriptionFixture(t, cache.CacheFile, "provider")
+			require.NotEqual(t, oldPath, nextPath)
+			require.FileExists(t, oldPath, "current View cannot prove that the old durable pointer was replaced")
+			require.FileExists(t, nextPath, "current View cannot prove that the new pointer was not committed")
+			cache.pruneSubscriptionFiles()
+			require.FileExists(t, oldPath, "GC must not guess the durable outcome while writes are latched")
+			require.FileExists(t, nextPath)
+			require.Error(t, cache.SaveRuleSet("rules", old), "subscription uncertainty blocks SRS staging too")
+			require.NoDirExists(t, path+ruleSetFileSuffix)
+			require.NoError(t, cache.Close())
+			expected, unusedPath := next, oldPath
+			if restoreOldImage {
+				// Restore a complete pre-commit DB image to model the old durable outcome.
+				// This is a deterministic recovery control, not a physical power-loss test.
+				require.NoError(t, os.WriteFile(path, oldImage, 0o600))
+				expected, unusedPath = old, nextPath
+			}
+			cache = openTestCacheFile(t, path)
+			defer cache.Close()
+			actual := cache.LoadSubscription("provider")
+			require.NotNil(t, actual)
+			require.Equal(t, expected.Content, actual.Content)
+			require.Equal(t, expected.LastEtag, actual.LastEtag)
+			require.True(t, expected.LastUpdated.Equal(actual.LastUpdated))
+			require.Equal(t, expected.URLHash, actual.URLHash)
+			require.NoFileExists(t, unusedPath, "only a verified restart may collect the unreferenced version")
+		})
+	}
+}
+
+func TestSubscriptionGCWaitsForCommitOutcome(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	defer cache.Close()
+	old := &adapter.SavedBinary{Content: []byte("old-password"), LastEtag: "old"}
+	next := &adapter.SavedBinary{Content: []byte("new-password"), LastEtag: "new"}
+	require.NoError(t, cache.SaveSubscription("provider", old))
+	_, oldPath := subscriptionFixture(t, cache.CacheFile, "provider")
+	visible, release, committed := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	var once sync.Once
+	releaseCommit := func() { once.Do(func() { close(release) }) }
+	defer releaseCommit()
+	go func() {
+		committed <- cache.saveSubscriptionWithCommit("provider", next, func(fn func(*bbolt.Tx) error) error {
+			if err := cache.update(fn); err != nil {
+				return err
+			}
+			close(visible)
+			<-release
+			return errors.New("synthetic delayed metadata sync failure")
+		})
+	}()
+	select {
+	case <-visible:
+	case <-time.After(5 * time.Second):
+		t.Fatal("candidate metadata was not published")
+	}
+	started, collected := make(chan struct{}), make(chan struct{})
+	go func() { close(started); cache.pruneSubscriptionFiles(); close(collected) }()
+	<-started
+	premature := false
+	select {
+	case <-collected:
+		premature = true
+	case <-time.After(100 * time.Millisecond):
+	}
+	releaseCommit()
+	select {
+	case err := <-committed:
+		require.Error(t, err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("uncertain commit did not return")
+	}
+	if !premature {
+		select {
+		case <-collected:
+		case <-time.After(5 * time.Second):
+			t.Fatal("cleanup did not observe the commit outcome")
+		}
+	}
+	require.False(t, premature, "GC treated visible metadata as durable before its sync outcome")
+	require.FileExists(t, oldPath, "a paused failing commit still requires its previous durable body")
+	_, nextPath := subscriptionFixture(t, cache.CacheFile, "provider")
+	require.FileExists(t, nextPath)
+}
