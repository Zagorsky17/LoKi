+++ b/experimental/cachefile/storage_recovery_test.go
@@ -0,0 +1,149 @@
+// Modified for LoKi on 2026-11-04: establish durability before orphan cleanup.
+package cachefile
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/sagernet/bbolt"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/stretchr/testify/require"
+)
+
+func storeSchemaForTest(t *testing.T, cache *CacheFile) string {
+	t.Helper()
+	var schema string
+	require.NoError(t, cache.view(func(tx *bbolt.Tx) error {
+		schema = string(tx.Bucket(bucketStore).Get([]byte("schema")))
+		return nil
+	}))
+	return schema
+}
+
+func TestSRSOwnV1ReadAndAtomicSchemaUpgrade(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	old := &adapter.SavedBinary{Content: []byte("old.lab.example\n"), LastEtag: "old", LastUpdated: time.Unix(10, 0), URLHash: []byte{1}}
+	legacyRecord, err := ruleSetRecord(old)
+	require.NoError(t, err)
+	require.NoError(t, os.Mkdir(path+ruleSetFileSuffix, 0o700))
+	legacyPath := filepath.Join(path+ruleSetFileSuffix, ruleSetFileName(nil, "rules"))
+	require.NoError(t, os.WriteFile(legacyPath, old.Content, 0o600))
+	require.NoError(t, cache.update(func(tx *bbolt.Tx) error {
+		if err := tx.Bucket(bucketStore).Put([]byte("schema"), []byte("1")); err != nil {
+			return err
+		}
+		bucket, err := cache.createBucket(tx, bucketRuleSetFile)
+		if err != nil {
+			return err
+		}
+		return bucket.Put([]byte("rules"), legacyRecord)
+	}))
+	require.NoError(t, cache.SaveSubscription("provider", &adapter.SavedBinary{Content: []byte("subscription")}))
+	require.Equal(t, "1", storeSchemaForTest(t, cache.CacheFile), "subscription writes do not require the new SRS format")
+	require.NoError(t, cache.Close())
+	cache = openTestCacheFile(t, path)
+	defer cache.Close()
+	actual := cache.LoadRuleSet("rules")
+	require.NotNil(t, actual)
+	require.Equal(t, old.Content, actual.Content)
+	require.Equal(t, old.LastEtag, actual.LastEtag)
+	require.Equal(t, old.URLHash, actual.URLHash)
+	require.True(t, old.LastUpdated.Equal(actual.LastUpdated))
+	require.Equal(t, "1", storeSchemaForTest(t, cache.CacheFile))
+	next := &adapter.SavedBinary{Content: []byte("new.lab.example\n"), LastEtag: "new", LastUpdated: time.Unix(20, 0), URLHash: []byte{2}}
+	require.Error(t, cache.saveRuleSetFileWith("rules", next, func(fn func(*bbolt.Tx) error) error {
+		return cache.update(func(tx *bbolt.Tx) error {
+			if err := fn(tx); err != nil {
+				return err
+			}
+			return errors.New("synthetic rollback after schema and pointer writes")
+		})
+	}, (*os.File).Sync, ""))
+	require.Equal(t, "1", storeSchemaForTest(t, cache.CacheFile), "schema guard must roll back with the pointer")
+	raw, err := cache.ruleSetPointer("rules")
+	require.NoError(t, err)
+	require.Nil(t, raw)
+	require.Equal(t, old.Content, cache.LoadRuleSet("rules").Content)
+	require.NoError(t, cache.Close())
+	cache = openTestCacheFile(t, path)
+	defer cache.Close()
+	require.NoError(t, cache.SaveRuleSet("rules", next))
+	require.Equal(t, "2", storeSchemaForTest(t, cache.CacheFile), "r5's strict schema1 reader must refuse the upgraded store")
+	record, _ := ruleSetFixture(t, cache.CacheFile, "rules")
+	require.Equal(t, 2, record.Version)
+	require.NoError(t, cache.view(func(tx *bbolt.Tx) error {
+		require.Nil(t, cache.bucket(tx, bucketRuleSetFile).Get([]byte("rules")))
+		return nil
+	}))
+	legacyBody, err := os.ReadFile(legacyPath)
+	require.NoError(t, err)
+	require.Equal(t, old.Content, legacyBody, "unversioned legacy filenames are not automatic cleanup targets")
+	require.Equal(t, next.Content, cache.LoadRuleSet("rules").Content)
+	require.Equal(t, []byte("subscription"), cache.LoadSubscription("provider").Content)
+}
+
+func TestCacheStartupSyncFailurePreservesRecoveryBodies(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	require.NoError(t, cache.SaveSubscription("provider", &adapter.SavedBinary{Content: []byte("keep-subscription")}))
+	require.NoError(t, cache.SaveRuleSet("rules", &adapter.SavedBinary{Content: []byte("keep-rule")}))
+	_, subscriptionPath := subscriptionFixture(t, cache.CacheFile, "provider")
+	_, rulePath := ruleSetFixture(t, cache.CacheFile, "rules")
+	orphans := []string{filepath.Join(path+subscriptionSuffix, "s-"+cache.storage.id+"-00000000000000000000000000000001"), filepath.Join(path+ruleSetFileSuffix, ".loki-srs-"+cache.storage.id+"-00000000000000000000000000000002")}
+	for _, name := range orphans {
+		require.NoError(t, os.WriteFile(name, []byte("preserve-until-sync"), 0o600))
+	}
+	require.NoError(t, cache.Close())
+	before, err := os.ReadFile(path)
+	require.NoError(t, err)
+	candidate := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path})
+	called := false
+	require.Error(t, candidate.startWithSync(func(*bbolt.DB) error {
+		called = true
+		for _, name := range orphans {
+			require.FileExists(t, name)
+		}
+		return errors.New("synthetic startup sync failure")
+	}))
+	require.True(t, called, "startup must establish durability before any cleanup")
+	after, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, before, after, "startup failure must not migrate or compact")
+	for _, name := range append(orphans, subscriptionPath, rulePath) {
+		require.FileExists(t, name)
+	}
+	cache = openTestCacheFile(t, path)
+	defer cache.Close()
+	for _, name := range orphans {
+		require.NoFileExists(t, name)
+	}
+	require.NotNil(t, cache.LoadSubscription("provider"))
+	require.NotNil(t, cache.LoadRuleSet("rules"))
+}
+
+func TestStorageRejectFutureSchemaBeforeMutation(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	require.NoError(t, cache.update(func(tx *bbolt.Tx) error { return tx.Bucket(bucketStore).Put([]byte("schema"), []byte("999")) }))
+	require.NoError(t, cache.Close())
+	require.NoError(t, os.Chmod(path, 0o644))
+	before, err := os.ReadFile(path)
+	require.NoError(t, err)
+	candidate := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path})
+	called := false
+	require.Error(t, candidate.startWithSync(func(*bbolt.DB) error { called = true; return nil }))
+	require.False(t, called, "unknown format must fail at the read-only ownership boundary")
+	after, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, before, after)
+	info, err := os.Stat(path)
+	require.NoError(t, err)
+	require.Equal(t, os.FileMode(0o644), info.Mode().Perm())
+}
