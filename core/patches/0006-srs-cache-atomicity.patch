+// Modified for LoKi on 2026-11-04: preserve SRS pairs and exhaust private cache cleanup.
+package cachefile
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSRSClosedDBSameSizeCoherence(t *testing.T) {
+	path := filepath.Join(privateTestDirectory(t), "cache.db")
+	cache := openTestCacheFile(t, path)
+	before := &adapter.SavedBinary{Content: []byte("old.lab.example\n"), LastEtag: "old-etag", LastUpdated: time.Unix(10, 0), URLHash: []byte{1}}
+	next := &adapter.SavedBinary{Content: []byte("new.lab.example\n"), LastEtag: "new-etag", LastUpdated: time.Unix(20, 0), URLHash: []byte{2}}
+	require.Equal(t, len(before.Content), len(next.Content))
+	require.NoError(t, cache.SaveRuleSet("rules", before))
+	require.NoError(t, cache.DB.Close())
+	require.Error(t, cache.SaveRuleSet("rules", next))
+	_ = cache.Close()
+	cache = openTestCacheFile(t, path)
+	defer cache.Close()
+	actual := cache.LoadRuleSet("rules")
+	require.NotNil(t, actual)
+	require.Equal(t, before.Content, actual.Content, "failed metadata commit replaced the previously committed SRS body")
+	require.Equal(t, before.LastEtag, actual.LastEtag)
+	require.True(t, before.LastUpdated.Equal(actual.LastUpdated))
+	require.Equal(t, before.URLHash, actual.URLHash)
+}
+
+func TestPrivateCacheGCPassesPermanentFirstPage(t *testing.T) {
+	for _, namespace := range []string{"subscriptions", "rules"} {
+		t.Run(namespace, func(t *testing.T) {
+			path := filepath.Join(privateTestDirectory(t), "cache.db")
+			cache := openTestCacheFile(t, path)
+			defer cache.Close()
+			suffix, prefix := subscriptionSuffix, "s-"+cache.storage.id+"-"
+			if namespace == "rules" {
+				suffix, prefix = ruleSetFileSuffix, ".loki-srs-"+cache.storage.id+"-"
+			}
+			directory := path + suffix
+			require.NoError(t, os.Mkdir(directory, 0o700))
+			for index := 0; index < 768; index++ {
+				name := fmt.Sprintf("%s%032x", prefix, index)
+				require.NoError(t, os.WriteFile(filepath.Join(directory, name), []byte("synthetic-orphan"), 0o600))
+			}
+			foreign := filepath.Join(directory, "unrelated-file")
+			require.NoError(t, os.WriteFile(foreign, []byte("keep-foreign"), 0o600))
+			file, err := os.Open(directory)
+			require.NoError(t, err)
+			ordered, err := file.ReadDir(-1)
+			require.NoError(t, err)
+			require.NoError(t, file.Close())
+			require.Greater(t, len(ordered), 256)
+			// Protect the actual first page, independent of filesystem enumeration order.
+			// Link targets are outside the scanned directory, so its ordering does not change.
+			protected := make(map[string]bool)
+			for index, entry := range ordered[:256] {
+				protected[entry.Name()] = true
+				require.NoError(t, os.Link(filepath.Join(directory, entry.Name()), filepath.Join(filepath.Dir(path), fmt.Sprintf("keep-%d", index))))
+			}
+			file, err = os.Open(directory)
+			require.NoError(t, err)
+			first, err := file.ReadDir(256)
+			require.NoError(t, err)
+			require.NoError(t, file.Close())
+			for _, entry := range first {
+				require.True(t, protected[entry.Name()], "fixture must keep every entry in the first page")
+			}
+			prune := func() {
+				if namespace == "rules" {
+					cache.pruneRuleSetFiles(cache.DB)
+				} else {
+					cache.pruneSubscriptionFiles()
+				}
+			}
+			prune()
+			for _, entry := range ordered {
+				name := filepath.Join(directory, entry.Name())
+				if protected[entry.Name()] || entry.Name() == "unrelated-file" {
+					require.FileExists(t, name, "GC removed protected data")
+				} else {
+					require.NoFileExists(t, name, "permanent first page hid a later owned orphan")
+				}
+			}
+			prune()
+			actual, err := os.ReadFile(foreign)
+			require.NoError(t, err)
+			require.Equal(t, []byte("keep-foreign"), actual)
+		})
+	}
+}
