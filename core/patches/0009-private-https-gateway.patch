+// Modified for LoKi on 2026-11-05: use the existing HTTPS identity without changing shared key files.
+package lokigateway
+
+import (
+	"bytes"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/asn1"
+	"encoding/pem"
+	"errors"
+	"time"
+)
+
+var errTLSIdentity = errors.New("existing HTTPS certificate or private key unavailable, invalid or expired")
+
+func tlsIdentity(certificate, key []byte, now time.Time) (tls.Certificate, error) {
+	if len(certificate) == 0 || len(key) == 0 || len(certificate) > 65536 || len(key) > 65536 {
+		return tls.Certificate{}, errTLSIdentity
+	}
+	if !bytes.HasPrefix(certificate, []byte("-----BEGIN ")) {
+		if _, err := x509.ParseCertificate(certificate); err != nil {
+			return tls.Certificate{}, errTLSIdentity
+		}
+		certificate = pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate})
+	}
+	for remaining := certificate; len(bytes.TrimSpace(remaining)) != 0; {
+		if !bytes.HasPrefix(bytes.TrimSpace(remaining), []byte("-----BEGIN CERTIFICATE-----")) {
+			return tls.Certificate{}, errTLSIdentity
+		}
+		block, rest := pem.Decode(remaining)
+		if block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 {
+			return tls.Certificate{}, errTLSIdentity
+		}
+		if _, err := x509.ParseCertificate(block.Bytes); err != nil {
+			return tls.Certificate{}, errTLSIdentity
+		}
+		remaining = rest
+	}
+	keyDER := key
+	if bytes.HasPrefix(key, []byte("-----BEGIN ")) {
+		block, rest := pem.Decode(key)
+		if block == nil || len(bytes.TrimSpace(rest)) != 0 || len(block.Headers) != 0 ||
+			(block.Type != "PRIVATE KEY" && block.Type != "RSA PRIVATE KEY" && block.Type != "EC PRIVATE KEY") {
+			return tls.Certificate{}, errTLSIdentity
+		}
+		if !bytes.HasPrefix(key, []byte("-----BEGIN "+block.Type+"-----")) {
+			return tls.Certificate{}, errTLSIdentity
+		}
+		keyDER = block.Bytes
+	}
+	// Some x509 key parsers ignore trailing ASN.1 bytes; an identity must consume the entire input.
+	var object asn1.RawValue
+	if rest, err := asn1.Unmarshal(keyDER, &object); err != nil || len(rest) != 0 {
+		return tls.Certificate{}, errTLSIdentity
+	}
+	if !bytes.HasPrefix(key, []byte("-----BEGIN ")) {
+		kind := "PRIVATE KEY"
+		if _, err := x509.ParsePKCS8PrivateKey(key); err != nil {
+			kind = "RSA PRIVATE KEY"
+			if _, err := x509.ParsePKCS1PrivateKey(key); err != nil {
+				kind = "EC PRIVATE KEY"
+				if _, err := x509.ParseECPrivateKey(key); err != nil {
+					return tls.Certificate{}, errTLSIdentity
+				}
+			}
+		}
+		key = pem.EncodeToMemory(&pem.Block{Type: kind, Bytes: key})
+	}
+	identity, err := tls.X509KeyPair(certificate, key)
+	if err != nil || len(identity.Certificate) == 0 {
+		return tls.Certificate{}, errTLSIdentity
+	}
+	leaf, err := x509.ParseCertificate(identity.Certificate[0])
+	if err != nil || now.Before(leaf.NotBefore) || !now.Before(leaf.NotAfter) {
+		return tls.Certificate{}, errTLSIdentity
+	}
+	identity.Leaf = leaf
+	return identity, nil
+}
