+package lokigateway
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+const testSession = "1234567890abcdef1234567890abcdef"
+
+func TestAuthHelperProcess(t *testing.T) {
+	if len(os.Args) < 3 || os.Args[len(os.Args)-2] != "loki-auth-test-helper" {
+		return
+	}
+	mode := os.Args[len(os.Args)-1]
+	input, err := io.ReadAll(io.LimitReader(os.Stdin, 35))
+	if err != nil || string(input) != testSession+" "+os.Args[len(os.Args)-4] {
+		os.Exit(7)
+	}
+	if strings.Contains(strings.Join(os.Args, " "), testSession) ||
+		strings.Contains(strings.Join(os.Environ(), " "), testSession) || os.Getenv("LOKI_AUTH_PRIVATE_CANARY") != "" {
+		os.Exit(8)
+	}
+	if err := os.WriteFile(os.Args[len(os.Args)-3], []byte("started"), 0o600); err != nil {
+		os.Exit(10)
+	}
+	switch mode {
+	case "allow":
+		io.WriteString(os.Stdout, "1")
+		os.Exit(0)
+	case "deny":
+		io.WriteString(os.Stdout, "0")
+		os.Exit(1)
+	case "ambiguous":
+		io.WriteString(os.Stdout, "1\n")
+		os.Exit(0)
+	case "wrong-status":
+		io.WriteString(os.Stdout, "1")
+		os.Exit(2)
+	case "private":
+		io.WriteString(os.Stdout, testSession)
+		io.WriteString(os.Stderr, testSession)
+		os.Exit(0)
+	case "wait":
+		time.Sleep(10 * time.Second)
+	}
+	os.Exit(9)
+}
+
+func authorizerForTest(t *testing.T, mode string, write bool) (*sessionAuthorizer, string) {
+	t.Helper()
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := newSessionAuthorizer()
+	directory := t.TempDir()
+	var sequence atomic.Uint32
+	role := "r"
+	if write {
+		role = "w"
+	}
+	result.command = func(ctx context.Context) *exec.Cmd {
+		return exec.CommandContext(ctx, executable, "-test.run=^TestAuthHelperProcess$", role, filepath.Join(directory, strconv.Itoa(int(sequence.Add(1)))), "loki-auth-test-helper", mode)
+	}
+	return result, directory
+}
+
+func TestInvalidSessionsNeverStartAHelper(t *testing.T) {
+	instance := newSessionAuthorizer()
+	instance.command = func(context.Context) *exec.Cmd { t.Fatal("unexpected helper"); return nil }
+	for _, session := range []string{"", "0", strings.Repeat("0", 32), testSession + "\n", strings.ToUpper(testSession), strings.Repeat("g", 32)} {
+		allowed, err := instance.allowed(context.Background(), session, false)
+		if allowed || err != nil {
+			t.Fatalf("invalid credential accepted: %v %v", allowed, err)
+		}
+	}
+}
+
+func TestLiveReadAndWriteResultsKeepCredentialsOffArgumentsAndEnvironment(t *testing.T) {
+	t.Setenv("LOKI_AUTH_PRIVATE_CANARY", testSession)
+	for _, write := range []bool{false, true} {
+		for _, mode := range []string{"allow", "deny"} {
+			instance, _ := authorizerForTest(t, mode, write)
+			allowed, err := instance.allowed(context.Background(), testSession, write)
+			if allowed != (mode == "allow") || err != nil {
+				t.Fatalf("unexpected %s result: %v %v", mode, allowed, err)
+			}
+		}
+	}
+}
+
+func TestMalformedOutputAndExitStatusNeverAuthorize(t *testing.T) {
+	for _, mode := range []string{"ambiguous", "wrong-status", "private", "unknown"} {
+		instance, _ := authorizerForTest(t, mode, false)
+		allowed, err := instance.allowed(context.Background(), testSession, false)
+		if allowed || !errors.Is(err, errAuthUnavailable) {
+			t.Fatalf("unexpected %s result", mode)
+		}
+		if strings.Contains(err.Error(), testSession) {
+			t.Fatal("credential disclosed")
+		}
+	}
+}
+
+func waitForHelpers(t *testing.T, directory string, count int) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		files, err := os.ReadDir(directory)
+		if err == nil && len(files) == count {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("owned helpers did not prove startup")
+}
+
+func TestCancellationEndsTheOwnedHelperAndReleasesItsSlot(t *testing.T) {
+	instance, directory := authorizerForTest(t, "wait", false)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		allowed, err := instance.allowed(ctx, testSession, false)
+		if allowed {
+			done <- errors.New("canceled request authorized")
+			return
+		}
+		done <- err
+	}()
+	waitForHelpers(t, directory, 1)
+	start := time.Now()
+	cancel()
+	if err := <-done; !errors.Is(err, errAuthUnavailable) {
+		t.Fatal("unexpected cancellation result")
+	}
+	if time.Since(start) > time.Second || len(instance.slots) != 0 {
+		t.Fatal("helper or slot was retained")
+	}
+}
+
+func TestSaturationDoesNotStartAnotherHelper(t *testing.T) {
+	instance, directory := authorizerForTest(t, "wait", true)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 4)
+	for i := 0; i < 4; i++ {
+		go func() {
+			allowed, err := instance.allowed(ctx, testSession, true)
+			if allowed {
+				done <- errors.New("waiting helper authorized")
+				return
+			}
+			done <- err
+		}()
+	}
+	waitForHelpers(t, directory, 4)
+	allowed, err := instance.allowed(context.Background(), testSession, true)
+	if allowed || !errors.Is(err, errAuthBusy) {
+		t.Fatal("saturated check accepted")
+	}
+	cancel()
+	for i := 0; i < 4; i++ {
+		if err := <-done; !errors.Is(err, errAuthUnavailable) {
+			t.Fatal("unexpected teardown result")
+		}
+	}
+	if len(instance.slots) != 0 {
+		t.Fatal("slot was retained")
+	}
+}
diff --git a/common/lokigateway/config_linux.go b/common/lokigateway/config_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..55aef5a13129fd8fde6c07d6b631c157105f54b7
--- /dev/null
+++ b/common/lokigateway/config_linux.go
@@ -0,0 +1,223 @@
+// Modified for LoKi on 2026-11-05: read the gateway's private boot state without following links.
+package lokigateway
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"unicode"
+	"unicode/utf8"
+)
+
+const gatewayDirectory = "/tmp/loki"
+const gatewayPort = 9091
+
+var errGatewayConfig = errors.New("private gateway configuration is unsafe, incomplete or unavailable")
+
+type gatewayConfig struct {
+	Listen      []string
+	Hosts       []string
+	LuCIPorts   []int
+	Certificate string
+	Key         string
+}
+
+func canonicalPath(path string) bool {
+	return filepath.IsAbs(path) && path == filepath.Clean(path) && utf8.ValidString(path) && strings.IndexFunc(path, unicode.IsControl) < 0
+}
+
+func statIdentity(info os.FileInfo) (*syscall.Stat_t, bool) {
+	value, ok := info.Sys().(*syscall.Stat_t)
+	return value, ok && value.Uid == uint32(os.Geteuid())
+}
+
+func sameStorageSnapshot(first, last *syscall.Stat_t) bool {
+	return last.Dev == first.Dev && last.Ino == first.Ino && last.Mode == first.Mode && last.Uid == first.Uid &&
+		last.Gid == first.Gid && last.Nlink == first.Nlink && last.Size == first.Size && last.Mtim == first.Mtim && last.Ctim == first.Ctim
+}
+
+func readPrivate(directory, name string, limit int64) ([]byte, error) {
+	if !canonicalPath(directory) || name == "" || filepath.Base(name) != name || name == "." || name == ".." {
+		return nil, errGatewayConfig
+	}
+	before, err := os.Lstat(directory)
+	if err != nil || !before.IsDir() || before.Mode().Perm() != 0o700 {
+		return nil, errGatewayConfig
+	}
+	initial, ok := statIdentity(before)
+	if !ok {
+		return nil, errGatewayConfig
+	}
+	root, err := os.OpenRoot(directory)
+	if err != nil {
+		return nil, errGatewayConfig
+	}
+	defer root.Close()
+	anchored, err := root.Stat(".")
+	if err != nil || !os.SameFile(before, anchored) || anchored.Mode() != before.Mode() {
+		return nil, errGatewayConfig
+	}
+	current, ok := statIdentity(anchored)
+	if !ok || current.Dev != initial.Dev || current.Ino != initial.Ino {
+		return nil, errGatewayConfig
+	}
+	file, err := root.OpenFile(name, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, errGatewayConfig
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0o600 || info.Size() <= 0 || info.Size() > limit {
+		return nil, errGatewayConfig
+	}
+	first, ok := statIdentity(info)
+	if !ok || first.Nlink != 1 {
+		return nil, errGatewayConfig
+	}
+	data, err := io.ReadAll(io.LimitReader(file, limit+1))
+	if err != nil || int64(len(data)) != info.Size() {
+		return nil, errGatewayConfig
+	}
+	lastInfo, err := file.Stat()
+	if err != nil {
+		return nil, errGatewayConfig
+	}
+	last, ok := statIdentity(lastInfo)
+	if !ok || !sameStorageSnapshot(first, last) {
+		return nil, errGatewayConfig
+	}
+	named, err := root.Lstat(name)
+	if err != nil || !named.Mode().IsRegular() || !os.SameFile(info, named) {
+		return nil, errGatewayConfig
+	}
+	return data, nil
+}
+
+func canonicalHost(host string) bool {
+	if address, err := netip.ParseAddr(host); err == nil {
+		return address.Zone() == "" && !address.Is4In6() && !address.IsUnspecified() && !address.IsMulticast() && host == address.String()
+	}
+	if host == "" || len(host) > 253 || strings.Trim(host, "0123456789.") == "" {
+		return false
+	}
+	for _, label := range strings.Split(host, ".") {
+		if label == "" || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, c := range label {
+			if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func decodeGatewayConfig(data []byte) (gatewayConfig, error) {
+	var cfg gatewayConfig
+	if len(data) > 16384 || !utf8.Valid(data) {
+		return cfg, errGatewayConfig
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	start, err := decoder.Token()
+	if err != nil || start != json.Delim('{') {
+		return cfg, errGatewayConfig
+	}
+	seen := make(map[string]bool)
+	for decoder.More() {
+		token, err := decoder.Token()
+		name, ok := token.(string)
+		if err != nil || !ok || seen[name] {
+			return cfg, errGatewayConfig
+		}
+		seen[name] = true
+		switch name {
+		case "format":
+			var format string
+			err = decoder.Decode(&format)
+			if format != "loki-gateway-1" {
+				return cfg, errGatewayConfig
+			}
+		case "listen":
+			err = decoder.Decode(&cfg.Listen)
+		case "hosts":
+			err = decoder.Decode(&cfg.Hosts)
+		case "luci_https_ports":
+			err = decoder.Decode(&cfg.LuCIPorts)
+		case "certificate":
+			err = decoder.Decode(&cfg.Certificate)
+		case "key":
+			err = decoder.Decode(&cfg.Key)
+		default:
+			return cfg, errGatewayConfig
+		}
+		if err != nil {
+			return cfg, errGatewayConfig
+		}
+	}
+	end, err := decoder.Token()
+	if err != nil || end != json.Delim('}') || decoder.Decode(new(any)) != io.EOF || len(seen) != 6 {
+		return cfg, errGatewayConfig
+	}
+	if len(cfg.Listen) == 0 || len(cfg.Listen) > 16 ||
+		len(cfg.Hosts) == 0 || len(cfg.Hosts) > 16 || len(cfg.LuCIPorts) == 0 || len(cfg.LuCIPorts) > 8 ||
+		!canonicalPath(cfg.Certificate) || !canonicalPath(cfg.Key) {
+		return cfg, errGatewayConfig
+	}
+	hosts := make(map[string]bool)
+	for _, host := range cfg.Hosts {
+		if !canonicalHost(host) || hosts[host] {
+			return cfg, errGatewayConfig
+		}
+		hosts[host] = true
+	}
+	listeners := make(map[string]bool)
+	for _, listen := range cfg.Listen {
+		host, port, err := net.SplitHostPort(listen)
+		address, parseErr := netip.ParseAddr(host)
+		if err != nil || parseErr != nil || address.Zone() != "" || address.Is4In6() || address.IsMulticast() ||
+			port != strconv.Itoa(gatewayPort) || net.JoinHostPort(address.String(), port) != listen ||
+			!hosts[address.String()] || listeners[listen] {
+			return cfg, errGatewayConfig
+		}
+		listeners[listen] = true
+	}
+	ports := make(map[int]bool)
+	for _, port := range cfg.LuCIPorts {
+		if port < 1 || port > 65535 || ports[port] {
+			return cfg, errGatewayConfig
+		}
+		ports[port] = true
+	}
+	return cfg, nil
+}
+
+func loadGatewayConfig(directory string) (gatewayConfig, string, error) {
+	var cfg gatewayConfig
+	data, err := readPrivate(directory, "gateway.json", 16384)
+	if err != nil {
+		return cfg, "", err
+	}
+	cfg, err = decodeGatewayConfig(data)
+	if err != nil {
+		return cfg, "", err
+	}
+	key, err := readPrivate(directory, "controller.secret", 64)
+	if err != nil || len(key) != 64 || strings.Trim(string(key), "0") == "" {
+		return cfg, "", errGatewayConfig
+	}
+	for _, c := range key {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return cfg, "", errGatewayConfig
+		}
+	}
+	return cfg, string(key), nil
+}
