+package lokigateway
+
+import (
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func TestOperationPolicySeparatesReadsFromEffects(t *testing.T) {
+	for _, test := range []struct {
+		method, path  string
+		stream, write bool
+	}{
+		{"GET", "/version", false, false}, {"GET", "/configs", false, false},
+		{"GET", "/proxies", false, false}, {"GET", "/group", false, false},
+		{"GET", "/proxies/Office%2FOUT", false, false}, {"GET", "/group/Office%2FOUT", false, false},
+		{"GET", "/proxies/Node%20%231%3FEU%2FOUT", false, false},
+		{"PUT", "/proxies/Node%20%231%3FEU%2FOUT", false, true},
+		{"GET", "/proxies/Node%252FOUT", false, false},
+		{"GET", "/proxies/name%5Cpart", false, false},
+		{"GET", "/providers/proxies/Office%2Fpremium", false, false}, {"GET", "/providers/rules", false, false},
+		{"GET", "/rules", false, false}, {"GET", "/connections", false, false},
+		{"GET", "/connections", true, false}, {"GET", "/traffic", true, false},
+		{"GET", "/connections?interval=1000", true, false},
+		{"GET", "/connections?interval=5000", true, false},
+		{"GET", "/connections?interval=60000", true, false},
+		{"GET", "/memory", true, false}, {"GET", "/logs?level=debug", true, false},
+		{"GET", "/proxies/node/link", false, true},
+		{"GET", "/proxies/node/exit?timeout=5000", false, true},
+		{"GET", "/proxies/node/delay?url=https%3A%2F%2Fexample.test%2F204&timeout=5000", false, true},
+		{"GET", "/group/Office%2FOUT/delay?url=http%3A%2F%2Fexample.test%2F204&timeout=40000", false, true},
+		{"GET", "/providers/proxies/Office%2Fpremium/healthcheck", false, true},
+		{"PUT", "/proxies/Office%2FOUT", false, true}, {"PUT", "/providers/proxies/Office%2Fpremium", false, true},
+		{"PUT", "/providers/rules", false, true}, {"PUT", "/providers/rules/rule1", false, true},
+		{"DELETE", "/connections", false, true}, {"DELETE", "/connections/connection1", false, true},
+	} {
+		t.Run(test.method+test.path, func(t *testing.T) {
+			target, err := url.Parse(apiPrefix + test.path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			result, ok := classify(test.method, target, test.stream)
+			if !ok || result.write != test.write || result.configs != (test.path == "/configs") {
+				t.Fatalf("unexpected policy: %+v %v", result, ok)
+			}
+		})
+	}
+}
+
+func TestOperationPolicyRejectsUnlistedAndAmbiguousRequests(t *testing.T) {
+	for _, test := range []struct {
+		method, path string
+		stream       bool
+	}{
+		{"GET", "/configs?token=secret", false}, {"PATCH", "/configs", false},
+		{"PUT", "/configs", false}, {"PATCH", "/rules/disable", false},
+		{"POST", "/cache/dns/flush", false}, {"POST", "/upgrade/ui", false},
+		{"CONNECT", "/version", false}, {"HEAD", "/version", false},
+		{"GET", "/version/", false}, {"GET", "/proxies//link", false},
+		{"GET", "/proxies/../link", false}, {"GET", "/proxies/%2e%2e/link", false},
+		{"GET", "/providers%5Cproxies/name", false}, {"GET", "/proxies/name%0Apart", false},
+		{"GET", "/%70roxies", false}, {"GET", "/proxies%2Fnode%2Fdelay?url=https://example.test&timeout=5", false},
+		{"GET", "/logs?level=info%7Cwarning", true}, {"GET", "/logs?level=trace", true},
+		{"GET", "/traffic?token=secret", true}, {"GET", "/connections?interval=0", true},
+		{"GET", "/connections?interval=999", true}, {"GET", "/connections?interval=60001", true},
+		{"GET", "/connections?interval=-1", true}, {"GET", "/connections?interval=05000", true},
+		{"GET", "/connections?interval=1000&interval=5000", true},
+		{"GET", "/connections?interval=1000&token=private", true},
+		{"GET", "/connections?interval=999999999999999999999999999", true},
+		{"GET", "/traffic?interval=5000", true}, {"GET", "/connections?interval=5000", false},
+		{"GET", "/version", true}, {"PUT", "/proxies/node", true},
+		{"GET", "/traffic", false}, {"GET", "/logs", false},
+		{"GET", "/proxies/node/exit?timeout=0", false}, {"GET", "/proxies/node/exit?timeout=60001", false},
+		{"GET", "/proxies/node/exit?timeout=05000", false}, {"GET", "/proxies/node/exit?timeout=5&timeout=6", false},
+		{"GET", "/proxies/node/delay?url=file:///etc/passwd&timeout=5", false},
+		{"GET", "/proxies/node/delay?url=https://user:password@example.test&timeout=5", false},
+		{"GET", "/proxies/node/delay?url=https://example.test%23fragment&timeout=5", false},
+		{"GET", "/proxies/node/delay?url=https://example.test&timeout=5&extra=1", false},
+		{"GET", "/proxies/node/delay?url=https://example.test&timeout=5;extra=1", false},
+		{"GET", "/version?", false}, {"GET", "/version#fragment", false},
+		{"GET", "/proxies/" + strings.Repeat("a", 1025), false},
+	} {
+		t.Run(test.method+test.path, func(t *testing.T) {
+			target, err := url.Parse(apiPrefix + test.path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result, ok := classify(test.method, target, test.stream); ok {
+				t.Fatalf("unlisted operation allowed: %+v", result)
+			}
+		})
+	}
+	for _, raw := range []string{"https://attacker.test" + apiPrefix + "/version", "//attacker.test" + apiPrefix + "/version", "/version", apiPrefix + "/" + strings.Repeat("a", 4096)} {
+		target, err := url.Parse(raw)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := classify("GET", target, false); ok {
+			t.Fatal("external or oversized target allowed")
+		}
+	}
+}
diff --git a/common/lokigateway/server_linux.go b/common/lokigateway/server_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..b8e615d5e5cc256e0967a576bd5284ce13e88da5
--- /dev/null
+++ b/common/lokigateway/server_linux.go
@@ -0,0 +1,144 @@
+// Modified for LoKi on 2026-11-05: serve a separate HTTPS gateway without starting routing.
+package lokigateway
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+var errGatewayListener = errors.New("gateway HTTPS listener unavailable; check its address and port conflict")
+
+func httpsOrigin(host string, port int) string {
+	authority := net.JoinHostPort(host, strconv.Itoa(port))
+	if port == 443 {
+		authority = strings.TrimSuffix(authority, ":443")
+	}
+	return "https://" + authority
+}
+
+func configuredGateway(ctx context.Context, cfg gatewayConfig, secret string) *gateway {
+	origins := make(map[string]map[string]bool)
+	for _, host := range cfg.Hosts {
+		authority := net.JoinHostPort(host, strconv.Itoa(gatewayPort))
+		allowed := map[string]bool{httpsOrigin(host, gatewayPort): true}
+		for _, port := range cfg.LuCIPorts {
+			allowed[httpsOrigin(host, port)] = true
+		}
+		origins[authority] = allowed
+	}
+	return &gateway{ctx: ctx, origins: origins, secret: secret, authorize: newSessionAuthorizer().allowed,
+		client: controllerClient(), requests: make(chan struct{}, 8), streams: make(chan struct{}, 4), recheckEvery: 5 * time.Second}
+}
+
+type boundedListener struct {
+	net.Listener
+	slots chan struct{}
+	done  chan struct{}
+	once  sync.Once
+	err   error
+}
+
+type boundedConn struct {
+	net.Conn
+	once    sync.Once
+	release func()
+	err     error
+}
+
+func (c *boundedConn) Close() error {
+	c.once.Do(func() { c.err = c.Conn.Close(); c.release() })
+	return c.err
+}
+
+func (l *boundedListener) Accept() (net.Conn, error) {
+	select {
+	case l.slots <- struct{}{}:
+	case <-l.done:
+		return nil, net.ErrClosed
+	}
+	connection, err := l.Listener.Accept()
+	if err != nil {
+		<-l.slots
+		return nil, err
+	}
+	return &boundedConn{Conn: connection, release: func() { <-l.slots }}, nil
+}
+
+func (l *boundedListener) Close() error {
+	l.once.Do(func() { close(l.done); l.err = l.Listener.Close() })
+	return l.err
+}
+
+func serveGateway(parent context.Context, g *gateway, identity tls.Certificate, listeners ...net.Listener) error {
+	if len(listeners) == 0 {
+		return errGatewayListener
+	}
+	ctx, cancel := context.WithCancel(parent)
+	defer cancel()
+	g.ctx = ctx
+	slots := make(chan struct{}, 32)
+	server := &http.Server{Handler: g, BaseContext: func(net.Listener) context.Context { return ctx },
+		TLSConfig:         &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{identity}, NextProtos: []string{"http/1.1"}},
+		TLSNextProto:      map[string]func(*http.Server, *tls.Conn, http.Handler){},
+		ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 70 * time.Second, WriteTimeout: 70 * time.Second,
+		IdleTimeout: 30 * time.Second, MaxHeaderBytes: 16384, ErrorLog: log.New(io.Discard, "", 0)}
+	stopped := make(chan struct{})
+	go func() {
+		defer close(stopped)
+		<-ctx.Done()
+		g.stopRequests()
+		shutdown, stop := context.WithTimeout(context.Background(), 5*time.Second)
+		defer stop()
+		server.Shutdown(shutdown)
+		server.Close()
+		g.handlers.Wait()
+	}()
+	results := make(chan error, len(listeners))
+	for _, listener := range listeners {
+		bounded := &boundedListener{Listener: listener, slots: slots, done: make(chan struct{})}
+		go func() { results <- server.ServeTLS(bounded, "", "") }()
+	}
+	err := <-results
+	cancel()
+	<-stopped
+	for remaining := len(listeners) - 1; remaining > 0; remaining-- {
+		if next := <-results; next != nil && !errors.Is(next, http.ErrServerClosed) {
+			err = next
+		}
+	}
+	g.client.CloseIdleConnections()
+	if err != nil && !errors.Is(err, http.ErrServerClosed) {
+		return errGatewayListener
+	}
+	return nil
+}
+
+func Run(ctx context.Context) error {
+	cfg, secret, err := loadGatewayConfig(gatewayDirectory)
+	if err != nil {
+		return err
+	}
+	identity, err := existingIdentity(cfg)
+	if err != nil {
+		return err
+	}
+	listeners := make([]net.Listener, 0, len(cfg.Listen))
+	for _, address := range cfg.Listen {
+		listener, err := net.Listen("tcp", address)
+		if err != nil {
+			return errGatewayListener
+		}
+		defer listener.Close()
+		listeners = append(listeners, listener)
+	}
+	return serveGateway(ctx, configuredGateway(ctx, cfg, secret), identity, listeners...)
+}
