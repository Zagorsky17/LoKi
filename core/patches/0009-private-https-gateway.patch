+			if e != nil {
+				t.Fatal(e)
+			}
+			return v
+		}(), "PRIVATE KEY"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var public any
+			switch key := test.key.(type) {
+			case *rsa.PrivateKey:
+				public = &key.PublicKey
+			case *ecdsa.PrivateKey:
+				public = &key.PublicKey
+			case ed25519.PrivateKey:
+				public = key.Public()
+			}
+			certificate, err := x509.CreateCertificate(rand.Reader, template, template, public, test.key)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, asPEM := range []bool{false, true} {
+				certInput, keyInput := certificate, test.der
+				if asPEM {
+					certInput = pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate})
+					keyInput = pem.EncodeToMemory(&pem.Block{Type: test.kind, Bytes: test.der})
+				}
+				certBefore, keyBefore := bytes.Clone(certInput), bytes.Clone(keyInput)
+				identity, err := tlsIdentity(certInput, keyInput, now)
+				if err != nil || identity.PrivateKey == nil || identity.Leaf == nil || !bytes.Equal(identity.Certificate[0], certificate) {
+					t.Fatal("valid existing HTTPS identity refused")
+				}
+				if !bytes.Equal(certInput, certBefore) || !bytes.Equal(keyInput, keyBefore) {
+					t.Fatal("shared certificate input changed")
+				}
+				if !asPEM {
+					server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+					server.TLS = &tls.Config{Certificates: []tls.Certificate{identity}, MinVersion: tls.VersionTLS12}
+					server.StartTLS()
+					roots := x509.NewCertPool()
+					roots.AddCert(identity.Leaf)
+					transport := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots, ServerName: "router.example", MinVersion: tls.VersionTLS12, Time: func() time.Time { return now }}}
+					client := &http.Client{Transport: transport, Timeout: time.Second}
+					response, err := client.Get(server.URL)
+					if err != nil {
+						server.Close()
+						t.Fatalf("DER identity failed real TLS handshake: %v", err)
+					}
+					response.Body.Close()
+					transport.CloseIdleConnections()
+					server.Close()
+					if response.StatusCode != 204 {
+						t.Fatal("DER identity did not serve HTTPS")
+					}
+				}
+				if asPEM {
+					for _, bad := range []struct{ cert, key []byte }{
+						{append(bytes.Clone(certInput), []byte("unexpected trailer")...), keyInput},
+						{certInput, append(bytes.Clone(keyInput), []byte("unexpected trailer")...)},
+						{certInput, append(bytes.Clone(keyInput), keyInput...)},
+					} {
+						if _, err := tlsIdentity(bad.cert, bad.key, now); !errors.Is(err, errTLSIdentity) {
+							t.Fatal("ambiguous PEM identity accepted")
+						}
+					}
+				}
+			}
+			for _, when := range []time.Time{now.Add(-2 * time.Hour), now.Add(time.Hour), now.Add(2 * time.Hour)} {
+				if _, err := tlsIdentity(certificate, test.der, when); !errors.Is(err, errTLSIdentity) {
+					t.Fatal("out-of-validity identity accepted")
+				}
+			}
+			for _, bad := range []struct{ cert, key []byte }{
+				{nil, test.der}, {certificate, nil}, {[]byte(testSession), test.der}, {certificate, []byte(testSecret)},
+				{append(bytes.Clone(certificate), 0), test.der}, {certificate, append(bytes.Clone(test.der), 0)},
+				{bytes.Repeat([]byte("x"), 65537), test.der}, {certificate, bytes.Repeat([]byte("x"), 65537)},
+			} {
+				if _, err := tlsIdentity(bad.cert, bad.key, now); !errors.Is(err, errTLSIdentity) {
+					t.Fatal("malformed identity accepted")
+				}
+			}
+		})
+	}
+}
+
+func TestHTTPSIdentityRejectsAMismatchedKey(t *testing.T) {
+	now := time.Now()
+	_, key, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, other, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(2), NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour)}
+	cert, err := x509.CreateCertificate(rand.Reader, template, template, key.Public(), key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, err := x509.MarshalPKCS8PrivateKey(other)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := tlsIdentity(cert, der, now); !errors.Is(err, errTLSIdentity) {
+		t.Fatal("mismatched key accepted")
+	}
+}
diff --git a/common/lokigateway/transport.go b/common/lokigateway/transport.go
new file mode 100644
index 0000000000000000000000000000000000000000..02272bb5e57bead6988c959f0f69a85eded96f42
--- /dev/null
+++ b/common/lokigateway/transport.go
@@ -0,0 +1,433 @@
+// Modified for LoKi on 2026-11-05: keep browser credentials and controller credentials on separate connections.
+package lokigateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"github.com/coder/websocket"
+	"github.com/sagernet/sing-box/common/lokicontroller"
+)
+
+const controllerURL = "http://loki-controller"
+const responseLimit = 4 * 1024 * 1024
+
+type gateway struct {
+	lifecycle    sync.Mutex
+	closed       bool
+	handlers     sync.WaitGroup
+	ctx          context.Context
+	origins      map[string]map[string]bool
+	secret       string
+	authorize    func(context.Context, string, bool) (bool, error)
+	client       *http.Client
+	requests     chan struct{}
+	streams      chan struct{}
+	recheckEvery time.Duration
+}
+
+func controllerClient() *http.Client {
+	return &http.Client{
+		Transport: &http.Transport{
+			DialContext:     lokicontroller.DialContext,
+			MaxConnsPerHost: 8, MaxIdleConns: 8, IdleConnTimeout: 30 * time.Second,
+			ResponseHeaderTimeout: 65 * time.Second, MaxResponseHeaderBytes: 16384,
+			DisableCompression: true,
+			// Active GETs have effects; reused connections permit automatic net/http replay.
+			DisableKeepAlives: true,
+		},
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+}
+
+func failure(w http.ResponseWriter, status int) {
+	http.Error(w, http.StatusText(status), status)
+}
+
+func sessionCookie(r *http.Request) string {
+	var session string
+	for _, line := range r.Header.Values("Cookie") {
+		for _, part := range strings.Split(line, ";") {
+			name, value, ok := strings.Cut(strings.TrimSpace(part), "=")
+			if name != "sysauth_https" {
+				continue
+			}
+			if !ok || session != "" || !validSession(value) {
+				return ""
+			}
+			session = value
+		}
+	}
+	return session
+}
+
+func (g *gateway) origin(r *http.Request) (string, bool) {
+	values := r.Header.Values("Origin")
+	allowed := g.origins[r.Host]
+	if r.TLS == nil || allowed == nil || len(values) > 1 {
+		return "", false
+	}
+	// Same-origin browser GETs need not send Origin; require independent browser source evidence.
+	if len(values) == 0 && r.Method == http.MethodGet && len(r.Header.Values("Upgrade")) == 0 {
+		metadata, references := r.Header.Values("Sec-Fetch-Site"), r.Header.Values("Referer")
+		if len(metadata) > 1 || len(references) > 1 || len(metadata) == 1 && metadata[0] != "same-origin" {
+			return "", false
+		}
+		if len(references) == 1 {
+			reference, err := url.Parse(references[0])
+			if err != nil || reference.Scheme != "https" || reference.Host != r.Host || reference.User != nil || reference.Fragment != "" {
+				return "", false
+			}
+			return "https://" + r.Host, true
+		}
+		return "https://" + r.Host, len(metadata) == 1
+	}
+	if len(values) != 1 {
+		return "", false
+	}
+	value := values[0]
+	return value, allowed[value]
+}
+
+func validWebSocketUpgrade(r *http.Request) bool {
+	if r.ProtoMajor != 1 || r.ProtoMinor != 1 || len(r.Header.Values("Connection")) != 1 ||
+		len(r.Header.Values("Sec-WebSocket-Version")) != 1 || r.Header.Get("Sec-WebSocket-Version") != "13" ||
+		len(r.Header.Values("Sec-WebSocket-Key")) != 1 {
+		return false
+	}
+	key := r.Header.Get("Sec-WebSocket-Key")
+	decoded, err := base64.StdEncoding.DecodeString(key)
+	if err != nil || len(decoded) != 16 || base64.StdEncoding.EncodeToString(decoded) != key {
+		return false
+	}
+	seen := make(map[string]bool)
+	for _, part := range strings.Split(strings.ToLower(r.Header.Get("Connection")), ",") {
+		token := strings.TrimSpace(part)
+		if seen[token] || token != "upgrade" && token != "keep-alive" {
+			return false
+		}
+		seen[token] = true
+	}
+	return seen["upgrade"]
+}
+
+func (g *gateway) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	g.lifecycle.Lock()
+	if g.closed {
+		g.lifecycle.Unlock()
+		failure(w, http.StatusServiceUnavailable)
+		return
+	}
+	g.handlers.Add(1)
+	g.lifecycle.Unlock()
+	defer g.handlers.Done()
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	w.Header().Set("Referrer-Policy", "no-referrer")
+	w.Header().Set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")
+	origin, ok := g.origin(r)
+	if !ok {
+		failure(w, http.StatusForbidden)
+		return
+	}
+	for _, header := range []string{"Authorization", "Proxy-Authorization", "X-HTTP-Method-Override", "X-Method-Override"} {
+		if len(r.Header.Values(header)) != 0 {
+			failure(w, http.StatusBadRequest)
+			return
+		}
+	}
+	w.Header().Set("Access-Control-Allow-Origin", origin)
+	w.Header().Set("Access-Control-Allow-Credentials", "true")
+	w.Header().Set("Vary", "Origin")
+	if r.Method == http.MethodOptions {
+		methods := r.Header.Values("Access-Control-Request-Method")
+		headers := r.Header.Values("Access-Control-Request-Headers")
+		if len(methods) != 1 || len(headers) > 1 {
+			failure(w, http.StatusBadRequest)
+			return
+		}
+		if _, ok := classify(methods[0], r.URL, false); !ok {
+			failure(w, http.StatusForbidden)
+			return
+		}
+		if len(headers) == 1 {
+			for _, header := range strings.Split(strings.ToLower(headers[0]), ",") {
+				if name := strings.TrimSpace(header); name != "x-loki-csrf" && name != "content-type" {
+					failure(w, http.StatusForbidden)
+					return
+				}
+			}
+		}
+		w.Header().Set("Access-Control-Allow-Methods", "GET, PUT, DELETE")
+		w.Header().Set("Access-Control-Allow-Headers", "X-Loki-CSRF, Content-Type")
+		w.WriteHeader(http.StatusNoContent)
+		return
+	}
+	stream := len(r.Header.Values("Upgrade")) != 0
+	if stream && (len(r.Header.Values("Upgrade")) != 1 || !strings.EqualFold(r.Header.Get("Upgrade"), "websocket") ||
+		len(r.Header.Values("Sec-WebSocket-Protocol")) != 0 || !validWebSocketUpgrade(r)) {
+		failure(w, http.StatusBadRequest)
+		return
+	}
+	op, ok := classify(r.Method, r.URL, stream)
+	if !ok {
+		failure(w, http.StatusForbidden)
+		return
+	}
+	if op.write && (len(r.Header.Values("X-Loki-CSRF")) != 1 || r.Header.Get("X-Loki-CSRF") != "1") {
+		failure(w, http.StatusForbidden)
+		return
+	}
+	session := sessionCookie(r)
+	if session == "" {
+		failure(w, http.StatusUnauthorized)
+		return
+	}
+	select {
+	case g.requests <- struct{}{}:
+		defer func() { <-g.requests }()
+	default:
+		failure(w, http.StatusServiceUnavailable)
+		return
+	}
+	allowed, err := g.authorize(r.Context(), session, op.write)
+	if err != nil {
+		failure(w, http.StatusServiceUnavailable)
+		return
+	}
+	if !allowed {
+		failure(w, http.StatusForbidden)
+		return
+	}
+	body, ok := requestBody(r)
+	if !ok {
+		failure(w, http.StatusBadRequest)
+		return
+	}
+	if stream {
+		g.stream(w, r, session)
+		return
+	}
+	g.exchange(w, r, body, op, session)
+}
+
+func (g *gateway) stopRequests() {
+	g.lifecycle.Lock()
+	g.closed = true
+	g.lifecycle.Unlock()
+}
+
+func requestBody(r *http.Request) ([]byte, bool) {
+	if r.ContentLength > 4096 {
+		return nil, false
+	}
+	body, err := io.ReadAll(io.LimitReader(r.Body, 4097))
+	if err != nil || len(body) > 4096 || !utf8.Valid(body) {
+		return nil, false
+	}
+	path := strings.TrimPrefix(r.URL.EscapedPath(), apiPrefix)
+	if r.Method != http.MethodPut || !strings.HasPrefix(path, "/proxies/") {
+		return nil, len(body) == 0
+	}
+	contentType, parameters, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || contentType != "application/json" || len(parameters) > 1 ||
+		len(parameters) == 1 && !strings.EqualFold(parameters["charset"], "utf-8") {
+		return nil, false
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	first, err := decoder.Token()
+	if err != nil || first != json.Delim('{') {
+		return nil, false
+	}
+	key, err := decoder.Token()
+	if err != nil || key != "name" {
+		return nil, false
+	}
+	value, err := decoder.Token()
+	name, isString := value.(string)
+	if err != nil || !isString || len(name) > 1024 || name != "" && !safeName(url.PathEscape(name)) {
+		return nil, false
+	}
+	last, err := decoder.Token()
+	if err != nil || last != json.Delim('}') || decoder.Decode(new(any)) != io.EOF {
+		return nil, false
+	}
+	return body, true
+}
+
+func (g *gateway) safePayload(body []byte, session string) bool {
+	if len(body) > responseLimit || !json.Valid(body) {
+		return false
+	}
+	// Decode string tokens so JSON escapes cannot disguise a credential.
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	for {
+		token, err := decoder.Token()
+		if err == io.EOF {
+			return true
+		}
+		if err != nil {
+			return false
+		}
+		if value, ok := token.(string); ok && (strings.Contains(value, g.secret) || strings.Contains(value, session)) {
+			return false
+		}
+	}
+}
+
+func projectConfigs(body []byte) ([]byte, error) {
+	var value struct {
+		Mode     string   `json:"mode"`
+		ModeList []string `json:"mode-list"`
+		LogLevel string   `json:"log-level"`
+	}
+	if err := json.Unmarshal(body, &value); err != nil {
+		return nil, err
+	}
+	for _, mode := range append([]string{value.Mode}, value.ModeList...) {
+		if mode != "rule" && mode != "global" && mode != "direct" {
+			return nil, errors.New("invalid controller mode")
+		}
+	}
+	switch value.LogLevel {
+	case "debug", "info", "warn", "warning", "error", "fatal", "panic", "silent":
+	default:
+		return nil, errors.New("invalid controller log level")
+	}
+	if len(value.ModeList) > 3 {
+		return nil, errors.New("invalid controller mode list")
+	}
+	return json.Marshal(value)
+}
+
+func (g *gateway) exchange(w http.ResponseWriter, r *http.Request, body []byte, op operation, session string) {
+	budget := 5 * time.Second
+	if op.write {
+		budget = 65 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), budget)
+	defer cancel()
+	upstream, err := http.NewRequestWithContext(ctx, r.Method, controllerURL+strings.TrimPrefix(r.URL.RequestURI(), apiPrefix), bytes.NewReader(body))
+	if err != nil {
+		failure(w, http.StatusBadGateway)
+		return
+	}
+	upstream.Header.Set("Authorization", "Bearer "+g.secret)
+	if len(body) != 0 {
+		upstream.Header.Set("Content-Type", "application/json")
+	}
+	response, err := g.client.Do(upstream)
+	if err != nil {
+		failure(w, http.StatusServiceUnavailable)
+		return
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK && response.StatusCode != http.StatusNoContent || response.Header.Get("Content-Encoding") != "" {
+		failure(w, http.StatusBadGateway)
+		return
+	}
+	payload, err := io.ReadAll(io.LimitReader(response.Body, responseLimit+1))
+	if err != nil || len(payload) > responseLimit {
+		failure(w, http.StatusBadGateway)
+		return
+	}
+	if response.StatusCode == http.StatusNoContent {
+		if len(payload) != 0 {
+			failure(w, http.StatusBadGateway)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+		return
+	}
+	if op.configs {
+		payload, err = projectConfigs(payload)
+	}
+	if err != nil || !g.safePayload(payload, session) {
+		failure(w, http.StatusBadGateway)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.Write(payload)
+}
+
+func (g *gateway) stream(w http.ResponseWriter, r *http.Request, session string) {
+	select {
+	case g.streams <- struct{}{}:
+		defer func() { <-g.streams }()
+	default:
+		failure(w, http.StatusServiceUnavailable)
+		return
+	}
+	dialCtx, stopDial := context.WithTimeout(r.Context(), 3*time.Second)
+	upstream, _, err := websocket.Dial(dialCtx, controllerURL+strings.TrimPrefix(r.URL.RequestURI(), apiPrefix), &websocket.DialOptions{
+		HTTPClient: g.client, HTTPHeader: http.Header{"Authorization": {"Bearer " + g.secret}},
+	})
+	stopDial()
+	if err != nil {
+		failure(w, http.StatusServiceUnavailable)
+		return
+	}
+	defer upstream.CloseNow()
+	pattern := strings.NewReplacer("[", "\\[", "]", "\\]").Replace(r.Header.Get("Origin"))
+	downstream, err := websocket.Accept(w, r, &websocket.AcceptOptions{OriginPatterns: []string{pattern}})
+	if err != nil {
+		return
+	}
+	defer downstream.CloseNow()
+	upstream.SetReadLimit(responseLimit)
+	downstream.SetReadLimit(1024)
+	ctx, cancel := context.WithTimeout(g.ctx, 30*time.Minute)
+	var workers sync.WaitGroup
+	workers.Add(2)
+	defer func() { cancel(); downstream.CloseNow(); upstream.CloseNow(); workers.Wait() }()
+	done := make(chan struct{}, 2)
+	go func() {
+		defer workers.Done()
+		defer func() { done <- struct{}{} }()
+		for {
+			kind, data, err := upstream.Read(ctx)
+			if err != nil || kind != websocket.MessageText || !g.safePayload(data, session) {
+				return
+			}
+			writeCtx, stop := context.WithTimeout(ctx, 5*time.Second)
+			err = downstream.Write(writeCtx, kind, data)
+			stop()
+			if err != nil {
+				return
+			}
+		}
+	}()
+	go func() {
+		defer workers.Done()
+		defer func() { done <- struct{}{} }()
+		// Streams carry server events only; a client data frame ends the connection.
+		downstream.Read(ctx)
+	}()
+	ticker := time.NewTicker(g.recheckEvery)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-done:
+			return
+		case <-ticker.C:
+			allowed, err := g.authorize(ctx, session, false)
+			if err != nil || !allowed {
+				return
+			}
+		}
+	}
+}
diff --git a/common/lokigateway/transport_test.go b/common/lokigateway/transport_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d3da9a4c51533c17c5ad82034ef981d80a9ab797
--- /dev/null
+++ b/common/lokigateway/transport_test.go
@@ -0,0 +1,737 @@
+package lokigateway
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+)
+
+const testSecret = "123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0"
+const testLuCIOrigin = "https://127.0.0.1"
+
+func testGateway(t *testing.T, handler http.HandlerFunc) (*gateway, *httptest.Server) {
+	t.Helper()
+	upstream := httptest.NewServer(handler)
+	t.Cleanup(upstream.Close)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	g := &gateway{
+		ctx: ctx, secret: testSecret, client: controllerClient(),
+		requests: make(chan struct{}, 8), streams: make(chan struct{}, 4), recheckEvery: 20 * time.Millisecond,
+		authorize: func(_ context.Context, session string, _ bool) (bool, error) { return session == testSession, nil },
+	}
+	target, err := url.Parse(upstream.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	transport := g.client.Transport.(*http.Transport)
+	transport.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		if address != "loki-controller:80" {
+			return nil, errors.New("unexpected controller destination")
+		}
+		return (&net.Dialer{Timeout: time.Second}).DialContext(ctx, network, target.Host)
+	}
+	t.Cleanup(transport.CloseIdleConnections)
+	server := httptest.NewUnstartedServer(g)
+	host := server.Listener.Addr().String()
+	g.origins = map[string]map[string]bool{host: {"https://" + host: true, testLuCIOrigin: true}}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return g, server
+}
+
+func gatewayRequest(t *testing.T, server *httptest.Server, method, path, body string) *http.Request {
+	t.Helper()
+	r, err := http.NewRequest(method, server.URL+apiPrefix+path, strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	r.Header.Set("Origin", server.URL)
+	r.Header.Set("Cookie", "other=public; sysauth_https="+testSession)
+	if method == "PUT" {
