+package lokigateway
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+const validGatewayJSON = `{"format":"loki-gateway-1","listen":["127.0.0.1:9091"],"hosts":["router.example","127.0.0.1","fd00::1"],"luci_https_ports":[443,8443],"certificate":"/etc/uhttpd.crt","key":"/etc/uhttpd.key"}`
+
+func privateDirectoryForTest(t *testing.T) string {
+	t.Helper()
+	directory := t.TempDir()
+	if err := os.Chmod(directory, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return directory
+}
+
+func writePrivateForTest(t *testing.T, directory, name string, data []byte) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(directory, name), data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestGatewayConfigBindsThePrivateCredentialWithoutChangingFiles(t *testing.T) {
+	directory := privateDirectoryForTest(t)
+	writePrivateForTest(t, directory, "gateway.json", []byte(validGatewayJSON))
+	writePrivateForTest(t, directory, "controller.secret", []byte(testSecret))
+	configuration, secret, err := loadGatewayConfig(directory)
+	if err != nil || secret != testSecret || len(configuration.Listen) != 1 || configuration.Listen[0] != "127.0.0.1:9091" || len(configuration.Hosts) != 3 || len(configuration.LuCIPorts) != 2 {
+		t.Fatal("valid private configuration refused")
+	}
+	for name, value := range map[string]string{"gateway.json": validGatewayJSON, "controller.secret": testSecret} {
+		data, err := os.ReadFile(filepath.Join(directory, name))
+		if err != nil || string(data) != value {
+			t.Fatal("private input changed")
+		}
+	}
+}
+
+func TestPrivateGatewayInputsRejectLinksPermissionsSpecialFilesAndOversize(t *testing.T) {
+	for _, mode := range []string{"symlink", "hardlink", "fifo", "directory", "public", "oversized", "missing"} {
+		t.Run(mode, func(t *testing.T) {
+			directory := privateDirectoryForTest(t)
+			path := filepath.Join(directory, "gateway.json")
+			switch mode {
+			case "symlink":
+				writePrivateForTest(t, directory, "keep", []byte(validGatewayJSON))
+				if err := os.Symlink("keep", path); err != nil {
+					t.Fatal(err)
+				}
+			case "hardlink":
+				writePrivateForTest(t, directory, "keep", []byte(validGatewayJSON))
+				if err := os.Link(filepath.Join(directory, "keep"), path); err != nil {
+					t.Fatal(err)
+				}
+			case "fifo":
+				if err := syscall.Mkfifo(path, 0o600); err != nil {
+					t.Fatal(err)
+				}
+			case "directory":
+				if err := os.Mkdir(path, 0o700); err != nil {
+					t.Fatal(err)
+				}
+			case "public":
+				writePrivateForTest(t, directory, "gateway.json", []byte(validGatewayJSON))
+				if err := os.Chmod(path, 0o644); err != nil {
+					t.Fatal(err)
+				}
+			case "oversized":
+				writePrivateForTest(t, directory, "gateway.json", bytes.Repeat([]byte("x"), 16385))
+			}
+			start := time.Now()
+			if _, err := readPrivate(directory, "gateway.json", 16384); !errors.Is(err, errGatewayConfig) {
+				t.Fatal("unsafe private input accepted")
+			}
+			if time.Since(start) > time.Second {
+				t.Fatal("special file blocked private reader")
+			}
+			if mode == "symlink" || mode == "hardlink" {
+				data, err := os.ReadFile(filepath.Join(directory, "keep"))
+				if err != nil || string(data) != validGatewayJSON {
+					t.Fatal("unrelated target changed")
+				}
+			}
+		})
+	}
+	directory := privateDirectoryForTest(t)
+	writePrivateForTest(t, directory, "gateway.json", []byte(validGatewayJSON))
+	writePrivateForTest(t, directory, "controller.secret", []byte(testSecret))
+	if err := os.Chmod(directory, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := loadGatewayConfig(directory); !errors.Is(err, errGatewayConfig) {
+		t.Fatal("public parent accepted")
+	}
+	if err := os.Chmod(directory, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	alias := filepath.Join(t.TempDir(), "linked")
+	if err := os.Symlink(directory, alias); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := loadGatewayConfig(alias); !errors.Is(err, errGatewayConfig) {
+		t.Fatal("linked parent accepted")
+	}
+	if _, err := readPrivate(directory, "../gateway.json", 16384); !errors.Is(err, errGatewayConfig) {
+		t.Fatal("traversal accepted")
+	}
+	if _, err := readPrivate(directory+"/.", "gateway.json", 16384); !errors.Is(err, errGatewayConfig) {
+		t.Fatal("noncanonical directory accepted")
+	}
+}
+
+func TestPrivateGatewayCredentialIsMandatoryAndStrict(t *testing.T) {
+	directory := privateDirectoryForTest(t)
+	writePrivateForTest(t, directory, "gateway.json", []byte(validGatewayJSON))
+	for _, value := range []string{"", "short", strings.Repeat("0", 64), strings.ToUpper(testSecret), testSecret + "\n", testSecret + "\x00"} {
+		writePrivateForTest(t, directory, "controller.secret", []byte(value))
+		if _, _, err := loadGatewayConfig(directory); !errors.Is(err, errGatewayConfig) {
+			t.Fatal("invalid controller credential accepted")
+		}
+		data, err := os.ReadFile(filepath.Join(directory, "controller.secret"))
+		if err != nil || string(data) != value {
+			t.Fatal("existing credential repaired")
+		}
+	}
+}
+
+func TestGatewayConfigurationRejectsUnknownDuplicateAndAmbiguousFields(t *testing.T) {
+	for _, raw := range []string{"null", "[]", validGatewayJSON + "{}", strings.Replace(validGatewayJSON, `"format":"loki-gateway-1",`, "", 1), strings.Replace(validGatewayJSON, `"format":`, `"format":"loki-gateway-1","format":`, 1), strings.Replace(validGatewayJSON, `"listen":`, `"listen":["127.0.0.1:9091"],"listen":`, 1),
+		strings.Replace(validGatewayJSON, `"key":`, `"unexpected":true,"key":`, 1), strings.Replace(validGatewayJSON, `"listen"`, `"li\u0073ten"`, 1) + "\x00",
+		`{"listen":null}`, string(bytes.Repeat([]byte("x"), 16385)), strings.Replace(validGatewayJSON, "router.example", "router\xff.example", 1)} {
+		if _, err := decodeGatewayConfig([]byte(raw)); !errors.Is(err, errGatewayConfig) {
+			t.Fatal("ambiguous configuration accepted")
+		}
+	}
+	for name, value := range map[string]any{
+		"format": "unowned", "listen": "http://127.0.0.1:9091", "hosts": []string{"attacker.test:443"}, "luci_https_ports": []int{0}, "certificate": "relative.crt", "key": "/etc/../key",
+	} {
+		var object map[string]any
+		if err := json.Unmarshal([]byte(validGatewayJSON), &object); err != nil {
+			t.Fatal(err)
+		}
+		object[name] = value
+		raw, err := json.Marshal(object)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := decodeGatewayConfig(raw); !errors.Is(err, errGatewayConfig) {
+			t.Fatal("invalid field accepted")
+		}
+	}
+	for _, host := range []string{"", "UPPER.example", "router.example.", "-router.example", "router-.example", "router..example", "127.01.0.1", "2130706433", "0.0.0.0", "::", "ff02::1", "fe80::1%eth0", "[::1]", "user@router.example", "router.example/path", "*", "router\n.example", strings.Repeat("x", 64) + ".example"} {
+		if canonicalHost(host) {
+			t.Fatalf("noncanonical host accepted: %q", host)
+		}
+	}
+	for _, host := range []string{"router.example", "localhost", "127.0.0.1", "fd00::1", "::1", "xn--e1afmkfd.xn--p1ai"} {
+		if !canonicalHost(host) {
+			t.Fatal("canonical host refused")
+		}
+	}
+}
+
+func TestGatewayConfigurationBoundsHostsAndPorts(t *testing.T) {
+	for _, mutate := range []func(map[string]any){
+		func(m map[string]any) { m["hosts"] = []string{} }, func(m map[string]any) { m["hosts"] = []string{"router.example", "router.example"} },
+		func(m map[string]any) {
+			hosts := []string{"127.0.0.1"}
+			for i := 0; i < 16; i++ {
+				hosts = append(hosts, fmt.Sprintf("host%d.example", i))
+			}
+			m["hosts"] = hosts
+		},
+		func(m map[string]any) { m["luci_https_ports"] = []int{} }, func(m map[string]any) { m["luci_https_ports"] = []int{443, 443} },
+		func(m map[string]any) { m["luci_https_ports"] = []int{65536} }, func(m map[string]any) { m["luci_https_ports"] = []int{1, 2, 3, 4, 5, 6, 7, 8, 9} },
+		func(m map[string]any) { m["listen"] = []string{"127.0.0.1:9092"} }, func(m map[string]any) { m["listen"] = []string{"router.example:9091"} },
+		func(m map[string]any) { m["listen"] = []string{"[::ffff:127.0.0.1]:9091"} }, func(m map[string]any) { m["listen"] = []string{"[fe80::1%eth0]:9091"} },
+	} {
+		var object map[string]any
+		json.Unmarshal([]byte(validGatewayJSON), &object)
+		mutate(object)
+		raw, err := json.Marshal(object)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := decodeGatewayConfig(raw); !errors.Is(err, errGatewayConfig) {
+			t.Fatal("configuration resource or bind limit bypassed")
+		}
+	}
+}
+
+func TestGatewayConfigurationRequiresAnAdvertisedConcreteBind(t *testing.T) {
+	for _, listen := range []string{"0.0.0.0:9091", "[::]:9091", "198.51.100.99:9091", "[fd00::99]:9091"} {
+		raw := strings.Replace(validGatewayJSON, `"listen":["127.0.0.1:9091"]`, `"listen":["`+listen+`"]`, 1)
+		if _, err := decodeGatewayConfig([]byte(raw)); !errors.Is(err, errGatewayConfig) {
+			t.Fatalf("gateway accepted an unadvertised or wildcard bind: %s", listen)
+		}
+	}
+	for _, listen := range []string{"127.0.0.1:9091", "[fd00::1]:9091"} {
+		raw := strings.Replace(validGatewayJSON, `"listen":["127.0.0.1:9091"]`, `"listen":["`+listen+`"]`, 1)
+		if _, err := decodeGatewayConfig([]byte(raw)); err != nil {
+			t.Fatalf("advertised concrete bind refused: %s", listen)
+		}
+	}
+}
+
+func TestGatewayConfigurationBindsEveryExplicitLANAddress(t *testing.T) {
+	var object map[string]any
+	if err := json.Unmarshal([]byte(validGatewayJSON), &object); err != nil {
+		t.Fatal(err)
+	}
+	object["listen"] = []string{"127.0.0.1:9091", "[fd00::1]:9091"}
+	raw, err := json.Marshal(object)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := decodeGatewayConfig(raw)
+	if err != nil {
+		t.Fatal("gateway refused simultaneous IPv4 and IPv6 LAN binds", err)
+	}
+	encoded, err := json.Marshal(cfg.Listen)
+	if err != nil || string(encoded) != `["127.0.0.1:9091","[fd00::1]:9091"]` {
+		t.Fatal("gateway lost a configured LAN bind")
+	}
+	for _, invalid := range []any{nil, []string{}, "127.0.0.1:9091", []string{"127.0.0.1:9091", "127.0.0.1:9091"},
+		[]string{"127.0.0.1:9091", "[::]:9091"}, []string{"127.0.0.1:9091", "[fd00::99]:9091"},
+		[]string{"127.0.0.1:9091", "[fd00::1]:9092"}, []any{"127.0.0.1:9091", nil}} {
+		object["listen"] = invalid
+		raw, err = json.Marshal(object)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := decodeGatewayConfig(raw); !errors.Is(err, errGatewayConfig) {
+			t.Fatal("ambiguous, repeated or unsafe multi-address bind accepted")
+		}
+	}
+}
+
+func TestPrivateReaderNeverReturnsAMixedAtomicReplacement(t *testing.T) {
+	directory := privateDirectoryForTest(t)
+	one, two := bytes.Repeat([]byte("a"), 4096), bytes.Repeat([]byte("b"), 4096)
+	writePrivateForTest(t, directory, "gateway.json", one)
+	stop := make(chan struct{})
+	failures := make(chan error, 1)
+	var worker sync.WaitGroup
+	worker.Add(1)
+	go func() {
+		defer worker.Done()
+		for i := 0; ; i++ {
+			select {
+			case <-stop:
+				return
+			default:
+			}
+			data := one
+			if i%2 != 0 {
+				data = two
+			}
+			if err := os.WriteFile(filepath.Join(directory, "new"), data, 0o600); err != nil {
+				failures <- err
+				return
+			}
+			if err := os.Rename(filepath.Join(directory, "new"), filepath.Join(directory, "gateway.json")); err != nil {
+				failures <- err
+				return
+			}
+		}
+	}()
+	for i := 0; i < 100; i++ {
+		data, err := readPrivate(directory, "gateway.json", 16384)
+		if err == nil && !bytes.Equal(data, one) && !bytes.Equal(data, two) {
+			close(stop)
+			worker.Wait()
+			t.Fatal("mixed file accepted")
+		}
+	}
+	close(stop)
+	worker.Wait()
+	select {
+	case err := <-failures:
+		t.Fatal(err)
+	default:
+	}
+}
diff --git a/common/lokigateway/identity_file_linux.go b/common/lokigateway/identity_file_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..d4981dc88eddb3147b6d91d1ec7884f476702bcd
--- /dev/null
+++ b/common/lokigateway/identity_file_linux.go
@@ -0,0 +1,66 @@
+// Modified for LoKi on 2026-11-05: inspect existing HTTPS files without modifying shared state.
+package lokigateway
+
+import (
+	"crypto/tls"
+	"io"
+	"os"
+	"strings"
+	"syscall"
+	"time"
+)
+
+func readIdentityFile(path string, private bool) ([]byte, error) {
+	if !canonicalPath(path) {
+		return nil, errTLSIdentity
+	}
+	root, err := os.OpenRoot("/")
+	if err != nil {
+		return nil, errTLSIdentity
+	}
+	defer root.Close()
+	name := strings.TrimPrefix(path, "/")
+	file, err := root.OpenFile(name, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, errTLSIdentity
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > 65536 || info.Mode().Perm()&0o022 != 0 ||
+		private && info.Mode().Perm()&0o077 != 0 {
+		return nil, errTLSIdentity
+	}
+	first, ok := statIdentity(info)
+	if !ok || first.Nlink != 1 {
+		return nil, errTLSIdentity
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 65537))
+	if err != nil || int64(len(data)) != info.Size() {
+		return nil, errTLSIdentity
+	}
+	after, err := file.Stat()
+	if err != nil {
+		return nil, errTLSIdentity
+	}
+	last, ok := statIdentity(after)
+	if !ok || !sameStorageSnapshot(first, last) {
+		return nil, errTLSIdentity
+	}
+	named, err := root.Lstat(name)
+	if err != nil || !named.Mode().IsRegular() || !os.SameFile(info, named) {
+		return nil, errTLSIdentity
+	}
+	return data, nil
+}
+
+func existingIdentity(cfg gatewayConfig) (tls.Certificate, error) {
+	certificate, err := readIdentityFile(cfg.Certificate, false)
+	if err != nil {
+		return tls.Certificate{}, errTLSIdentity
+	}
+	key, err := readIdentityFile(cfg.Key, true)
+	if err != nil {
+		return tls.Certificate{}, errTLSIdentity
+	}
+	return tlsIdentity(certificate, key, time.Now())
+}
diff --git a/common/lokigateway/policy.go b/common/lokigateway/policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..198fedc21a734b2976e6823650ae23b935ac49fc
--- /dev/null
+++ b/common/lokigateway/policy.go
@@ -0,0 +1,149 @@
+// Modified for LoKi on 2026-11-05: expose only the controller operations used by LoKi and YACD.
+package lokigateway
+
+import (
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+const apiPrefix = "/cgi-bin/luci/loki-gateway/api"
+
+type operation struct {
+	write   bool
+	configs bool
+}
+
+func safeName(raw string) bool {
+	name, err := url.PathUnescape(raw)
+	if err != nil || name == "" || name == "." || name == ".." || len(name) > 1024 || !utf8.ValidString(name) {
+		return false
+	}
+	return strings.IndexFunc(name, unicode.IsControl) < 0
+}
+
+func exactQuery(values url.Values, keys ...string) bool {
+	if len(values) != len(keys) {
+		return false
+	}
+	for _, key := range keys {
+		if len(values[key]) != 1 || values[key][0] == "" {
+			return false
+		}
+	}
+	return true
+}
+
+func probeQuery(values url.Values, exit bool) bool {
+	if exit {
+		if !exactQuery(values, "timeout") {
+			return false
+		}
+	} else {
+		if !exactQuery(values, "url", "timeout") {
+			return false
+		}
+		value := values.Get("url")
+		target, err := url.Parse(value)
+		if err != nil || len(value) > 2048 || target.User != nil || target.Host == "" ||
+			target.Fragment != "" || (target.Scheme != "http" && target.Scheme != "https") ||
+			strings.IndexFunc(value, unicode.IsControl) >= 0 {
+			return false
+		}
+	}
+	text := values.Get("timeout")
+	value, err := strconv.Atoi(text)
+	return err == nil && value >= 1 && value <= 60000 && strconv.Itoa(value) == text
+}
+
+func classify(method string, target *url.URL, stream bool) (operation, bool) {
+	var result operation
+	path := target.EscapedPath()
+	if target.IsAbs() || target.Host != "" || target.Fragment != "" || target.ForceQuery ||
+		len(path)+len(target.RawQuery) > 4096 || !strings.HasPrefix(path, apiPrefix+"/") {
+		return result, false
+	}
+	path = strings.TrimPrefix(path, apiPrefix)
+	parts := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	for _, part := range parts {
+		if !safeName(part) {
+			return result, false
+		}
+	}
+	query, err := url.ParseQuery(target.RawQuery)
+	if err != nil {
+		return result, false
+	}
+	if stream {
+		if method != http.MethodGet {
+			return result, false
+		}
+		switch path {
+		case "/traffic", "/memory":
+			return result, len(query) == 0
+		case "/connections":
+			if len(query) == 0 {
+				return result, true
+			}
+			if !exactQuery(query, "interval") {
+				return result, false
+			}
+			interval, err := strconv.Atoi(query.Get("interval"))
+			return result, err == nil && interval >= 1000 && interval <= 60000 && strconv.Itoa(interval) == query.Get("interval")
+		case "/logs":
+			if len(query) == 0 {
+				return result, true
+			}
+			if exactQuery(query, "level") {
+				switch query.Get("level") {
+				case "debug", "info", "warning", "error", "silent":
+					return result, true
+				}
+			}
+			return result, false
+		default:
+			return result, false
+		}
+	}
+	if method == http.MethodGet {
+		if len(query) == 0 {
+			switch path {
+			case "/configs":
+				result.configs = true
+				return result, true
+			case "/version", "/proxies", "/group", "/providers/proxies", "/providers/rules", "/rules", "/connections":
+				return result, true
+			}
+			if len(parts) == 2 && (parts[0] == "proxies" || parts[0] == "group") ||
+				len(parts) == 3 && parts[0] == "providers" && (parts[1] == "proxies" || parts[1] == "rules") {
+				return result, true
+			}
+			if len(parts) == 3 && parts[0] == "proxies" && parts[2] == "link" ||
+				len(parts) == 4 && parts[0] == "providers" && parts[1] == "proxies" && parts[3] == "healthcheck" {
+				result.write = true
+				return result, true
+			}
+		}
+		if len(parts) == 3 && (parts[0] == "proxies" || parts[0] == "group") && parts[2] == "delay" && probeQuery(query, false) ||
+			len(parts) == 3 && parts[0] == "proxies" && parts[2] == "exit" && probeQuery(query, true) {
+			result.write = true
+			return result, true
+		}
+		return result, false
+	}
+	if len(query) != 0 {
+		return result, false
+	}
+	result.write = true
+	if method == http.MethodDelete {
+		return result, path == "/connections" || len(parts) == 2 && parts[0] == "connections"
+	}
+	if method == http.MethodPut {
+		return result, len(parts) == 2 && parts[0] == "proxies" || path == "/providers/rules" ||
+			len(parts) == 3 && parts[0] == "providers" && (parts[1] == "proxies" || parts[1] == "rules")
+	}
+	return result, false
+}
