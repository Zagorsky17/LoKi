diff --git a/common/lokigateway/auth.go b/common/lokigateway/auth.go
new file mode 100644
index 0000000000000000000000000000000000000000..eb8cac971f149a3c478ffcdde6ac48faba2d11e3
--- /dev/null
+++ b/common/lokigateway/auth.go
@@ -0,0 +1,101 @@
+// Modified for LoKi on 2026-11-05: check live RPC permissions without exposing session credentials.
+package lokigateway
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+var (
+	errAuthUnavailable = errors.New("session permission check unavailable")
+	errAuthBusy        = errors.New("session permission check busy")
+)
+
+const authProgram = "/usr/bin/ucode"
+const authScript = `exit(require("service.gateway_auth").main());`
+
+type sessionAuthorizer struct {
+	slots   chan struct{}
+	command func(context.Context) *exec.Cmd
+}
+
+func newSessionAuthorizer() *sessionAuthorizer {
+	return &sessionAuthorizer{
+		slots: make(chan struct{}, 4),
+		command: func(ctx context.Context) *exec.Cmd {
+			return exec.CommandContext(ctx, authProgram, "-L", "/usr/lib/loki", "-e", authScript)
+		},
+	}
+}
+
+func validSession(value string) bool {
+	if len(value) != 32 || value == "00000000000000000000000000000000" {
+		return false
+	}
+	for _, c := range value {
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
+			return false
+		}
+	}
+	return true
+}
+
+type authReply struct {
+	value byte
+	size  int
+}
+
+func (reply *authReply) Write(data []byte) (int, error) {
+	if reply.size+len(data) > 1 {
+		return 0, errAuthUnavailable
+	}
+	if len(data) != 0 {
+		reply.value = data[0]
+		reply.size++
+	}
+	return len(data), nil
+}
+
+func (authorizer *sessionAuthorizer) allowed(parent context.Context, session string, write bool) (bool, error) {
+	if !validSession(session) {
+		return false, nil
+	}
+	select {
+	case authorizer.slots <- struct{}{}:
+		defer func() { <-authorizer.slots }()
+	default:
+		return false, errAuthBusy
+	}
+	ctx, cancel := context.WithTimeout(parent, 1500*time.Millisecond)
+	defer cancel()
+	command := authorizer.command(ctx)
+	command.Dir = "/"
+	command.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", "LANG=C", "LC_ALL=C"}
+	role := "r"
+	if write {
+		role = "w"
+	}
+	command.Stdin = strings.NewReader(session + " " + role)
+	var reply authReply
+	command.Stdout = &reply
+	command.Stderr = io.Discard
+	command.WaitDelay = 250 * time.Millisecond
+	err := command.Run()
+	if reply.size != 1 {
+		return false, errAuthUnavailable
+	}
+	if reply.value == '1' && err == nil {
+		return true, nil
+	}
+	if reply.value == '0' {
+		var exit *exec.ExitError
+		if errors.As(err, &exit) && exit.ExitCode() == 1 {
+			return false, nil
+		}
+	}
+	return false, errAuthUnavailable
+}
diff --git a/common/lokigateway/auth_test.go b/common/lokigateway/auth_test.go
