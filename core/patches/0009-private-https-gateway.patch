+package lokicontroller
+
+import "errors"
+
+const Path = "/tmp/loki/controller.sock"
+const Address = "loki-controller:80"
+
+var errPrivateController = errors.New("private LoKi controller is unsafe or unavailable")
diff --git a/common/lokicontroller/controller_linux.go b/common/lokicontroller/controller_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..e0300e2a8c1e97ed6085abaa4c6985dd48cf8610
--- /dev/null
+++ b/common/lokicontroller/controller_linux.go
@@ -0,0 +1,256 @@
+package lokicontroller
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+func privateDirectory(directory string, uid uint32, create bool) error {
+	if !filepath.IsAbs(directory) || filepath.Clean(directory) != directory {
+		return errPrivateController
+	}
+	current := "/"
+	for _, part := range strings.Split(strings.TrimPrefix(directory, "/"), "/") {
+		current = filepath.Join(current, part)
+		info, err := os.Lstat(current)
+		if errors.Is(err, os.ErrNotExist) && create && current == directory {
+			if err = os.Mkdir(current, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
+				return errPrivateController
+			}
+			info, err = os.Lstat(current)
+		}
+		if err != nil || !info.IsDir() {
+			return errPrivateController
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok || stat.Uid != 0 && stat.Uid != uid ||
+			info.Mode().Perm()&0o022 != 0 && !(stat.Uid == 0 && info.Mode()&os.ModeSticky != 0) ||
+			current == directory && (stat.Uid != uid || info.Mode().Perm() != 0o700) {
+			return errPrivateController
+		}
+	}
+	return nil
+}
+
+func privateFile(file *os.File, uid uint32, limit int64) (os.FileInfo, error) {
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0o600 || info.Size() > limit {
+		return nil, errPrivateController
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uid || stat.Nlink != 1 {
+		return nil, errPrivateController
+	}
+	return info, nil
+}
+
+func socketInfo(path string, uid uint32) (os.FileInfo, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || info.Mode()&os.ModeSocket == 0 || info.Mode().Perm() != 0o600 || stat.Uid != uid || stat.Nlink != 1 {
+		return nil, errPrivateController
+	}
+	return info, nil
+}
+
+func peerOwner(connection *net.UnixConn, uid uint32) error {
+	raw, err := connection.SyscallConn()
+	if err != nil {
+		return errPrivateController
+	}
+	var credential *syscall.Ucred
+	var inspectErr error
+	err = raw.Control(func(fd uintptr) {
+		credential, inspectErr = syscall.GetsockoptUcred(int(fd), syscall.SOL_SOCKET, syscall.SO_PEERCRED)
+	})
+	if err != nil || inspectErr != nil || credential == nil || credential.Uid != uid || credential.Pid <= 0 {
+		return errPrivateController
+	}
+	return nil
+}
+
+func dial(ctx context.Context, path string, uid uint32) (net.Conn, error) {
+	directory := filepath.Dir(path)
+	if privateDirectory(directory, uid, false) != nil {
+		return nil, errPrivateController
+	}
+	before, err := socketInfo(path, uid)
+	if err != nil {
+		return nil, errPrivateController
+	}
+	connection, err := (&net.Dialer{Timeout: 2 * time.Second}).DialContext(ctx, "unix", path)
+	if err != nil {
+		return nil, errPrivateController
+	}
+	after, err := socketInfo(path, uid)
+	if err != nil || !os.SameFile(before, after) || privateDirectory(directory, uid, false) != nil ||
+		peerOwner(connection.(*net.UnixConn), uid) != nil {
+		connection.Close()
+		return nil, errPrivateController
+	}
+	return connection, nil
+}
+
+func DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	if os.Geteuid() != 0 || network != "tcp" || address != Address {
+		return nil, errPrivateController
+	}
+	return dial(ctx, Path, 0)
+}
+
+func ownerRecord(info os.FileInfo) string {
+	stat := info.Sys().(*syscall.Stat_t)
+	return fmt.Sprintf("loki-controller-1 %d %d\n", stat.Dev, stat.Ino)
+}
+
+func readOwner(path string, uid uint32) (string, error) {
+	file, err := os.OpenFile(path, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if errors.Is(err, os.ErrNotExist) {
+		return "", nil
+	}
+	if err != nil {
+		return "", errPrivateController
+	}
+	defer file.Close()
+	if _, err = privateFile(file, uid, 128); err != nil {
+		return "", err
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 129))
+	var device, inode uint64
+	text := string(data)
+	if _, scanErr := fmt.Sscanf(text, "loki-controller-1 %d %d\n", &device, &inode); err != nil || scanErr != nil ||
+		inode == 0 || text != fmt.Sprintf("loki-controller-1 %d %d\n", device, inode) {
+		return "", errPrivateController
+	}
+	return text, nil
+}
+
+func writeOwner(path, text string) error {
+	file, err := os.CreateTemp(filepath.Dir(path), ".controller-owner-")
+	if err != nil {
+		return errPrivateController
+	}
+	defer os.Remove(file.Name())
+	_, err = io.WriteString(file, text)
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil || closeErr != nil || os.Rename(file.Name(), path) != nil {
+		return errPrivateController
+	}
+	return nil
+}
+
+type privateListener struct {
+	*net.UnixListener
+	lock *os.File
+	path string
+	info os.FileInfo
+	uid  uint32
+	once sync.Once
+	err  error
+}
+
+func (listener *privateListener) Accept() (net.Conn, error) {
+	for {
+		connection, err := listener.AcceptUnix()
+		if err != nil {
+			return nil, err
+		}
+		if peerOwner(connection, listener.uid) == nil {
+			return connection, nil
+		}
+		connection.Close()
+	}
+}
+
+func (listener *privateListener) Close() error {
+	listener.once.Do(func() {
+		listener.err = listener.UnixListener.Close()
+		if current, err := socketInfo(listener.path, listener.uid); err == nil && os.SameFile(listener.info, current) {
+			os.Remove(listener.path)
+		}
+		listener.lock.Close()
+	})
+	return listener.err
+}
+
+func listen(path string, uid uint32) (net.Listener, error) {
+	directory := filepath.Dir(path)
+	if privateDirectory(directory, uid, true) != nil {
+		return nil, errPrivateController
+	}
+	lock, err := os.OpenFile(path+".lock", os.O_RDWR|os.O_CREATE|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0o600)
+	if err != nil {
+		return nil, errPrivateController
+	}
+	failed := true
+	defer func() {
+		if failed {
+			lock.Close()
+		}
+	}()
+	if _, err = privateFile(lock, uid, 0); err != nil || syscall.Flock(int(lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB) != nil {
+		return nil, errPrivateController
+	}
+	owner, err := readOwner(path+".owner", uid)
+	if err != nil {
+		return nil, err
+	}
+	previous, err := socketInfo(path, uid)
+	if err == nil {
+		if owner != ownerRecord(previous) {
+			return nil, errPrivateController
+		}
+		probe, probeErr := net.DialTimeout("unix", path, 250*time.Millisecond)
+		if probeErr == nil {
+			probe.Close()
+			return nil, errPrivateController
+		}
+		current, inspectErr := socketInfo(path, uid)
+		if !errors.Is(probeErr, syscall.ECONNREFUSED) || inspectErr != nil || !os.SameFile(previous, current) || os.Remove(path) != nil {
+			return nil, errPrivateController
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, errPrivateController
+	}
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	if err != nil {
+		return nil, errPrivateController
+	}
+	listener.SetUnlinkOnClose(false)
+	info, err := os.Lstat(path)
+	if err != nil || os.Chmod(path, 0o600) != nil {
+		listener.Close()
+		return nil, errPrivateController
+	}
+	if writeOwner(path+".owner", ownerRecord(info)) != nil {
+		listener.Close()
+		if current, inspectErr := os.Lstat(path); inspectErr == nil && os.SameFile(info, current) {
+			os.Remove(path)
+		}
+		return nil, errPrivateController
+	}
+	failed = false
+	return &privateListener{UnixListener: listener, lock: lock, path: path, info: info, uid: uid}, nil
+}
+
+func Listen() (net.Listener, error) {
+	if os.Geteuid() != 0 {
+		return nil, errPrivateController
+	}
+	return listen(Path, 0)
+}
diff --git a/common/lokicontroller/controller_linux_test.go b/common/lokicontroller/controller_linux_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fbd85706cd8326af01e00e38b7607a61a4bb9a54
--- /dev/null
+++ b/common/lokicontroller/controller_linux_test.go
@@ -0,0 +1,207 @@
+package lokicontroller
+
+import (
+	"context"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func controllerPath(t *testing.T) string {
+	t.Helper()
+	directory, err := os.MkdirTemp("", "loki-ctl-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(directory) })
+	return filepath.Join(directory, "controller.sock")
+}
+
+func TestPrivateControllerLifecycleAndPeerIdentity(t *testing.T) {
+	path := controllerPath(t)
+	uid := uint32(os.Geteuid())
+	listener, err := listen(path, uid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { listener.Close() })
+	if _, err := socketInfo(path, uid); err != nil {
+		t.Fatal("socket is not private")
+	}
+	before, _ := os.Lstat(path)
+	if duplicate, err := listen(path, uid); err == nil {
+		duplicate.Close()
+		t.Fatal("parallel listener replaced the live controller")
+	}
+	after, _ := os.Lstat(path)
+	if !os.SameFile(before, after) {
+		t.Fatal("parallel start changed the endpoint")
+	}
+	done := make(chan error, 1)
+	go func() {
+		connection, err := listener.Accept()
+		if err == nil {
+			defer connection.Close()
+			connection.SetDeadline(time.Now().Add(time.Second))
+			_, err = io.CopyN(connection, connection, 4)
+		}
+		done <- err
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	connection, err := dial(ctx, path, uid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	connection.SetDeadline(time.Now().Add(time.Second))
+	if peerOwner(connection.(*net.UnixConn), uid+1) == nil {
+		t.Fatal("wrong peer UID accepted")
+	}
+	if _, err := connection.Write([]byte("ping")); err != nil {
+		t.Fatal(err)
+	}
+	data := make([]byte, 4)
+	if _, err := io.ReadFull(connection, data); err != nil || string(data) != "ping" {
+		t.Fatal("private exchange failed", err)
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(path); !os.IsNotExist(err) {
+		t.Fatal("closed endpoint remains")
+	}
+	restarted, err := listen(path, uid)
+	if err != nil {
+		t.Fatal("normal restart refused", err)
+	}
+	restarted.Close()
+}
+
+func TestRecordedCrashEndpointCanRecoverButAnUnknownSocketIsPreserved(t *testing.T) {
+	uid := uint32(os.Geteuid())
+	path := controllerPath(t)
+	listener, err := listen(path, uid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A killed process closes descriptors without running the listener's cleanup.
+	dead := listener.(*privateListener)
+	dead.UnixListener.Close()
+	dead.lock.Close()
+	recovered, err := listen(path, uid)
+	if err != nil {
+		t.Fatal("recorded stale endpoint refused", err)
+	}
+	recovered.Close()
+	unknown := controllerPath(t)
+	foreign, err := net.ListenUnix("unix", &net.UnixAddr{Name: unknown, Net: "unix"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	foreign.SetUnlinkOnClose(false)
+	foreign.Close()
+	if err := os.Chmod(unknown, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := os.Lstat(unknown)
+	if candidate, err := listen(unknown, uid); err == nil {
+		candidate.Close()
+		t.Fatal("unknown stale endpoint was removed")
+	}
+	after, err := os.Lstat(unknown)
+	if err != nil || !os.SameFile(before, after) {
+		t.Fatal("unknown endpoint was changed")
+	}
+}
+
+func TestUnsafePrivateControllerStorageAndRecordsAreRefusedWithoutRepair(t *testing.T) {
+	uid := uint32(os.Geteuid())
+	for _, kind := range []string{"directory", "file", "symlink", "fifo", "lock-mode", "lock-link", "lock-content", "owner-invalid", "owner-symlink"} {
+		t.Run(kind, func(t *testing.T) {
+			path := controllerPath(t)
+			var err error
+			switch kind {
+			case "directory":
+				err = os.Chmod(filepath.Dir(path), 0o755)
+			case "file":
+				err = os.WriteFile(path, []byte("user data"), 0o600)
+			case "symlink":
+				err = os.Symlink("unrelated", path)
+			case "fifo":
+				err = syscall.Mkfifo(path, 0o600)
+			case "lock-mode":
+				err = os.WriteFile(path+".lock", nil, 0o644)
+			case "lock-content":
+				err = os.WriteFile(path+".lock", []byte("user data"), 0o600)
+			case "lock-link":
+				err = os.WriteFile(path+".keep", nil, 0o600)
+				if err == nil {
+					err = os.Link(path+".keep", path+".lock")
+				}
+			case "owner-invalid":
+				err = os.WriteFile(path+".owner", []byte("unknown state"), 0o600)
+			case "owner-symlink":
+				err = os.Symlink("unrelated", path+".owner")
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			before, _ := os.Lstat(path)
+			if listener, err := listen(path, uid); err == nil {
+				listener.Close()
+				t.Fatal("unsafe controller storage accepted")
+			}
+			after, afterErr := os.Lstat(path)
+			if before != nil && (afterErr != nil || !os.SameFile(before, after) || before.Mode() != after.Mode()) {
+				t.Fatal("unsafe endpoint was repaired or removed")
+			}
+		})
+	}
+}
+
+func TestPrivateControllerDialRejectsWrongModeAndClosePreservesAReplacement(t *testing.T) {
+	path := controllerPath(t)
+	uid := uint32(os.Geteuid())
+	listener, err := listen(path, uid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	if err := os.Chmod(path, 0o666); err != nil {
+		t.Fatal(err)
+	}
+	if connection, err := dial(context.Background(), path, uid); err == nil {
+		connection.Close()
+		t.Fatal("unsafe endpoint accepted")
+	}
+	if err := os.Chmod(path, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(path, path+".moved"); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("unrelated replacement"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	listener.Close()
+	if data, err := os.ReadFile(path); err != nil || string(data) != "unrelated replacement" {
+		t.Fatal("close removed a replacement")
+	}
+}
+
+func TestPublicControllerDialNeverSelectsAnArbitraryNetworkDestination(t *testing.T) {
+	for _, value := range []struct{ network, address string }{{"udp", Address}, {"tcp", "127.0.0.1:9092"}, {"tcp", "attacker.invalid:443"}} {
+		if connection, err := DialContext(context.Background(), value.network, value.address); err == nil {
+			connection.Close()
+			t.Fatal("arbitrary destination accepted")
+		}
+	}
+}
