+
+	"github.com/go-chi/chi/v5"
+)
+
+func TestEscapedControllerNamesAreDecodedExactlyOnce(t *testing.T) {
+	for _, name := range []string{"Office/OUT", "Node #1?EU", "Node%2FOUT", "Node%20EU", "Node%23EU", "Node%25EU", "Node%broken", "Node%", "Node+EU", "节点/欧洲"} {
+		t.Run(name, func(t *testing.T) {
+			for _, parameter := range []string{"name", "tag"} {
+				router := chi.NewRouter()
+				router.Get("/proxies/{"+parameter+"}", func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(getEscapeParam(r, parameter))) })
+				request := httptest.NewRequest("GET", "http://controller.test/proxies/"+url.PathEscape(name), nil)
+				response := httptest.NewRecorder()
+				router.ServeHTTP(response, request)
+				if response.Code != 200 || response.Body.String() != name {
+					t.Fatalf("controller name changed after routing: %q => %q", name, response.Body.String())
+				}
+			}
+		})
+	}
+}
