+// Modified for LoKi on 2026-11-05: keep the authenticated dashboard independent of routing.
+package main
+
+import (
+	"context"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"github.com/sagernet/sing-box/common/lokigateway"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	mainCommand.AddCommand(&cobra.Command{Use: "gateway", Short: "Serve the authenticated HTTPS dashboard gateway", Args: cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+			defer stop()
+			return lokigateway.Run(ctx)
+		}})
+}
