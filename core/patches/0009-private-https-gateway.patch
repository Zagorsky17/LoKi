+package clashapi
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/lokicontroller"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestPrivateControllerOptionRejectsCustomPathsAndMixedTCP(t *testing.T) {
+	for _, options := range []option.ClashAPIOptions{
+		{ExternalControllerUnix: "/tmp/foreign.sock"},
+		{ExternalControllerUnix: "@loki-controller"},
+		{ExternalControllerUnix: "/tmp/loki/../controller.sock"},
+		{ExternalControllerUnix: lokicontroller.Path, ExternalController: "127.0.0.1:9092"},
+	} {
+		_, err := NewServer(context.Background(), log.NewNOPFactory(), options)
+		if err == nil || !strings.Contains(err.Error(), "fixed Unix socket without a TCP listener") {
+			t.Fatal("ambiguous private controller option accepted", err)
+		}
+	}
+	service, err := NewServer(clashTestContext(context.Background()), log.NewNOPFactory(), option.ClashAPIOptions{ExternalControllerUnix: lokicontroller.Path})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := service.(*Server)
+	if !server.privateController || !server.externalController || server.httpServer.Addr != "" {
+		t.Fatal("private controller accidentally selected TCP")
+	}
+}
