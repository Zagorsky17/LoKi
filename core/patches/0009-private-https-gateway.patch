+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 2 * time.Second}
+	for _, listener := range listeners {
+		base := "https://" + listener.Addr().String()
+		request, err := http.NewRequest("GET", base+apiPrefix+"/version", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		request.Header.Set("Origin", base)
+		request.Header.Set("Cookie", "sysauth_https="+testSession)
+		status, body, _ := readResponse(t, client, request)
+		if status != 200 || body != `{}` {
+			t.Fatal("one LAN address did not serve authenticated HTTPS")
+		}
+	}
+	var connections []*tls.Conn
+	defer func() {
+		for _, connection := range connections {
+			connection.Close()
+		}
+	}()
+	for i := 0; i < 32; i++ {
+		address := listeners[i%2].Addr().String()
+		connection, err := tls.DialWithDialer(&net.Dialer{Timeout: 2 * time.Second}, "tcp", address, transport.TLSClientConfig)
+		if err != nil {
+			t.Fatal("connection budget prematurely exhausted", i, err)
+		}
+		connections = append(connections, connection)
+	}
+	for _, listener := range listeners {
+		connection, err := tls.DialWithDialer(&net.Dialer{Timeout: time.Second}, "tcp", listener.Addr().String(), transport.TLSClientConfig)
+		if connection != nil {
+			connection.Close()
+		}
+		if err == nil {
+			t.Fatal("each LAN address received a separate connection budget")
+		}
+	}
+	for _, connection := range connections[1:] {
+		connection.Close()
+	}
+	expectFailure = true
+	listeners[1].Close()
+	connections[0].SetReadDeadline(time.Now().Add(7 * time.Second))
+	if _, err := connections[0].Read(make([]byte, 1)); err == nil {
+		t.Fatal("gateway retained a live connection after listener failure")
+	} else if timeout, ok := err.(net.Error); ok && timeout.Timeout() {
+		t.Fatal("listener failure did not close the other listener's active connection")
+	}
+}
+
+func (l *quotaTestListener) Accept() (net.Conn, error) {
+	l.calls.Add(1)
+	if l.closed.Load() {
+		return nil, net.ErrClosed
+	}
+	a, b := net.Pipe()
+	l.peers = append(l.peers, b)
+	return a, nil
+}
+func (l *quotaTestListener) Close() error { l.closed.Store(true); return nil }
+func (l *quotaTestListener) Addr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 9091}
+}
+
+func TestConnectionBudgetAndCloseReleaseEveryOwnedSlot(t *testing.T) {
+	underlying := &quotaTestListener{}
+	l := &boundedListener{Listener: underlying, slots: make(chan struct{}, 2), done: make(chan struct{})}
+	a, err := l.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := l.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		connection, err := l.Accept()
+		if connection != nil {
+			connection.Close()
+		}
+		done <- err
+	}()
+	l.Close()
+	select {
+	case err := <-done:
+		if !errors.Is(err, net.ErrClosed) {
+			t.Fatal("over-budget accept succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("listener close retained waiting accept")
+	}
+	if underlying.calls.Load() != 2 {
+		t.Fatal("over-budget accept reached underlying listener")
+	}
+	a.Close()
+	a.Close()
+	b.Close()
+	l.Close()
+	for _, peer := range underlying.peers {
+		peer.Close()
+	}
+	if len(l.slots) != 0 {
+		t.Fatal("connection slots retained")
+	}
+}
