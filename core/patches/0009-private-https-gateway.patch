+func TestWebSocketRevocationAndOutageCloseBothSides(t *testing.T) {
+	for _, outage := range []bool{false, true} {
+		t.Run(map[bool]string{false: "revoked", true: "unavailable"}[outage], func(t *testing.T) {
+			closed := make(chan struct{}, 1)
+			var revoke atomic.Bool
+			var calls atomic.Int32
+			g, server := testGateway(t, func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("Authorization") != "Bearer "+testSecret || r.Header.Get("Cookie") != "" || r.Header.Get("Origin") != "" {
+					t.Error("WS credential boundary broken")
+				}
+				connection, err := websocket.Accept(w, r, nil)
+				if err != nil {
+					return
+				}
+				defer connection.CloseNow()
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				connection.Write(ctx, websocket.MessageText, []byte(`{"up":1,"down":2}`))
+				connection.Read(ctx)
+				closed <- struct{}{}
+			})
+			g.authorize = func(_ context.Context, _ string, write bool) (bool, error) {
+				calls.Add(1)
+				if write {
+					t.Error("stream used write role")
+				}
+				if revoke.Load() {
+					if outage {
+						return false, errors.New(testSecret)
+					}
+					return false, nil
+				}
+				return true, nil
+			}
+			connection, err := dialGateway(t, server, "/traffic")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer connection.CloseNow()
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			kind, body, err := connection.Read(ctx)
+			if err != nil || kind != websocket.MessageText || !bytes.Equal(body, []byte(`{"up":1,"down":2}`)) {
+				t.Fatal("WS event missing")
+			}
+			revoke.Store(true)
+			if _, _, err = connection.Read(ctx); err == nil {
+				t.Fatal("revoked stream remained open")
+			}
+			select {
+			case <-closed:
+			case <-ctx.Done():
+				t.Fatal("upstream retained after revocation")
+			}
+			if calls.Load() < 2 {
+				t.Fatal("stream permission was not rechecked")
+			}
+		})
+	}
+}
