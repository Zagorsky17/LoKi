+			r.Header.Set("Upgrade", "websocket")
+			r.Header.Set("Sec-WebSocket-Key", "dGhlIHNhbXBsZSBub25jZQ==")
+			r.Header.Set("Sec-WebSocket-Version", "13")
+			mutate(r)
+			status, body, headers := readResponse(t, server.Client(), r)
+			if status != 400 {
+				t.Fatal("malformed handshake not refused before upgrade")
+			}
+			assertNoPrivateResponse(t, body, headers)
+		})
+	}
+	if calls.Load() != 0 {
+		t.Fatal("malformed handshake reached controller")
+	}
+}
+
+func TestWebSocketNeverForwardsClientCommands(t *testing.T) {
+	received := make(chan bool, 1)
+	_, server := testGateway(t, func(w http.ResponseWriter, r *http.Request) {
+		connection, err := websocket.Accept(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer connection.CloseNow()
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		_, _, err = connection.Read(ctx)
+		received <- err == nil
+	})
+	connection, err := dialGateway(t, server, "/connections")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.CloseNow()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if err = connection.Write(ctx, websocket.MessageText, []byte(`{"command":"delete-all"}`)); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case forwarded := <-received:
+		if forwarded {
+			t.Fatal("client command forwarded")
+		}
+	case <-ctx.Done():
+		t.Fatal("upstream not closed")
+	}
+	if _, _, err = connection.Read(ctx); err == nil {
+		t.Fatal("client data frame did not end stream")
+	}
+}
+
+func TestWebSocketBudgetAndGatewayShutdownDoNotRetainConnections(t *testing.T) {
+	closed := make(chan struct{}, 4)
+	var upstreamCalls atomic.Int32
+	g, server := testGateway(t, func(w http.ResponseWriter, r *http.Request) {
+		upstreamCalls.Add(1)
+		connection, err := websocket.Accept(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer connection.CloseNow()
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		connection.Write(ctx, websocket.MessageText, []byte(`{}`))
+		connection.Read(ctx)
+		closed <- struct{}{}
+	})
+	ctx, cancel := context.WithCancel(g.ctx)
+	g.ctx = ctx
+	defer cancel()
+	var connections []*websocket.Conn
+	for i := 0; i < 4; i++ {
+		connection, err := dialGateway(t, server, "/traffic")
+		if err != nil {
+			t.Fatal(err)
+		}
+		connections = append(connections, connection)
+		defer connection.CloseNow()
+		readCtx, stop := context.WithTimeout(context.Background(), time.Second)
+		_, _, err = connection.Read(readCtx)
+		stop()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if connection, err := dialGateway(t, server, "/traffic"); err == nil {
+		connection.CloseNow()
+		t.Fatal("stream budget exceeded")
+	}
+	if upstreamCalls.Load() != 4 {
+		t.Fatal("over-budget stream reached controller")
+	}
+	cancel()
+	deadline, stop := context.WithTimeout(context.Background(), 2*time.Second)
+	defer stop()
+	for _, connection := range connections {
+		if _, _, err := connection.Read(deadline); err == nil {
+			t.Fatal("stream survived gateway shutdown")
+		}
+	}
+	for i := 0; i < 4; i++ {
+		select {
+		case <-closed:
+		case <-deadline.Done():
+			t.Fatal("shutdown retained upstream")
+		}
+	}
+}
+
+func TestWebSocketRejectsOversizedBinaryAndPrivateMessages(t *testing.T) {
+	for name, payload := range map[string][]byte{
+		"oversized": []byte(`{"data":"` + strings.Repeat("x", responseLimit) + `"}`),
+		"private":   []byte(`{"secret":"` + testSecret + `"}`), "sid": []byte(`{"sid":"` + testSession + `"}`),
+		"escaped-private": []byte(`{"secret":"` + strings.ReplaceAll(testSecret, "1", `\u0031`) + `"}`),
+		"invalid":         []byte(`not json`), "binary": []byte(`{}`),
+	} {
+		t.Run(name, func(t *testing.T) {
+			_, server := testGateway(t, func(w http.ResponseWriter, r *http.Request) {
+				connection, err := websocket.Accept(w, r, nil)
+				if err != nil {
+					return
+				}
+				defer connection.CloseNow()
+				ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+				defer cancel()
+				kind := websocket.MessageText
+				if name == "binary" {
+					kind = websocket.MessageBinary
+				}
+				connection.Write(ctx, kind, payload)
+				connection.Read(ctx)
+			})
+			connection, err := dialGateway(t, server, "/logs")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer connection.CloseNow()
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			if _, _, err = connection.Read(ctx); err == nil {
+				t.Fatal("unsafe stream message delivered")
+			}
+		})
+	}
+}
+
+func TestConnectionsSnapshotIntervalReachesControllerUnchanged(t *testing.T) {
+	seen := make(chan string, 1)
+	_, server := testGateway(t, func(w http.ResponseWriter, r *http.Request) {
+		seen <- r.URL.RequestURI()
+		connection, err := websocket.Accept(w, r, nil)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer connection.CloseNow()
+		ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
+		defer cancel()
+		if err := connection.Write(ctx, websocket.MessageText, []byte(`{"connections":[]}`)); err != nil {
+			t.Error(err)
+			return
+		}
+		connection.Read(ctx)
+	})
+	connection, err := dialGateway(t, server, "/connections?interval=5000")
+	if err != nil {
+		t.Fatal("configured snapshot interval refused:", err)
+	}
+	defer connection.CloseNow()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	kind, data, err := connection.Read(ctx)
+	if err != nil || kind != websocket.MessageText || string(data) != `{"connections":[]}` {
+		t.Fatal("interval stream did not deliver its snapshot")
+	}
+	if <-seen != "/connections?interval=5000" {
+		t.Fatal("snapshot interval changed before reaching controller")
+	}
+}
