new file mode 100644
index 0000000..b3e2b55
--- /dev/null
+++ b/common/dialer/resolve_connect.go
@@ -0,0 +1,140 @@
+// Modified for LoKi on 2026-11-01: connect without waiting for the other DNS family.
+package dialer
+
+import (
+	"context"
+	"io"
+	"net/netip"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// DNS rule walks must finish before connecting; an explicit resolver can resolve each family independently.
+func resolveAndConnect[T io.Closer](ctx context.Context, router adapter.DNSRouter, domain string, options adapter.DNSQueryOptions, parallel bool, fallbackDelay time.Duration, connect func(context.Context, []netip.Addr) (T, error)) (T, error) {
+	var zero T
+	if err := ctx.Err(); err != nil {
+		return zero, err
+	}
+	strategy := C.DomainStrategyAsIS
+	if options.Transport != nil {
+		strategy = router.LookupStrategy(options)
+	}
+	if options.Transport == nil || strategy == C.DomainStrategyIPv4Only || strategy == C.DomainStrategyIPv6Only {
+		addresses, err := router.Lookup(ctx, domain, options)
+		if err != nil {
+			return zero, err
+		}
+		return connect(ctx, addresses)
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	if fallbackDelay == 0 {
+		fallbackDelay = N.DefaultFallbackDelay
+	}
+	timer := time.NewTimer(fallbackDelay)
+	defer timer.Stop()
+	timerC := timer.C
+	fallbackReady := false
+	preferred := 0
+	if strategy == C.DomainStrategyPreferIPv6 {
+		preferred = 1
+	}
+	type lookupResult struct {
+		family    int
+		addresses []netip.Addr
+		err       error
+	}
+	type connectResult struct {
+		family     int
+		connection T
+		err        error
+	}
+	type attempt struct {
+		addresses []netip.Addr
+		lookedUp  bool
+		started   bool
+		finished  bool
+	}
+	var attempts [2]attempt
+	lookups := make(chan lookupResult, 2)
+	connections := make(chan connectResult)
+	for family, lookupStrategy := range []C.DomainStrategy{C.DomainStrategyIPv4Only, C.DomainStrategyIPv6Only} {
+		query := options
+		query.LookupStrategy = lookupStrategy
+		go func(family int) {
+			addresses, err := router.Lookup(adapter.OverrideContext(ctx), domain, query)
+			lookups <- lookupResult{family, addresses, err}
+		}(family)
+	}
+	var failures []error
+	for {
+		if err := ctx.Err(); err != nil {
+			return zero, err
+		}
+		for _, family := range []int{preferred, 1 - preferred} {
+			current := &attempts[family]
+			if current.started || len(current.addresses) == 0 {
+				continue
+			}
+			other := attempts[1-family]
+			if !parallel && other.started && !other.finished {
+				continue
+			}
+			primary := attempts[preferred]
+			if family != preferred && !primary.finished && !(primary.lookedUp && len(primary.addresses) == 0) && !fallbackReady {
+				continue
+			}
+			current.started = true
+			if family == preferred && !other.started {
+				timer.Reset(fallbackDelay)
+				timerC = timer.C
+				fallbackReady = false
+			}
+			addresses := current.addresses
+			go func(family int) {
+				conn, err := connect(ctx, addresses)
+				select {
+				case connections <- connectResult{family, conn, err}:
+				case <-ctx.Done():
+					if err == nil {
+						conn.Close()
+					}
+				}
+			}(family)
+		}
+		if attempts[0].lookedUp && attempts[1].lookedUp && (len(attempts[0].addresses) == 0 || attempts[0].finished) && (len(attempts[1].addresses) == 0 || attempts[1].finished) {
+			if len(failures) == 0 {
+				return zero, E.New("empty DNS result")
+			}
+			return zero, E.Errors(failures...)
+		}
+		select {
+		case <-ctx.Done():
+			return zero, ctx.Err()
+		case <-timerC:
+			fallbackReady = true
+			timerC = nil
+		case result := <-lookups:
+			attempts[result.family].lookedUp = true
+			if result.err != nil {
+				failures = append(failures, result.err)
+			} else {
+				attempts[result.family].addresses = result.addresses
+			}
+		case result := <-connections:
+			if result.err == nil {
+				if err := ctx.Err(); err != nil {
+					result.connection.Close()
+					return zero, err
+				}
+				return result.connection, nil
+			}
+			attempts[result.family].finished = true
+			failures = append(failures, result.err)
+		}
+	}
+}
