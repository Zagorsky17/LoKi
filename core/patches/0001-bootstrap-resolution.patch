+func TestResolveSerialModeDoesNotRaceConnections(t *testing.T) {
+	var active atomic.Int32
+	router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(_ context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+		if family == C.DomainStrategyIPv4Only {
+			return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+		}
+		return []netip.Addr{netip.IPv6Loopback()}, nil
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	conn, err := resolveAndConnect(ctx, router, "proxy.test", adapter.DNSQueryOptions{Transport: &lookupTransport{}}, false, time.Millisecond, func(_ context.Context, addresses []netip.Addr) (net.Conn, error) {
+		if active.Add(1) != 1 {
+			t.Error("serial connections overlapped")
+		}
+		defer active.Add(-1)
+		if addresses[0].Is4() {
+			time.Sleep(20 * time.Millisecond)
+			return nil, errors.New("IPv4 failed")
+		}
+		return &trackedConnection{}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+}
