+func TestResolveCancelsBothPendingLookups(t *testing.T) {
+	started, stopped := make(chan struct{}, 2), make(chan struct{}, 2)
+	router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(ctx context.Context, _ C.DomainStrategy) ([]netip.Addr, error) {
+		started <- struct{}{}
+		<-ctx.Done()
+		stopped <- struct{}{}
+		return nil, ctx.Err()
+	}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() { <-started; <-started; cancel() }()
+	_, err := resolveAndConnect(ctx, router, "proxy.test", adapter.DNSQueryOptions{Transport: &lookupTransport{}}, true, time.Millisecond, func(context.Context, []netip.Addr) (net.Conn, error) {
+		t.Error("unexpected connection")
+		return nil, errors.New("unexpected")
+	})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	for range 2 {
+		select {
+		case <-stopped:
+		case <-time.After(time.Second):
+			t.Fatal("lookup leaked")
+		}
+	}
+}
