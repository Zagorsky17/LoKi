+func TestResolveReportsBothFailuresAndHandlesCancellation(t *testing.T) {
+	for _, mode := range []string{"lookup", "connect", "empty", "canceled"} {
+		t.Run(mode, func(t *testing.T) {
+			err4, err6 := errors.New("IPv4 failed"), errors.New("IPv6 failed")
+			router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(_ context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+				if mode == "empty" {
+					return nil, nil
+				}
+				if mode == "lookup" {
+					if family == C.DomainStrategyIPv4Only {
+						return nil, err4
+					}
+					return nil, err6
+				}
+				if mode == "canceled" {
+					t.Error("lookup after cancellation")
+				}
+				address := netip.MustParseAddr("127.0.0.1")
+				if family == C.DomainStrategyIPv6Only {
+					address = netip.IPv6Loopback()
+				}
+				return []netip.Addr{address}, nil
+			}}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			if mode == "canceled" {
+				cancel()
+			}
+			_, err := resolveAndConnect(ctx, router, "proxy.test", adapter.DNSQueryOptions{Transport: &lookupTransport{}}, true, time.Second, func(_ context.Context, addresses []netip.Addr) (net.Conn, error) {
+				if mode != "connect" {
+					t.Error("unexpected connection")
+				}
+				if addresses[0].Is4() {
+					return nil, err4
+				}
+				return nil, err6
+			})
+			if err == nil {
+				t.Fatal("missing failure")
+			}
+			if (mode == "lookup" || mode == "connect") && (!errors.Is(err, err4) || !errors.Is(err, err6)) {
+				t.Fatalf("missing cause: %v", err)
+			}
+			if mode == "canceled" && !errors.Is(err, context.Canceled) {
+				t.Fatal(err)
+			}
+		})
+	}
+}
