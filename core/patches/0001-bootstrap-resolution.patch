+func TestResolveLiteralAddressDoesNotQueryDNS(t *testing.T) {
+	target := M.ParseSocksaddr("127.0.0.1:443")
+	d := &resolveDialer{dialer: &lookupDialer{dial: func(_ context.Context, address M.Socksaddr) (net.Conn, error) {
+		if address != target {
+			t.Error(address)
+		}
+		return &trackedConnection{}, nil
+	}}}
+	conn, err := d.DialContext(context.Background(), "tcp", target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+}
