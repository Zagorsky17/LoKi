+++ b/common/dialer/resolve_test.go
@@ -0,0 +1,501 @@
+// Modified for LoKi on 2026-11-01: connect without waiting for the other DNS family.
+package dialer
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type lookupRouter struct {
+	adapter.DNSRouter
+	strategy C.DomainStrategy
+	lookup   func(context.Context, C.DomainStrategy) ([]netip.Addr, error)
+}
+
+func (r *lookupRouter) LookupStrategy(options adapter.DNSQueryOptions) C.DomainStrategy {
+	if options.LookupStrategy != C.DomainStrategyAsIS {
+		return options.LookupStrategy
+	}
+	if options.Strategy != C.DomainStrategyAsIS {
+		return options.Strategy
+	}
+	return r.strategy
+}
+
+func (r *lookupRouter) Lookup(ctx context.Context, _ string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
+	strategy := options.LookupStrategy
+	if strategy == C.DomainStrategyAsIS {
+		strategy = options.Strategy
+	}
+	if strategy == C.DomainStrategyAsIS {
+		strategy = r.strategy
+	}
+	if strategy == C.DomainStrategyIPv4Only || strategy == C.DomainStrategyIPv6Only {
+		return r.lookup(ctx, strategy)
+	}
+	type result struct {
+		addresses []netip.Addr
+		err       error
+	}
+	results := make(chan result, 2)
+	for _, family := range []C.DomainStrategy{C.DomainStrategyIPv4Only, C.DomainStrategyIPv6Only} {
+		go func(family C.DomainStrategy) {
+			addresses, err := r.lookup(ctx, family)
+			results <- result{addresses, err}
+		}(family)
+	}
+	var addresses []netip.Addr
+	var failures []error
+	for range 2 {
+		result := <-results
+		addresses = append(addresses, result.addresses...)
+		failures = append(failures, result.err)
+	}
+	if len(addresses) == 0 {
+		return nil, errors.Join(failures...)
+	}
+	return addresses, nil
+}
+
+type lookupTransport struct{ adapter.DNSTransport }
+type trackedConnection struct {
+	net.Conn
+	closed atomic.Bool
+}
+
+func (c *trackedConnection) Close() error { c.closed.Store(true); return nil }
+
+type lookupDialer struct {
+	dial   func(context.Context, M.Socksaddr) (net.Conn, error)
+	packet func(context.Context, M.Socksaddr) (net.PacketConn, error)
+}
+
+func (d *lookupDialer) DialContext(ctx context.Context, _ string, address M.Socksaddr) (net.Conn, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return d.dial(ctx, address)
+}
+func (d *lookupDialer) ListenPacket(ctx context.Context, target M.Socksaddr) (net.PacketConn, error) {
+	if d.packet != nil {
+		return d.packet(ctx, target)
+	}
+	return nil, errors.New("unexpected packet listener")
+}
+
+type trackedPacket struct {
+	net.PacketConn
+	closed atomic.Bool
+}
+
+func (c *trackedPacket) Close() error { c.closed.Store(true); return nil }
+
+type interfaceLookupDialer struct{ *lookupDialer }
+
+func (d *interfaceLookupDialer) DialParallelInterface(ctx context.Context, network string, target M.Socksaddr, _ *C.NetworkStrategy, _, _ []C.InterfaceType, _ time.Duration) (net.Conn, error) {
+	return d.DialContext(ctx, network, target)
+}
+func (d *interfaceLookupDialer) ListenSerialInterfacePacket(ctx context.Context, target M.Socksaddr, _ *C.NetworkStrategy, _, _ []C.InterfaceType, _ time.Duration) (net.PacketConn, error) {
+	return d.ListenPacket(ctx, target)
+}
+
+func TestResolveDialsReadyFamilyWithoutWaitingForOtherDNS(t *testing.T) {
+	for _, prefer6 := range []bool{false, true} {
+		t.Run(map[bool]string{false: "IPv4", true: "IPv6"}[prefer6], func(t *testing.T) {
+			strategy, family := C.DomainStrategyPreferIPv4, C.DomainStrategyIPv4Only
+			address := netip.MustParseAddr("127.0.0.1")
+			if prefer6 {
+				strategy, family, address = C.DomainStrategyPreferIPv6, C.DomainStrategyIPv6Only, netip.IPv6Loopback()
+			}
+			canceled := make(chan struct{})
+			router := &lookupRouter{strategy: strategy, lookup: func(ctx context.Context, requested C.DomainStrategy) ([]netip.Addr, error) {
+				if requested == family {
+					return []netip.Addr{address}, nil
+				}
+				<-ctx.Done()
+				close(canceled)
+				return nil, ctx.Err()
+			}}
+			d := &resolveDialer{router: router, dialer: &lookupDialer{dial: func(_ context.Context, target M.Socksaddr) (net.Conn, error) {
+				if target.Addr != address {
+					t.Errorf("wrong family: %s", target)
+				}
+				return &trackedConnection{}, nil
+			}}, parallel: true, queryOptions: adapter.DNSQueryOptions{Transport: &lookupTransport{}}}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			start := time.Now()
+			conn, err := d.DialContext(ctx, "tcp", M.ParseSocksaddr("proxy.test:443"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			conn.Close()
+			if time.Since(start) > 500*time.Millisecond {
+				t.Fatal("waited for the unavailable DNS family")
+			}
+			select {
+			case <-canceled:
+			case <-time.After(time.Second):
+				t.Fatal("unused lookup was not canceled")
+			}
+		})
+	}
+}
+
+func TestResolvePacketAndInterfacePaths(t *testing.T) {
+	for _, path := range []string{"packet", "interface-tcp", "interface-packet"} {
+		t.Run(path, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(ctx context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+				if family == C.DomainStrategyIPv4Only {
+					return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+				}
+				<-ctx.Done()
+				return nil, ctx.Err()
+			}}
+			upstream := &lookupDialer{dial: func(context.Context, M.Socksaddr) (net.Conn, error) { return &trackedConnection{}, nil },
+				packet: func(context.Context, M.Socksaddr) (net.PacketConn, error) { return &trackedPacket{}, nil }}
+			d := &resolveDialer{router: router, dialer: upstream, parallel: true, queryOptions: adapter.DNSQueryOptions{Transport: &lookupTransport{}}}
+			target := M.ParseSocksaddr("proxy.test:443")
+			var err error
+			start := time.Now()
+			if path == "packet" {
+				var conn net.PacketConn
+				conn, err = d.ListenPacket(ctx, target)
+				if conn != nil {
+					conn.Close()
+				}
+			} else {
+				wrapped := &resolveParallelNetworkDialer{
+					resolveDialer: resolveDialer{router: router, dialer: upstream, parallel: true, queryOptions: d.queryOptions},
+					dialer:        &interfaceLookupDialer{upstream},
+				}
+				if path == "interface-tcp" {
+					var conn net.Conn
+					conn, err = wrapped.DialParallelInterface(ctx, "tcp", target, nil, nil, nil, 0)
+					if conn != nil {
+						conn.Close()
+					}
+				} else {
+					var conn net.PacketConn
+					conn, err = wrapped.ListenSerialInterfacePacket(ctx, target, nil, nil, nil, 0)
+					if conn != nil {
+						conn.Close()
+					}
+				}
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if time.Since(start) > 500*time.Millisecond {
+				t.Fatal("waited for AAAA")
+			}
+		})
+	}
+}
+
+func TestResolveFallbackKeepsLateIPv6AfterIPv4ConnectionFails(t *testing.T) {
+	v4Failed := make(chan struct{})
+	router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(ctx context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+		if family == C.DomainStrategyIPv4Only {
+			return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+		}
+		select {
+		case <-v4Failed:
+			return []netip.Addr{netip.IPv6Loopback()}, nil
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	conn, err := resolveAndConnect(ctx, router, "proxy.test", adapter.DNSQueryOptions{Transport: &lookupTransport{}}, true, time.Second, func(_ context.Context, addresses []netip.Addr) (net.Conn, error) {
+		if addresses[0].Is4() {
+			close(v4Failed)
+			return nil, errors.New("IPv4 connection refused")
+		}
+		return &trackedConnection{}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+}
+
+func TestResolveFallbackDoesNotWaitForPreferredDNS(t *testing.T) {
+	for _, delay := range []time.Duration{20 * time.Millisecond, -time.Millisecond} {
+		t.Run(delay.String(), func(t *testing.T) {
+			router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(ctx context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+				if family == C.DomainStrategyIPv6Only {
+					return []netip.Addr{netip.IPv6Loopback()}, nil
+				}
+				<-ctx.Done()
+				return nil, ctx.Err()
+			}}
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			start := time.Now()
+			conn, err := resolveAndConnect(ctx, router, "proxy.test", adapter.DNSQueryOptions{Transport: &lookupTransport{}}, true, delay, func(_ context.Context, addresses []netip.Addr) (net.Conn, error) {
+				if !addresses[0].Is6() {
+					t.Errorf("expected IPv6 fallback")
+				}
+				return &trackedConnection{}, nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			conn.Close()
+			maximum := 500 * time.Millisecond
+			if delay < 0 {
+				maximum = 100 * time.Millisecond
+			}
+			if elapsed := time.Since(start); elapsed < max(delay, 0) || elapsed > maximum {
+				t.Fatalf("fallback delay: %s", elapsed)
+			}
+		})
+	}
+}
