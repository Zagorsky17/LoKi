+func TestResolvePreservesSingleFamilyAndRuleBasedLookups(t *testing.T) {
+	for _, mode := range []string{"IPv4", "IPv6", "rules", "explicit"} {
+		t.Run(mode, func(t *testing.T) {
+			options := adapter.DNSQueryOptions{Transport: &lookupTransport{}}
+			strategy := C.DomainStrategyIPv4Only
+			if mode == "IPv6" {
+				strategy = C.DomainStrategyIPv6Only
+			}
+			if mode == "explicit" {
+				strategy = C.DomainStrategyPreferIPv6
+				options.Strategy = C.DomainStrategyIPv4Only
+			}
+			if mode == "rules" {
+				options.Transport = nil
+			}
+			var calls atomic.Int32
+			router := &lookupRouter{strategy: strategy, lookup: func(_ context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+				calls.Add(1)
+				expected := C.DomainStrategyIPv4Only
+				if mode == "IPv6" {
+					expected = C.DomainStrategyIPv6Only
+				}
+				if family != expected {
+					t.Errorf("unexpected family: %v", family)
+				}
+				return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+			}}
+			conn, err := resolveAndConnect(context.Background(), router, "proxy.test", options, true, 0, func(context.Context, []netip.Addr) (net.Conn, error) { return &trackedConnection{}, nil })
+			if err != nil {
+				t.Fatal(err)
+			}
+			conn.Close()
+			if calls.Load() != 1 {
+				t.Fatalf("lookup count: %d", calls.Load())
+			}
+		})
+	}
+}
