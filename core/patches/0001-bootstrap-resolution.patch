+func TestResolveClosesLosingConnection(t *testing.T) {
+	started4, started6 := make(chan struct{}), make(chan struct{})
+	loser := &trackedConnection{}
+	loserReturned := make(chan struct{})
+	router := &lookupRouter{strategy: C.DomainStrategyPreferIPv4, lookup: func(_ context.Context, family C.DomainStrategy) ([]netip.Addr, error) {
+		if family == C.DomainStrategyIPv4Only {
+			return []netip.Addr{netip.MustParseAddr("127.0.0.1")}, nil
+		}
+		return []netip.Addr{netip.IPv6Loopback()}, nil
+	}}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	conn, err := resolveAndConnect(ctx, router, "proxy.test", adapter.DNSQueryOptions{Transport: &lookupTransport{}}, true, time.Millisecond, func(ctx context.Context, addresses []netip.Addr) (net.Conn, error) {
+		if addresses[0].Is4() {
+			close(started4)
+			<-started6
+			return &trackedConnection{}, nil
+		}
+		<-started4
+		close(started6)
+		<-ctx.Done()
+		close(loserReturned)
+		return loser, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	<-loserReturned
+	for deadline := time.Now().Add(time.Second); !loser.closed.Load(); {
+		if time.Now().After(deadline) {
+			t.Fatal("losing connection leaked")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
