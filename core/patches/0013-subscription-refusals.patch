new file mode 100644
--- /dev/null
+++ b/parser/refusal_test.go
@@ -0,0 +1,41 @@
+package parser_test
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/parser"
+)
+
+func TestSubscriptionRefusesUnspecifiedDestinations(t *testing.T) {
+	const link = "vless://00000000-0000-4000-8000-000000000001@0.0.0.0:1#App%20not%20supported"
+	for _, content := range []string{
+		link,
+		base64.StdEncoding.EncodeToString([]byte(link)),
+		strings.ReplaceAll(link, "0.0.0.0", "[::]"),
+		strings.ReplaceAll(link, "0.0.0.0", "[::ffff:0.0.0.0]"),
+		`{"outbounds":[{"type":"vless","tag":"refused","server":"0.0.0.0","server_port":1,"uuid":"00000000-0000-4000-8000-000000000001"}]}`,
+		"proxies:\n  - {type: vless, name: refused, server: '::', port: 1, uuid: 00000000-0000-4000-8000-000000000001}\n",
+	} {
+		result, err := parser.ParseSubscription(include.Context(context.Background()), content)
+		if err == nil || len(result.Outbounds) != 0 || len(result.Skipped) != 1 {
+			t.Fatalf("refusal was imported: error=%v outbounds=%d skipped=%d", err, len(result.Outbounds), len(result.Skipped))
+		}
+		if !strings.Contains(result.Skipped[0].Reason.Error(), "unspecified") {
+			t.Fatalf("missing refusal reason: %v", result.Skipped[0].Reason)
+		}
+	}
+}
+
+func TestSubscriptionKeepsUsableServersBesideARefusal(t *testing.T) {
+	content := "vless://00000000-0000-4000-8000-000000000001@0.0.0.0:1#Refused\n" +
+		"vless://00000000-0000-4000-8000-000000000001@node.example.test:443#Working\n" +
+		"vless://00000000-0000-4000-8000-000000000001@127.0.0.1:1234#Local\n"
+	result, err := parser.ParseSubscription(include.Context(context.Background()), content)
+	if err != nil || len(result.Outbounds) != 2 || len(result.Skipped) != 1 {
+		t.Fatalf("mixed subscription: error=%v outbounds=%d skipped=%d", err, len(result.Outbounds), len(result.Skipped))
+	}
+}
diff --git a/provider/remote/hwid_refusal_test.go b/provider/remote/hwid_refusal_test.go
new file mode 100644
--- /dev/null
+++ b/provider/remote/hwid_refusal_test.go
@@ -0,0 +1,42 @@
+package provider
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestProviderRecognizesDeviceRefusalsBeforeImportingTheBody(t *testing.T) {
+	for _, tc := range []struct{ header, value, reason string }{
+		{"x-hwid-not-supported", "true", "X-HWID"},
+		{"x-hwid-not-supported", "TRUE", "X-HWID"},
+		{"x-hwid-max-devices-reached", "true", "device limit"},
+		{"x-hwid-limit", "true", "device limit"},
+		{"x-hwid-not-supported", "false", ""},
+		{"x-hwid-active", "true", ""},
+	} {
+		t.Run(tc.header+"="+tc.value, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set(tc.header, tc.value)
+				_, _ = w.Write([]byte("vless://00000000-0000-4000-8000-000000000001@node.example.test:443#Working"))
+			}))
+			defer server.Close()
+			remote := etagRemote(t, server.URL+"/?token=synthetic-private-token", &transactionCache{})
+			result, err := remote.fetchProvider(context.Background(), server.Client())
+			if tc.reason == "" {
+				if err != nil || len(result.outbounds) != 1 {
+					t.Fatalf("non-refusal rejected: %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tc.reason) || !result.rejectedResponse || len(result.outbounds) != 0 {
+				t.Fatalf("missing device refusal: error=%v rejected=%v outbounds=%d", err, result.rejectedResponse, len(result.outbounds))
+			}
+			if strings.Contains(err.Error(), "synthetic-private-token") || strings.Contains(err.Error(), server.URL) {
+				t.Fatal("refusal exposed the subscription URL")
+			}
+		})
+	}
+}
